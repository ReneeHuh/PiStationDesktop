<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PiStation.Server</AssemblyName>
    <!-- The desktop reference is a build dependency for the separately published SSH bundle, never a runtime assembly reference. -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" />
    <ProjectReference Include="..\PiStation.Host\PiStation.Host.csproj" />
  </ItemGroup>
</Project>
