<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PiStation.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PiStation.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/T3DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="PiDiffLineTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:c="using:PiStation.App.Views.Controls">
              <Grid MinHeight="22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{Binding LeftBackground}" Padding="4,1">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LeftNumbers}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource PiTextMutedBrush}"/>
                    <c:DiffCodeLine Grid.Column="1" Code="{Binding LeftText}" SyntaxLanguage="{Binding SyntaxLanguage}" Foreground="{ThemeResource PiTextPrimaryBrush}"/>
                  </Grid>
                </Border>
                <Border Grid.Column="1" Width="{Binding RightWidth}" Visibility="{Binding RightVisibility}" Background="{Binding RightBackground}" Padding="4,1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource PiDividerBrush}">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RightNumbers}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource PiTextMutedBrush}"/>
                    <c:DiffCodeLine Grid.Column="1" Code="{Binding RightText}" SyntaxLanguage="{Binding SyntaxLanguage}" Foreground="{ThemeResource PiTextPrimaryBrush}"/>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
