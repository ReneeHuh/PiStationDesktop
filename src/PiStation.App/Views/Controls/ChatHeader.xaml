<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.ChatHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">

    <Border
        MinHeight="{StaticResource PiThreadHeaderHeight}"
        Style="{StaticResource PiChromeSurfaceStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderResponsiveStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderGrid.Padding" Value="8,0,150,0" />
                        <Setter Target="HeaderGrid.ColumnSpacing" Value="4" />
                        <Setter Target="ProjectBadge.Visibility" Value="Collapsed" />
                        <Setter Target="TurnStatusPill.Visibility" Value="Collapsed" />
                        <Setter Target="AddActionText.Visibility" Value="Collapsed" />
                        <Setter Target="OpenProjectText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderGrid.Padding" Value="12,0,150,0" />
                        <Setter Target="HeaderGrid.ColumnSpacing" Value="6" />
                        <Setter Target="ProjectBadge.Visibility" Value="Collapsed" />
                        <Setter Target="TurnStatusPill.Visibility" Value="Visible" />
                        <Setter Target="AddActionText.Visibility" Value="Collapsed" />
                        <Setter Target="OpenProjectText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StandardLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderGrid.Padding" Value="16,0,150,0" />
                        <Setter Target="HeaderGrid.ColumnSpacing" Value="10" />
                        <Setter Target="ProjectBadge.Visibility" Value="Visible" />
                        <Setter Target="TurnStatusPill.Visibility" Value="Visible" />
                        <Setter Target="AddActionText.Visibility" Value="Visible" />
                        <Setter Target="OpenProjectText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderGrid.Padding" Value="20,0,150,0" />
                        <Setter Target="HeaderGrid.ColumnSpacing" Value="14" />
                        <Setter Target="ProjectBadge.Visibility" Value="Visible" />
                        <Setter Target="TurnStatusPill.Visibility" Value="Visible" />
                        <Setter Target="AddActionText.Visibility" Value="Visible" />
                        <Setter Target="OpenProjectText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="HeaderGrid" Padding="20,0,150,0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="ActiveThreadView"
                VerticalAlignment="Center"
                automation:AutomationProperties.AutomationId="ActiveThreadView"
                automation:AutomationProperties.Name="Active thread"
                ColumnSpacing="8"
                ToolTipService.ToolTip="{x:Bind ViewModel.Workspace.ActiveProjectPath, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource PiPanelHeaderTextStyle}"
                    Text="{x:Bind ViewModel.Workspace.ActiveThreadTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Border
                    x:Name="ProjectBadge"
                    Grid.Column="1"
                    MaxWidth="160"
                    Style="{StaticResource PiPillStyle}">
                    <TextBlock
                        Style="{StaticResource PiPillTextStyle}"
                        Text="{x:Bind ViewModel.Workspace.ActiveProjectName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>

            <Border
                x:Name="TurnStatusPill"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource PiPillStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Grid Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse
                            Style="{StaticResource PiStatusDotStyle}"
                            Visibility="{x:Bind ViewModel.Thread.TurnStatusIdleVisibility, Mode=OneWay}" />
                        <Ellipse
                            Style="{StaticResource PiStatusDotRunningStyle}"
                            Visibility="{x:Bind ViewModel.Thread.TurnStatusRunningVisibility, Mode=OneWay}" />
                        <Ellipse
                            Style="{StaticResource PiStatusDotCriticalStyle}"
                            Visibility="{x:Bind ViewModel.Thread.TurnStatusCriticalVisibility, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        x:Name="TurnStatusText"
                        automation:AutomationProperties.AutomationId="TurnStatusText"
                        automation:AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource PiPillTextStyle}"
                        Text="{x:Bind ViewModel.Thread.TurnStatus, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Button
                x:Name="AddActionButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                automation:AutomationProperties.AutomationId="AddActionButton"
                automation:AutomationProperties.Name="Add action"
                Style="{StaticResource PiCompactButtonStyle}"
                ToolTipService.ToolTip="Add action">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Name="HeaderNewThreadMenuItem"
                            automation:AutomationProperties.AutomationId="HeaderNewThreadMenuItem"
                            automation:AutomationProperties.Name="Create thread"
                            Click="OnNewThreadClicked"
                            IsEnabled="{x:Bind ViewModel.CanManageThreads, Mode=OneWay}"
                            Text="New thread">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            automation:AutomationProperties.AutomationId="HeaderNewLocalThreadMenuItem"
                            Click="OnNewLocalThreadClicked"
                            IsEnabled="{x:Bind ViewModel.CanManageThreads, Mode=OneWay}"
                            Text="New local thread" />
                        <MenuFlyoutItem
                            automation:AutomationProperties.AutomationId="HeaderNewWorktreeThreadMenuItem"
                            Click="OnNewWorktreeThreadClicked"
                            IsEnabled="{x:Bind ViewModel.CanManageThreads, Mode=OneWay}"
                            Text="New worktree thread" />
                        <MenuFlyoutItem
                            automation:AutomationProperties.AutomationId="HeaderNewOriginWorktreeThreadMenuItem"
                            Click="OnNewOriginWorktreeThreadClicked"
                            IsEnabled="{x:Bind ViewModel.CanManageThreads, Mode=OneWay}"
                            Text="New worktree from origin" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            automation:AutomationProperties.AutomationId="HeaderCommandPaletteMenuItem"
                            automation:AutomationProperties.Name="Open command palette"
                            Click="OnCommandPaletteClicked"
                            Text="Command palette" />
                    </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                    <TextBlock x:Name="AddActionText" VerticalAlignment="Center" Text="Add" />
                </StackPanel>
            </Button>

            <Button
                x:Name="OpenProjectButton"
                Grid.Column="3"
                VerticalAlignment="Center"
                automation:AutomationProperties.AutomationId="OpenProjectButton"
                automation:AutomationProperties.Name="Open project folder"
                Click="OnOpenProjectClicked"
                IsEnabled="{x:Bind ViewModel.Workspace.HasSelectedProject, Mode=OneWay}"
                Style="{StaticResource PiCompactButtonStyle}"
                ToolTipService.ToolTip="Open project folder">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon FontSize="12" Glyph="&#xE8E5;" />
                    <TextBlock x:Name="OpenProjectText" VerticalAlignment="Center" Text="Open" />
                </StackPanel>
            </Button>

            <Button
                x:Name="ToggleWorkbenchButton"
                Grid.Column="4"
                VerticalAlignment="Center"
                automation:AutomationProperties.AutomationId="ToggleWorkbenchButton"
                automation:AutomationProperties.Name="{x:Bind ViewModel.Layout.WorkbenchToggleLabel, Mode=OneWay}"
                Click="OnToggleWorkbenchClicked"
                Style="{StaticResource PiToolbarIconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.Layout.WorkbenchToggleLabel, Mode=OneWay}">
                <FontIcon FontSize="12" Glyph="&#xE7C4;" />
            </Button>
        </Grid>
    </Border>
</UserControl>
