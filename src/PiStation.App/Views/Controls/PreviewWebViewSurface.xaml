<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.PreviewWebViewSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    automation:AutomationProperties.AutomationId="PreviewBrowserSurface"
    automation:AutomationProperties.Name="Web preview">
    <Grid Background="{ThemeResource PiCanvasBrush}">
        <WebView2
            x:Name="Browser"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
        <Border
            x:Name="InitializationOverlay"
            Background="{ThemeResource PiCanvasBrush}"
            IsHitTestVisible="False">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <ProgressRing
                    x:Name="InitializationProgress"
                    Width="20"
                    Height="20"
                    IsActive="True" />
                <TextBlock
                    x:Name="InitializationMessage"
                    FontSize="{StaticResource PiFontSizeCaption}"
                    Foreground="{ThemeResource PiTextMutedBrush}"
                    Text="Starting web preview…" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
