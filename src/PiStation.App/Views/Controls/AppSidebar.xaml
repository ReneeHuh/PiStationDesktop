<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.AppSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:viewModels="using:PiStation.App.ViewModels"
    xmlns:models="using:PiStation.Protocol.Models"
    xmlns:views="using:PiStation.App.Views">

    <UserControl.Resources>
        <views:BooleanChoiceConverter
            x:Key="ThreadArchiveActionTextConverter"
            FalseValue="Archive"
            TrueValue="Restore" />
        <views:BooleanChoiceConverter
            x:Key="ThreadPinActionTextConverter"
            FalseValue="Pin"
            TrueValue="Unpin" />
        <views:BooleanChoiceConverter
            x:Key="ThreadStateTextConverter"
            FalseValue="Inbox"
            TrueValue="Settled" />
        <views:BooleanChoiceConverter x:Key="ThreadDraftTextConverter" FalseValue="" TrueValue="Draft" />
        <views:ObjectPresenceToVisibilityConverter x:Key="ObjectPresenceToVisibilityConverter" />
        <views:RelativeTimeConverter x:Key="RelativeTimeConverter" />
        <views:ProjectIconSourceConverter x:Key="ProjectIconSourceConverter" />
    </UserControl.Resources>

    <Border
        x:Name="Root"
        Width="{StaticResource PiSidebarWidthValue}"
        automation:AutomationProperties.AutomationId="AppSidebar"
        automation:AutomationProperties.Name="Projects and threads"
        Background="{ThemeResource PiSidebarBrush}"
        BorderBrush="{ThemeResource PiDividerBrush}"
        BorderThickness="0,0,1,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SidebarStates">
                <VisualState x:Name="Expanded">
                    <VisualState.Setters>
                        <Setter Target="Root.Width" Value="{StaticResource PiSidebarWidthValue}" />
                        <Setter Target="ExpandedPane.Visibility" Value="Visible" />
                        <Setter Target="CollapsedPane.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Collapsed">
                    <VisualState.Setters>
                        <Setter Target="Root.Width" Value="{StaticResource PiSidebarCollapsedWidth}" />
                        <Setter Target="ExpandedPane.Visibility" Value="Collapsed" />
                        <Setter Target="CollapsedPane.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid>
            <Grid
                x:Name="ExpandedPane"
                Padding="10,8,10,8"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox
                            x:Name="ThreadSearchInput"
                            MaxLength="200"
                            Padding="30,4,30,4"
                            TabIndex="20"
                            automation:AutomationProperties.AutomationId="ThreadSearchInput"
                            automation:AutomationProperties.Name="Search threads"
                            PlaceholderText="Search threads"
                            Style="{StaticResource PiTextBoxStyle}"
                            Text="{x:Bind ViewModel.Workspace.ThreadSearchQuery, Mode=OneWay}"
                            TextChanged="OnThreadSearchTextChanged" />
                        <FontIcon
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Glyph="&#xE721;"
                            IsHitTestVisible="False" />
                        <Button
                            x:Name="ClearThreadSearchButton"
                            Width="26"
                            Height="26"
                            Margin="0,0,3,0"
                            Padding="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.AutomationId="ClearThreadSearchButton"
                            automation:AutomationProperties.Name="Clear thread search"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnClearThreadSearchClicked"
                            Visibility="{x:Bind ViewModel.Workspace.ThreadSearchClearVisibility, Mode=OneWay}">
                            <FontIcon FontSize="10" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <Button
                        x:Name="CollapseSidebarButton"
                        Grid.Column="1"
                        TabIndex="21"
                        automation:AutomationProperties.AutomationId="CollapseSidebarButton"
                        automation:AutomationProperties.Name="Collapse sidebar"
                        Click="OnToggleSidebarClicked"
                        Style="{StaticResource PiToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="Collapse sidebar">
                        <FontIcon FontSize="12" Glyph="&#xE76B;" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="NewThreadButton"
                        TabIndex="10"
                        automation:AutomationProperties.AutomationId="NewThreadButton"
                        automation:AutomationProperties.Name="Create thread"
                        Click="OnNewThreadClicked"
                        IsEnabled="{x:Bind ViewModel.CanManageThreads, Mode=OneWay}"
                        Style="{StaticResource PiSidebarActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon FontSize="14" Glyph="&#xE70F;" />
                            <TextBlock VerticalAlignment="Center" Text="New thread" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="NewProjectButton"
                        Grid.Column="1"
                        TabIndex="11"
                        automation:AutomationProperties.AutomationId="NewProjectButton"
                        automation:AutomationProperties.Name="Add project"
                        Click="OnAddProjectClicked"
                        IsEnabled="{x:Bind ViewModel.CanAddProject, Mode=OneWay}"
                        Style="{StaticResource PiToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="Add project">
                        <FontIcon FontSize="13" Glyph="&#xE710;" />
                    </Button>
                </Grid>

                <Grid Grid.Row="2" MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="8,4,8,3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="InboxShelfSelector" SelectedIndex="0" SelectionChanged="OnInboxShelfChanged"
                            automation:AutomationProperties.AutomationId="InboxShelfSelector" automation:AutomationProperties.Name="Task inbox"
                            Style="{StaticResource PiComboBoxStyle}">
                            <ComboBoxItem Content="Active" /><ComboBoxItem Content="Settled" />
                            <ComboBoxItem Content="Snoozed" /><ComboBoxItem Content="Archived" />
                        </ComboBox>
                        <TextBlock
                            Grid.Column="1"
                            FontSize="{StaticResource PiFontSizeCaption}"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Text="LOCAL" />
                    </Grid>

                    <ListView
                        x:Name="ProjectSelector"
                        Grid.Row="1"
                        MaxHeight="300"
                        IsTabStop="False"
                        automation:AutomationProperties.AutomationId="ProjectSelector"
                        automation:AutomationProperties.Name="Projects"
                        ItemContainerStyle="{StaticResource PiSidebarListViewItemStyle}"
                        ItemsSource="{x:Bind ViewModel.ProjectGroups}"

                        SelectionChanged="OnProjectSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ProjectGroupViewModel">
                                <Expander IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" Background="Transparent">
                                    <Expander.Header>
                                        <StackPanel Spacing="2" ToolTipService.ToolTip="{x:Bind CanonicalPath}">
                                            <Button Content="{x:Bind DisplayName}" Click="OnGroupedProjectClicked" Style="{StaticResource PiToolbarButtonStyle}" ToolTipService.ToolTip="Select project" />
                                            <TextBlock FontSize="{StaticResource PiFontSizeCaption}" Foreground="{ThemeResource PiTextMutedBrush}" Text="{x:Bind Summary, Mode=OneWay}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <ListView ItemsSource="{x:Bind Threads}" SelectionMode="None" IsItemClickEnabled="True"
                                        ItemClick="OnGroupedThreadClicked" MaxHeight="260" ItemContainerStyle="{StaticResource PiSidebarListViewItemStyle}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:ThreadDescriptor">
                                                <StackPanel Spacing="2" Padding="4,3">
                                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="Pinned" Visibility="{x:Bind IsPinned}" FontSize="11" Foreground="{ThemeResource PiAccentBrush}" />
                                                        <TextBlock Text="{x:Bind ActivityStatus}" FontSize="11" Foreground="{ThemeResource PiTextMutedBrush}" />
                                                        <TextBlock Text="{x:Bind UnreadLabel}" Foreground="{ThemeResource PiAccentBrush}" />
                                                        <TextBlock Text="{x:Bind BranchName}" FontSize="11" Foreground="{ThemeResource PiTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="2" Margin="8,9,0,4" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PiSectionLabelTextStyle}" Text="THREADS" />
                        <Button
                            Grid.Column="1"
                            automation:AutomationProperties.AutomationId="ThreadBulkActionsButton"
                            automation:AutomationProperties.Name="Bulk thread actions"
                            Content="Bulk"
                            Style="{StaticResource PiToolbarButtonStyle}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="OnBulkSettleClicked" Text="Settle selected" />
                                    <MenuFlyoutItem Click="OnBulkMarkUnreadClicked" Text="Mark selected unread" automation:AutomationProperties.AutomationId="BulkMarkUnreadMenuItem" />
                                    <MenuFlyoutItem Click="OnBulkUnsettleClicked" Text="Unsettle selected" />
                                    <MenuFlyoutItem Click="OnBulkSnoozeClicked" Text="Snooze selected for one day" />
                                    <MenuFlyoutItem Click="OnBulkUnsnoozeClicked" Text="Unsnooze selected" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="OnBulkPinClicked" Text="Pin selected" />
                                    <MenuFlyoutItem Click="OnBulkUnpinClicked" Text="Unpin selected" />
                                    <MenuFlyoutItem Click="OnBulkArchiveClicked" Text="Archive selected" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="OnBulkDeleteClicked" Text="Delete selected" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <ToggleButton
                            x:Name="ArchivedThreadsToggle"
                            Grid.Column="2"
                            Width="26"
                            Height="26"
                            automation:AutomationProperties.AutomationId="ArchivedThreadsToggle"
                            automation:AutomationProperties.Name="{x:Bind ViewModel.Workspace.ThreadArchiveViewLabel, Mode=OneWay}"
                            Click="OnArchivedThreadsToggleClicked"
                            IsChecked="{x:Bind ViewModel.Workspace.IsShowingArchivedThreads, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.Workspace.HasSelectedProject, Mode=OneWay}"
                            Style="{StaticResource PiIconToggleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Workspace.ThreadArchiveViewLabel, Mode=OneWay}">
                            <FontIcon FontSize="12" Glyph="&#xE7B8;" />
                        </ToggleButton>
                    </Grid>

                    <Border
                        Grid.Row="3"
                        MinHeight="0"
                        Margin="11,0,0,0"
                        Padding="8,0,0,0"
                        BorderBrush="{ThemeResource PiDividerBrush}"
                        BorderThickness="1,0,0,0">
                        <Grid MinHeight="0">
                            <ListView
                                x:Name="ThreadTabList"
                                IsTabStop="False"
                                automation:AutomationProperties.AutomationId="ThreadTabList"
                                automation:AutomationProperties.Name="Threads"
                                ItemContainerStyle="{StaticResource PiSidebarListViewItemStyle}"
                                ItemsSource="{x:Bind ViewModel.Workspace.Threads}"
                                SelectedItem="{x:Bind ViewModel.Workspace.SelectedThread, Mode=OneWay}"
                                SelectionChanged="OnThreadSelectionChanged"
                                SelectionMode="Extended">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ThreadDescriptor">
                                        <Grid
                                            MinHeight="{StaticResource PiTwoLineRowHeight}"
                                            MinWidth="0"
                                            ColumnSpacing="6"
                                            RightTapped="OnThreadRowRightTapped"
                                            Tag="{x:Bind ThreadId.Value}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    Fill="{ThemeResource PiOfflineBrush}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock
                                                    x:Name="ThreadTitleText"
                                                    automation:AutomationProperties.Name="{x:Bind Title}"
                                                    Foreground="{ThemeResource PiTextPrimaryBrush}"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock
                                                        FontSize="{StaticResource PiFontSizeCaption}"
                                                        Foreground="{ThemeResource PiTextMutedBrush}"
                                                        Text="{x:Bind IsSettled, Converter={StaticResource ThreadStateTextConverter}}" />
                                                    <TextBlock
                                                        FontSize="{StaticResource PiFontSizeCaption}"
                                                        Foreground="{ThemeResource PiTextMutedBrush}"
                                                        Text="·" />
                                                    <TextBlock
                                                        FontSize="{StaticResource PiFontSizeCaption}"
                                                        Foreground="{ThemeResource PiTextMutedBrush}"
                                                        Text="{x:Bind UpdatedUtc, Converter={StaticResource RelativeTimeConverter}}" />
                                                    <TextBlock
                                                        FontSize="{StaticResource PiFontSizeCaption}"
                                                        Foreground="{ThemeResource PiTextMutedBrush}"
                                                        Text="·" />
                                                    <TextBlock
                                                        FontSize="{StaticResource PiFontSizeCaption}"
                                                        Foreground="{ThemeResource PiTextMutedBrush}"
                                                        Text="{x:Bind WorkspaceMode}" />
                                                    <TextBlock
                                                        FontSize="{StaticResource PiFontSizeCaption}"
                                                        Foreground="{ThemeResource PiWaitingBrush}"
                                                        Text="{x:Bind HasUnsentDraft, Converter={StaticResource ThreadDraftTextConverter}}" />
                                                    <TextBlock Text="{x:Bind UnreadLabel}" Foreground="{ThemeResource PiAccentBrush}" automation:AutomationProperties.AutomationId="ThreadUnreadIndicator" />
                                                    <TextBlock
                                                        FontSize="{StaticResource PiFontSizeCaption}"
                                                        Foreground="{ThemeResource PiAccentBrush}"
                                                        Text="Snoozed"
                                                        Visibility="{x:Bind SnoozedUntilUtc, Converter={StaticResource ObjectPresenceToVisibilityConverter}}" />
                                                    <TextBlock
                                                        FontSize="{StaticResource PiFontSizeCaption}"
                                                        Foreground="{ThemeResource PiAccentBrush}"
                                                        Text="{x:Bind PullRequest.Number}"
                                                        Visibility="{x:Bind PullRequest, Converter={StaticResource ObjectPresenceToVisibilityConverter}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Grid
                                                x:Name="ThreadRenameEditor"
                                                Grid.Column="1"
                                                ColumnSpacing="4"
                                                Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    x:Name="ThreadRenameInput"
                                                    MinHeight="28"
                                                    Padding="6,2"
                                                    automation:AutomationProperties.AutomationId="ThreadRenameInput"
                                                    automation:AutomationProperties.Name="Thread title"
                                                    KeyDown="OnThreadRenameKeyDown"
                                                    Style="{StaticResource PiTextBoxStyle}"
                                                    Tag="{x:Bind ThreadId.Value}"
                                                    Text="{x:Bind Title}" />
                                                <Button
                                                    x:Name="CommitThreadRenameButton"
                                                    Grid.Column="1"
                                                    automation:AutomationProperties.AutomationId="CommitThreadRenameButton"
                                                    automation:AutomationProperties.Name="Save thread title"
                                                    Click="OnCommitThreadRenameClicked"
                                                    Style="{StaticResource PiToolbarIconButtonStyle}"
                                                    Tag="{x:Bind ThreadId.Value}">
                                                    <FontIcon FontSize="10" Glyph="&#xE73E;" />
                                                </Button>
                                                <Button
                                                    x:Name="CancelThreadRenameButton"
                                                    Grid.Column="2"
                                                    automation:AutomationProperties.AutomationId="CancelThreadRenameButton"
                                                    automation:AutomationProperties.Name="Cancel thread rename"
                                                    Click="OnCancelThreadRenameClicked"
                                                    Style="{StaticResource PiToolbarIconButtonStyle}"
                                                    Tag="{x:Bind ThreadId.Value}">
                                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                                </Button>
                                            </Grid>

                                            <FontIcon
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                automation:AutomationProperties.AutomationId="PinnedThreadIndicator"
                                                automation:AutomationProperties.Name="Pinned"
                                                FontSize="10"
                                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                                Glyph="&#xE718;"
                                                Visibility="{x:Bind IsPinned}" />

                                            <Button
                                                x:Name="ThreadActionsButton"
                                                Grid.Column="3"
                                                automation:AutomationProperties.AutomationId="ThreadActionsButton"
                                                automation:AutomationProperties.Name="Thread actions"
                                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                                Tag="{x:Bind ThreadId.Value}">
                                                <FontIcon FontSize="11" Glyph="&#xE712;" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="Mark unread" Click="OnMarkUnreadClicked" Tag="{x:Bind ThreadId.Value}" automation:AutomationProperties.AutomationId="MarkThreadUnreadMenuItem" />
                                                        <MenuFlyoutItem
                                                            automation:AutomationProperties.AutomationId="RenameThreadMenuItem"
                                                            automation:AutomationProperties.Name="Rename thread"
                                                            Click="OnRenameThreadClicked"
                                                            Tag="{x:Bind ThreadId.Value}"
                                                            Text="Rename">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            automation:AutomationProperties.AutomationId="ToggleThreadPinMenuItem"
                                                            automation:AutomationProperties.Name="Change thread pin"
                                                            Click="OnToggleThreadPinClicked"
                                                            Tag="{x:Bind ThreadId.Value}"
                                                            Text="{x:Bind IsPinned, Converter={StaticResource ThreadPinActionTextConverter}}">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Click="OnMovePinnedThreadUpClicked" IsEnabled="{x:Bind IsPinned}" Tag="{x:Bind ThreadId.Value}" Text="Move pin up" />
                                                        <MenuFlyoutItem Click="OnMovePinnedThreadDownClicked" IsEnabled="{x:Bind IsPinned}" Tag="{x:Bind ThreadId.Value}" Text="Move pin down" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="OnToggleThreadSettledClicked" Tag="{x:Bind ThreadId.Value}" Text="Settle / unsettle" />
                                                        <MenuFlyoutItem Click="OnToggleThreadSnoozeClicked" Tag="{x:Bind ThreadId.Value}" Text="Snooze / unsnooze" />
                                                        <MenuFlyoutItem Click="OnRegenerateThreadTitleClicked" Tag="{x:Bind ThreadId.Value}" Text="Regenerate title" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem
                                                            automation:AutomationProperties.AutomationId="ToggleThreadArchiveMenuItem"
                                                            automation:AutomationProperties.Name="Change thread archive state"
                                                            Click="OnToggleThreadArchiveClicked"
                                                            Tag="{x:Bind ThreadId.Value}"
                                                            Text="{x:Bind IsArchived, Converter={StaticResource ThreadArchiveActionTextConverter}}">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="OnDeleteThreadClicked" Tag="{x:Bind ThreadId.Value}" Text="Delete" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                x:Name="ThreadListStatusText"
                                Margin="8,14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                automation:AutomationProperties.AutomationId="ThreadListStatusText"
                                automation:AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                IsHitTestVisible="False"
                                Text="{x:Bind ViewModel.Workspace.ThreadListStatus, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.Workspace.ThreadListStatusVisibility, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <TextBlock
                        x:Name="ThreadLifecycleStatusText"
                        Grid.Row="4"
                        Margin="20,5,8,0"
                        automation:AutomationProperties.AutomationId="ThreadLifecycleStatusText"
                        automation:AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.Workspace.ThreadLifecycleStatus, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.Workspace.ThreadLifecycleStatusVisibility, Mode=OneWay}" />
                </Grid>

                <Button
                    x:Name="SettingsButton"
                    Grid.Row="3"
                    automation:AutomationProperties.AutomationId="SettingsButton"
                    automation:AutomationProperties.Name="Open settings"
                    Click="OnSettingsClicked"
                    Style="{StaticResource PiSidebarActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon FontSize="13" Glyph="&#xE713;" />
                        <TextBlock VerticalAlignment="Center" Text="Settings" />
                    </StackPanel>
                </Button>

                <Border
                    Grid.Row="4"
                    Padding="8,9,8,3"
                    BorderBrush="{ThemeResource PiDividerBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            automation:AutomationProperties.AutomationId="AppLoadingView"
                            automation:AutomationProperties.Name="Application ready">
                            <Ellipse Style="{StaticResource PiStatusDotCompletedStyle}" />
                        </Grid>
                        <TextBlock
                            x:Name="ConnectionStatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.AutomationId="ConnectionStatusText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource PiMutedTextStyle}"
                            Text="{x:Bind ViewModel.Connection.Status, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>

            <Grid
                x:Name="CollapsedPane"
                Width="{StaticResource PiSidebarCollapsedWidth}"
                Padding="10,8"
                RowSpacing="8"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button
                    automation:AutomationProperties.AutomationId="ExpandSidebarButton"
                    automation:AutomationProperties.Name="Expand sidebar"
                    Click="OnToggleSidebarClicked"
                    Style="{StaticResource PiToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="Expand sidebar">
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </Button>
                <Button
                    Grid.Row="1"
                    automation:AutomationProperties.AutomationId="NewThreadButton"
                    automation:AutomationProperties.Name="Create thread"
                    Click="OnNewThreadClicked"
                    IsEnabled="{x:Bind ViewModel.CanManageThreads, Mode=OneWay}"
                    Style="{StaticResource PiToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="New thread">
                    <FontIcon FontSize="13" Glyph="&#xE70F;" />
                </Button>
                <Button
                    x:Name="CollapsedNewProjectButton"
                    Grid.Row="2"
                    automation:AutomationProperties.AutomationId="NewProjectButton"
                    automation:AutomationProperties.Name="Add project"
                    Click="OnAddProjectClicked"
                    IsEnabled="{x:Bind ViewModel.CanAddProject, Mode=OneWay}"
                    Style="{StaticResource PiToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="Add project">
                    <FontIcon FontSize="13" Glyph="&#xE710;" />
                </Button>
                <Button
                    x:Name="CollapsedSettingsButton"
                    Grid.Row="4"
                    automation:AutomationProperties.AutomationId="SettingsButton"
                    automation:AutomationProperties.Name="Open settings"
                    Click="OnSettingsClicked"
                    Style="{StaticResource PiToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="13" Glyph="&#xE713;" />
                </Button>
                <Grid
                    Grid.Row="5"
                    Height="28"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Connection.Status, Mode=OneWay}">
                    <Ellipse Style="{StaticResource PiStatusDotCompletedStyle}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
