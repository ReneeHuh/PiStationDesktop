<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.WorkspaceStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">

    <Border
        MinHeight="28"
        Padding="4,0"
        automation:AutomationProperties.AutomationId="WorkspaceStatusBar"
        automation:AutomationProperties.Name="Workspace status"
        Style="{StaticResource PiToolbarSurfaceStyle}">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6"
                ToolTipService.ToolTip="{x:Bind ViewModel.Workspace.ActiveProjectPath, Mode=OneWay}">
                <FontIcon
                    FontSize="11"
                    Foreground="{ThemeResource PiTextMutedBrush}"
                    Glyph="&#xE8B7;" />
                <TextBlock
                    x:Name="WorkspaceProjectStatusText"
                    MaxWidth="360"
                    automation:AutomationProperties.AutomationId="WorkspaceProjectStatusText"
                    FontSize="{StaticResource PiFontSizeCaption}"
                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                    Text="{x:Bind ViewModel.Workspace.ActiveProjectName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock
                x:Name="WorkspaceSourceControlStatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                automation:AutomationProperties.AutomationId="WorkspaceSourceControlStatusText"
                FontSize="{StaticResource PiFontSizeCaption}"
                Foreground="{ThemeResource PiTextMutedBrush}"
                Text="{x:Bind ViewModel.WorkbenchChanges.SourceControlSummary, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
