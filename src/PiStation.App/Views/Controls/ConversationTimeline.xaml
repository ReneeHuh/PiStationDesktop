<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.ConversationTimeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:viewModels="using:PiStation.App.ViewModels"
    xmlns:views="using:PiStation.App.Views">

    <UserControl.Resources>
        <DataTemplate x:Key="MessageTimelineItemTemplate" x:DataType="viewModels:MessageTimelineItemViewModel">
            <Grid
                MaxWidth="{StaticResource PiReadingColumnWidth}"
                Margin="0,6"
                HorizontalAlignment="Stretch">
                <Border
                    MaxWidth="{StaticResource PiUserMessageMaxWidth}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PiUserMessageStyle}"
                    Visibility="{x:Bind UserVisibility}">
                    <StackPanel Spacing="8">
                        <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Text}" TextWrapping="Wrap" Foreground="{ThemeResource PiMessageForegroundBrush}" />
                        <ItemsControl ItemsSource="{x:Bind Attachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:DraftAttachmentViewModel">
                                    <StackPanel Spacing="4" Margin="0,4">
                                        <TextBlock Text="{x:Bind FileName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                        <Image Width="160" Height="120" HorizontalAlignment="Left" Stretch="Uniform"
                                            Loaded="OnSentMediaLoaded" Unloaded="OnSentMediaUnloaded" DataContextChanged="OnSentMediaContextChanged"
                                            Visibility="{x:Bind PreviewVisibility}" automation:AutomationProperties.Name="{x:Bind FileName}" />
                                        <MediaPlayerElement AutoPlay="False" AreTransportControlsEnabled="True" MaxHeight="280"
                                            Loaded="OnSentMediaLoaded" Unloaded="OnSentMediaUnloaded" DataContextChanged="OnSentMediaContextChanged" Visibility="{x:Bind VideoVisibility}"
                                            automation:AutomationProperties.Name="{x:Bind FileName}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Content="Preview" Click="OnPreviewSentAttachment" IsEnabled="{x:Bind IsImage}" automation:AutomationProperties.Name="Preview sent image" />
                                            <Button Content="Open" Click="OnOpenSentAttachment" automation:AutomationProperties.Name="Open sent attachment" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Content="Save as" Click="OnSaveSentAttachment" automation:AutomationProperties.Name="Save sent attachment as" />
                                            <Button Content="Copy path" Click="OnCopySentAttachmentPath" ToolTipService.ToolTip="Copy local attachment path" automation:AutomationProperties.Name="Copy sent attachment path" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{x:Bind Citations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ComposerContextChipViewModel">
                                    <Expander Header="{x:Bind Label}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="6">
                                            <Button Content="Open source" Click="OnOpenSentCitation" automation:AutomationProperties.Name="Open citation source" />
                                            <TextBlock Text="{x:Bind Comment}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource PiAssistantMessageStyle}"
                    Visibility="{x:Bind MarkdownVisibility}">
                    <StackPanel Spacing="6">
                        <views:MarkdownView
                            automation:AutomationProperties.AutomationId="MarkdownMessageBody"
                            WorkspaceLinkRequested="OnWorkspaceLinkRequested"
                            BrowserLinkRequested="OnBrowserLinkRequested"
                            SelectionQuoteRequested="OnSelectionQuoteRequested"
                            SelectionCiteRequested="OnSelectionCiteRequested"
                            Text="{x:Bind Text}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                            <Button
                                automation:AutomationProperties.AutomationId="QuoteResponseButton"
                                automation:AutomationProperties.Name="Quote response in prompt"
                                Click="OnQuoteResponseClicked"
                                Content="Quote"
                                Style="{StaticResource PiToolbarButtonStyle}" />
                            <Button
                                automation:AutomationProperties.AutomationId="CiteResponseButton"
                                automation:AutomationProperties.Name="Cite response as prompt context"
                                Click="OnCiteResponseClicked"
                                Content="Cite"
                                Style="{StaticResource PiToolbarButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource PiBannerStyle}"
                    Visibility="{x:Bind SupportingMessageVisibility}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{StaticResource PiSectionLabelTextStyle}"
                            Text="{x:Bind Role}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Text}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ThinkingTimelineItemTemplate" x:DataType="viewModels:ThinkingTimelineItemViewModel">
            <Border
                MaxWidth="{StaticResource PiReadingColumnWidth}"
                Margin="0,2"
                Padding="0"
                Style="{StaticResource PiDisclosureRowStyle}">
                <Expander
                    Padding="0"
                    automation:AutomationProperties.AutomationId="ReasoningExpander"
                    automation:AutomationProperties.Name="{x:Bind AccessibleName}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="{x:Bind IsExpanded, Mode=OneWay}">
                    <Expander.Header>
                        <Grid
                            MinHeight="32"
                            Padding="8,2"
                            HorizontalAlignment="Stretch"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                <Ellipse
                                    Style="{StaticResource PiStatusDotRunningStyle}"
                                    Visibility="{x:Bind RunningVisibility}" />
                                <Ellipse
                                    Style="{StaticResource PiStatusDotCompletedStyle}"
                                    Visibility="{x:Bind CompletedVisibility}" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="Reasoning" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="{ThemeResource PiFontSizeCaption}"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="{x:Bind State}" />
                        </Grid>
                    </Expander.Header>
                    <TextBlock
                        Margin="26,0,10,10"
                        automation:AutomationProperties.AutomationId="ReasoningText"
                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap" />
                </Expander>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ToolTimelineItemTemplate" x:DataType="viewModels:ToolActivityGroupTimelineItemViewModel">
            <Border
                MaxWidth="{StaticResource PiReadingColumnWidth}"
                Margin="0,2"
                Padding="0"
                automation:AutomationProperties.AutomationId="ToolActivityGroup"
                automation:AutomationProperties.Name="{x:Bind AccessibleName}"
                Style="{StaticResource PiDisclosureRowStyle}">
                <StackPanel>
                    <Grid MinHeight="32" Padding="8,2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse
                                Style="{StaticResource PiStatusDotRunningStyle}"
                                Visibility="{x:Bind RunningVisibility}" />
                            <Ellipse
                                Style="{StaticResource PiStatusDotCompletedStyle}"
                                Visibility="{x:Bind CompletedVisibility}" />
                            <Ellipse
                                Style="{StaticResource PiStatusDotCriticalStyle}"
                                Visibility="{x:Bind FailedVisibility}" />
                        </Grid>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Tools" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="{ThemeResource PiFontSizeCaption}"
                            Foreground="{ThemeResource PiTextSecondaryBrush}"
                            Text="{x:Bind CountLabel}" />
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            FontSize="{ThemeResource PiFontSizeCaption}"
                            Foreground="{ThemeResource PiTextSecondaryBrush}"
                            Text="{x:Bind StateLabel}" />
                    </Grid>
                    <ItemsControl
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{x:Bind Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ToolActivityItemViewModel">
                                <Border
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="{ThemeResource PiDividerBrush}"
                                    BorderThickness="0,1,0,0">
                                    <Expander
                                        Padding="0"
                                        automation:AutomationProperties.AutomationId="ToolActivityExpander"
                                        automation:AutomationProperties.Name="{x:Bind AccessibleName}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        IsExpanded="{x:Bind IsExpanded, Mode=OneWay}">
                                        <Expander.Header>
                                            <Grid
                                                MinHeight="32"
                                                Padding="8,2"
                                                HorizontalAlignment="Stretch"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                                    <Ellipse
                                                        Style="{StaticResource PiStatusDotRunningStyle}"
                                                        Visibility="{x:Bind RunningVisibility}" />
                                                    <Ellipse
                                                        Style="{StaticResource PiStatusDotCompletedStyle}"
                                                        Visibility="{x:Bind CompletedVisibility}" />
                                                    <Ellipse
                                                        Style="{StaticResource PiStatusDotCriticalStyle}"
                                                        Visibility="{x:Bind FailedVisibility}" />
                                                </Grid>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                                    FontSize="{ThemeResource PiFontSizeCaption}"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="{ThemeResource PiFontSizeCaption}"
                                                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                                                    Text="{x:Bind StateLabel}" />
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Margin="26,0,10,10" Spacing="6">
                                            <TextBlock
                                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                                Style="{StaticResource PiSectionLabelTextStyle}"
                                                Text="Arguments" />
                                            <TextBlock
                                                automation:AutomationProperties.AutomationId="ToolArgumentsText"
                                                FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                                FontSize="{ThemeResource PiFontSizeCaption}"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind ArgumentsDisplay}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,5,0,0"
                                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                                Style="{StaticResource PiSectionLabelTextStyle}"
                                                Text="Output" />
                                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                <TextBlock
                                                    automation:AutomationProperties.AutomationId="ToolOutputText"
                                                    FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                                    FontSize="{ThemeResource PiFontSizeCaption}"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind OutputDisplay}"
                                                    TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StatusTimelineItemTemplate" x:DataType="viewModels:StatusTimelineItemViewModel">
            <StackPanel
                Margin="8,3"
                automation:AutomationProperties.Name="Status activity"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsRunning}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                    Text="{x:Bind Text}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                    Text="{x:Bind State}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ErrorTimelineItemTemplate" x:DataType="viewModels:ErrorTimelineItemViewModel">
            <Border
                MaxWidth="{StaticResource PiReadingColumnWidth}"
                Margin="0,4"
                automation:AutomationProperties.Name="Runtime failure"
                Style="{StaticResource PiCriticalBannerStyle}">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Code}" />
                    <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                        Text="{x:Bind Recovery}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ApprovalTimelineItemTemplate" x:DataType="viewModels:ApprovalTimelineItemViewModel">
            <Border
                MaxWidth="{StaticResource PiReadingColumnWidth}"
                Margin="0,4"
                automation:AutomationProperties.Name="Approval request"
                Style="{StaticResource PiWarningBannerStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                        Text="{x:Bind Resolution}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            automation:AutomationProperties.AutomationId="ApprovalApproveButton"
                            Click="OnApproveInteractionClicked"
                            Content="Approve"
                            IsEnabled="{x:Bind IsPending}"
                            Style="{StaticResource PiPrimaryButtonStyle}" />
                        <Button
                            automation:AutomationProperties.AutomationId="ApprovalRejectButton"
                            Click="OnRejectInteractionClicked"
                            Content="Reject"
                            IsEnabled="{x:Bind IsPending}"
                            Style="{StaticResource PiSecondaryButtonStyle}" />
                        <Button
                            automation:AutomationProperties.AutomationId="ApprovalCancelButton"
                            Click="OnCancelInteractionClicked"
                            Content="Cancel"
                            IsEnabled="{x:Bind IsPending}"
                            Style="{StaticResource PiToolbarButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="QuestionTimelineItemTemplate" x:DataType="viewModels:QuestionTimelineItemViewModel">
            <Border
                MaxWidth="{StaticResource PiReadingColumnWidth}"
                Margin="0,4"
                automation:AutomationProperties.Name="Question request"
                BorderBrush="{ThemeResource PiAccentBrush}"
                Style="{StaticResource PiBannerStyle}">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                    <TextBlock Text="{x:Bind Prompt}" TextWrapping="Wrap" />
                    <ComboBox
                        automation:AutomationProperties.AutomationId="QuestionOptionSelector"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind IsPending}"
                        ItemsSource="{x:Bind Options}"
                        SelectedItem="{x:Bind SelectedOption, Mode=TwoWay}"
                        Style="{StaticResource PiComboBoxStyle}"
                        Visibility="{x:Bind OptionsVisibility}" />
                    <PasswordBox PasswordChanged="OnSecretQuestionChanged" IsEnabled="{x:Bind IsPending}"
                        Visibility="{x:Bind SecretVisibility}" automation:AutomationProperties.AutomationId="QuestionSecretInput" />
                    <TextBox
                        automation:AutomationProperties.AutomationId="QuestionAnswerInput"
                        AcceptsReturn="True"
                        IsEnabled="{x:Bind IsPending}"
                        PlaceholderText="{x:Bind Prompt}"
                        Style="{StaticResource PiTextBoxStyle}"
                        Text="{x:Bind AnswerText, Mode=TwoWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind TextVisibility}" />
                    <TextBlock
                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                        Text="{x:Bind Resolution}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            automation:AutomationProperties.AutomationId="QuestionSubmitButton"
                            Click="OnAnswerQuestionClicked"
                            Content="Submit"
                            IsEnabled="{x:Bind IsPending}"
                            Style="{StaticResource PiPrimaryButtonStyle}" />
                        <Button
                            automation:AutomationProperties.AutomationId="QuestionCancelButton"
                            Click="OnCancelInteractionClicked"
                            Content="Cancel"
                            IsEnabled="{x:Bind IsPending}"
                            Style="{StaticResource PiSecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CheckpointTimelineItemTemplate" x:DataType="viewModels:CheckpointTimelineItemViewModel">
            <Border
                MaxWidth="{StaticResource PiReadingColumnWidth}"
                Margin="0,4"
                Padding="0"
                automation:AutomationProperties.AutomationId="TurnCheckpointCard"
                automation:AutomationProperties.Name="{x:Bind AccessibleName}"
                Style="{StaticResource PiDisclosureRowStyle}">
                <Expander
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid MinHeight="36" Padding="8,3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Width="18"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Glyph="&#xE73E;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Summary}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="{ThemeResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                    Text="{x:Bind TurnLabel}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="7"
                                Visibility="{x:Bind StatsVisibility}">
                                <TextBlock
                                    FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                    FontSize="{ThemeResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiAccentBrush}"
                                    Text="{x:Bind AdditionsLabel}" />
                                <TextBlock
                                    FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                    FontSize="{ThemeResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiCriticalBrush}"
                                    Text="{x:Bind DeletionsLabel}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="10,0,10,10" Spacing="8">
                        <ItemsControl
                            ItemsSource="{x:Bind Files}"
                            Visibility="{x:Bind FilesVisibility}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:CheckpointFileViewModel">
                                    <Button
                                        MinHeight="34"
                                        Padding="7,3"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        automation:AutomationProperties.Name="{x:Bind AccessibleName}"
                                        Click="OnCheckpointFileClicked"
                                        Style="{StaticResource PiToolbarButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind FileName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                                    FontSize="{ThemeResource PiFontSizeCaption}"
                                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                                    Text="{x:Bind RelativePath}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                                FontSize="{ThemeResource PiFontSizeCaption}"
                                                Foreground="{ThemeResource PiAccentBrush}"
                                                Text="{x:Bind AdditionsLabel}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                                FontSize="{ThemeResource PiFontSizeCaption}"
                                                Foreground="{ThemeResource PiCriticalBrush}"
                                                Text="{x:Bind DeletionsLabel}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                automation:AutomationProperties.AutomationId="TurnCheckpointDiffButton"
                                Click="OnTurnCheckpointDiffClicked"
                                Content="Turn diff"
                                IsEnabled="{x:Bind CanViewDiff}"
                                Style="{StaticResource PiSecondaryButtonStyle}" />
                            <Button
                                automation:AutomationProperties.AutomationId="FullThreadCheckpointDiffButton"
                                Click="OnFullThreadCheckpointDiffClicked"
                                Content="Full thread diff"
                                IsEnabled="{x:Bind CanViewDiff}"
                                Style="{StaticResource PiSecondaryButtonStyle}" />
                            <Button
                                automation:AutomationProperties.AutomationId="RevertCheckpointButton"
                                Click="OnRevertCheckpointClicked"
                                Content="Revert turn"
                                Foreground="{ThemeResource PiCriticalBrush}"
                                IsEnabled="{x:Bind CanRevert}"
                                Style="{StaticResource PiToolbarButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TurnBoundaryTimelineItemTemplate" x:DataType="viewModels:TurnBoundaryTimelineItemViewModel">
            <Grid
                MaxWidth="{StaticResource PiReadingColumnWidth}"
                Margin="0,5"
                automation:AutomationProperties.Name="{x:Bind AccessibleName}">
                <StackPanel
                    HorizontalAlignment="Right"
                    ToolTipService.ToolTip="{x:Bind Details}"
                    Orientation="Horizontal"
                    Spacing="5">
                    <TextBlock
                        FontSize="{ThemeResource PiFontSizeCaption}"
                        Foreground="{ThemeResource PiTextMutedBrush}"
                        Text="{x:Bind Label}" />
                    <TextBlock
                        automation:AutomationProperties.AutomationId="TurnMetricsText"
                        FontSize="{ThemeResource PiFontSizeCaption}"
                        Foreground="{ThemeResource PiTextMutedBrush}"
                        Text="{x:Bind Metadata}"
                        Visibility="{x:Bind MetadataVisibility}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <views:TimelineItemTemplateSelector
            x:Key="TimelineItemTemplateSelector"
            ApprovalTemplate="{StaticResource ApprovalTimelineItemTemplate}"
            CheckpointTemplate="{StaticResource CheckpointTimelineItemTemplate}"
            ErrorTemplate="{StaticResource ErrorTimelineItemTemplate}"
            MessageTemplate="{StaticResource MessageTimelineItemTemplate}"
            QuestionTemplate="{StaticResource QuestionTimelineItemTemplate}"
            StatusTemplate="{StaticResource StatusTimelineItemTemplate}"
            ThinkingTemplate="{StaticResource ThinkingTimelineItemTemplate}"
            ToolTemplate="{StaticResource ToolTimelineItemTemplate}"
            TurnBoundaryTemplate="{StaticResource TurnBoundaryTimelineItemTemplate}" />
    </UserControl.Resources>

    <Grid automation:AutomationProperties.Name="Conversation timeline">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView
            x:Name="TranscriptList"
            automation:AutomationProperties.AutomationId="TranscriptList"
            automation:AutomationProperties.Name="Conversation transcript"
            ContainerContentChanging="OnTranscriptContainerContentChanging"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource PiTranscriptListViewItemStyle}"
            ItemTemplateSelector="{StaticResource TimelineItemTemplateSelector}"
            ItemsSource="{x:Bind ViewModel.Thread.Timeline}"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Enabled"
            SelectionMode="None">
            <ListView.Header>
                <StackPanel Spacing="6" Padding="8" Visibility="{x:Bind ViewModel.Thread.EarlierHistoryVisibility, Mode=OneWay}">
                    <Button Content="Load earlier messages" Click="OnLoadEarlierClicked" IsEnabled="{x:Bind ViewModel.Thread.CanLoadHistory, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="LoadEarlierHistoryButton" />
                    <TextBlock automation:AutomationProperties.AutomationId="ThreadHistoryStatus" Text="{x:Bind ViewModel.Thread.HistoryStatus, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </ListView.Header>
        </ListView>

        <StackPanel
            x:Name="NoProjectEmptyState"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            automation:AutomationProperties.AutomationId="NoProjectEmptyState"
            automation:AutomationProperties.Name="No local project selected"
            IsHitTestVisible="False"
            Spacing="8"
            Visibility="{x:Bind ViewModel.Workspace.NoProjectEmptyStateVisibility, Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="{ThemeResource PiTextMutedBrush}"
                Glyph="&#xE8B7;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource PiPanelHeaderTextStyle}"
                Text="Open a local project" />
            <TextBlock
                Foreground="{ThemeResource PiTextSecondaryBrush}"
                Text="Add a project from the sidebar to create a Pi thread in that workspace."
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <StackPanel
            x:Name="NoThreadEmptyState"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            automation:AutomationProperties.AutomationId="NoThreadEmptyState"
            automation:AutomationProperties.Name="No thread selected"
            IsHitTestVisible="False"
            Spacing="8"
            Visibility="{x:Bind ViewModel.Workspace.NoThreadEmptyStateVisibility, Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="{ThemeResource PiTextMutedBrush}"
                Glyph="&#xE70F;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource PiPanelHeaderTextStyle}"
                Text="Create a Pi thread" />
            <TextBlock
                Foreground="{ThemeResource PiTextSecondaryBrush}"
                Text="Start a thread for this project, or choose an existing thread from the sidebar."
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <StackPanel
            x:Name="ThreadEmptyState"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            automation:AutomationProperties.AutomationId="ThreadEmptyState"
            automation:AutomationProperties.Name="Thread has no messages"
            IsHitTestVisible="False"
            Spacing="8"
            Visibility="{x:Bind ViewModel.Thread.EmptyTimelineVisibility, Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="26"
                Foreground="{ThemeResource PiTextMutedBrush}"
                Glyph="&#xE8BD;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource PiPanelHeaderTextStyle}"
                Text="Ask Pi about this project" />
            <TextBlock
                Foreground="{ThemeResource PiTextSecondaryBrush}"
                Text="Send a prompt below. Pi's responses, reasoning, and tool activity will appear here."
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Button x:Name="JumpToLatestButton" Content="Jump to latest ↓"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
            Visibility="Collapsed" Click="OnJumpToLatestClicked"
            automation:AutomationProperties.AutomationId="JumpToLatestButton"
            Style="{StaticResource PiCompactButtonStyle}" />

        <TextBlock
            x:Name="LatestAssistantMessage"
            Grid.Row="1"
            Height="1"
            IsHitTestVisible="False"
            Opacity="0"
            automation:AutomationProperties.AutomationId="LatestAssistantMessage"
            automation:AutomationProperties.LiveSetting="Polite"
            automation:AutomationProperties.Name="Latest assistant content"
            Foreground="{ThemeResource PiTextSecondaryBrush}"
            Text="{x:Bind ViewModel.Thread.LatestAssistantText, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
