<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.RecoveryBannerSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">

    <StackPanel
        automation:AutomationProperties.AutomationId="RecoveryBannerStack"
        automation:AutomationProperties.Name="Conversation notices"
        Spacing="6">
        <InfoBar
            x:Name="PiCrashBanner"
            automation:AutomationProperties.AutomationId="PiCrashBanner"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Thread.HasPiCrash, Mode=OneWay}"
            Message="{x:Bind ViewModel.Thread.PiCrashMessage, Mode=OneWay}"
            Severity="Error"
            Title="Pi process stopped">
            <InfoBar.ActionButton>
                <Button
                    x:Name="RestartPiButton"
                    automation:AutomationProperties.AutomationId="RestartPiButton"
                    automation:AutomationProperties.Name="Restart Pi for the active thread"
                    Click="OnRestartPiClicked"
                    Content="Restart Pi"
                    IsEnabled="{x:Bind ViewModel.CanRestartPi, Mode=OneWay}"
                    Style="{StaticResource PiCompactButtonStyle}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar
            x:Name="TransportErrorBanner"
            automation:AutomationProperties.AutomationId="TransportErrorBanner"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Connection.HasTransportError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Connection.TransportErrorMessage, Mode=OneWay}"
            Severity="Warning"
            Title="Local environment disconnected">
            <InfoBar.ActionButton>
                <Button
                    x:Name="ReconnectButton"
                    automation:AutomationProperties.AutomationId="ReconnectButton"
                    automation:AutomationProperties.Name="Reconnect to the local environment"
                    Click="OnReconnectClicked"
                    Content="Reconnect"
                    Style="{StaticResource PiCompactButtonStyle}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar
            x:Name="UncertainCommandBanner"
            automation:AutomationProperties.AutomationId="UncertainCommandBanner"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Connection.HasUncertainCommand, Mode=OneWay}"
            Message="{x:Bind ViewModel.Connection.UncertainCommandMessage, Mode=OneWay}"
            Severity="Warning"
            Title="Command status uncertain">
            <InfoBar.ActionButton>
                <Button
                    x:Name="ResolveCommandButton"
                    automation:AutomationProperties.AutomationId="ResolveCommandButton"
                    automation:AutomationProperties.Name="Check uncertain command receipt"
                    Click="OnResolveCommandClicked"
                    Content="Check status"
                    Style="{StaticResource PiCompactButtonStyle}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar
            x:Name="RuntimeErrorBanner"
            automation:AutomationProperties.AutomationId="RuntimeErrorBanner"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.Connection.HasRuntimeError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Connection.RuntimeErrorMessage, Mode=OneWay}"
            Severity="Error"
            Title="Operation failed" />
    </StackPanel>
</UserControl>
