<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.ComposerSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:models="using:PiStation.Protocol.Models"
    xmlns:viewModels="using:PiStation.App.ViewModels">

    <Border
        x:Name="ComposerRoot"
        MinHeight="{StaticResource PiComposerMinHeight}"
        AllowDrop="True"
        automation:AutomationProperties.AutomationId="ComposerSurface"
        automation:AutomationProperties.Name="Message composer"
        DragOver="OnComposerDragOver"
        Drop="OnComposerDrop"
        SizeChanged="OnComposerSizeChanged"
        Style="{StaticResource PiComposerSurfaceStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ComposerResponsiveStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PiConfigurationPanel.Spacing" Value="4" />
                        <Setter Target="PiModelSelector.MinWidth" Value="96" />
                        <Setter Target="PiThinkingLevelSelector.MinWidth" Value="84" />
                        <Setter Target="ComposerStatusRegion.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PiConfigurationPanel.Spacing" Value="4" />
                        <Setter Target="PiModelSelector.MinWidth" Value="108" />
                        <Setter Target="PiThinkingLevelSelector.MinWidth" Value="92" />
                        <Setter Target="ComposerStatusRegion.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StandardLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PiConfigurationPanel.Spacing" Value="6" />
                        <Setter Target="PiModelSelector.MinWidth" Value="128" />
                        <Setter Target="PiThinkingLevelSelector.MinWidth" Value="108" />
                        <Setter Target="ComposerStatusRegion.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PiConfigurationPanel.Spacing" Value="6" />
                        <Setter Target="PiModelSelector.MinWidth" Value="128" />
                        <Setter Target="PiThinkingLevelSelector.MinWidth" Value="108" />
                        <Setter Target="ComposerStatusRegion.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="ComposerDiscoveryPanel"
                MaxHeight="260"
                Margin="0,0,0,8"
                Padding="8"
                automation:AutomationProperties.AutomationId="ComposerDiscoveryPanel"
                automation:AutomationProperties.Name="Slash commands and skills"
                Style="{StaticResource PiElevatedSurfaceStyle}"
                Visibility="{x:Bind ViewModel.ComposerPower.SuggestionsVisibility, Mode=OneWay}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Style="{StaticResource PiPanelHeaderTextStyle}"
                        Text="{x:Bind ViewModel.ComposerPower.Status, Mode=OneWay}" />
                    <ListView
                        x:Name="ComposerDiscoveryList"
                        Grid.Row="1"
                        MaxHeight="200"
                        IsItemClickEnabled="True"
                        ItemClick="OnComposerCommandClicked"
                        ItemsSource="{x:Bind ViewModel.ComposerPower.Suggestions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.ComposerPower.SelectedIndex, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ComposerCommandDescriptor">
                                <Grid Padding="6,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{StaticResource PiMonospaceFontFamily}" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="1" Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" FontSize="{StaticResource PiFontSizeCaption}" Foreground="{ThemeResource PiTextMutedBrush}" Text="{x:Bind Source}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                x:Name="FileMentionSuggestionsPanel"
                MaxHeight="240"
                Margin="0,0,0,8"
                Padding="8"
                automation:AutomationProperties.AutomationId="FileMentionSuggestionsPanel"
                automation:AutomationProperties.Name="Project file suggestions"
                Style="{StaticResource PiElevatedSurfaceStyle}"
                Visibility="{x:Bind ViewModel.FileMentions.SuggestionsVisibility, Mode=OneWay}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Project files" />
                        <TextBlock
                            x:Name="FileMentionStatusText"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            automation:AutomationProperties.AutomationId="FileMentionStatusText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource PiTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.FileMentions.Status, Mode=OneWay}" />
                    </Grid>
                    <ListView
                        x:Name="FileMentionSuggestionsList"
                        Grid.Row="1"
                        MaxHeight="180"
                        automation:AutomationProperties.AutomationId="FileMentionSuggestionsList"
                        automation:AutomationProperties.Name="Matching project files"
                        IsItemClickEnabled="True"
                        ItemClick="OnFileMentionSuggestionClicked"
                        ItemsSource="{x:Bind ViewModel.FileMentions.Suggestions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.FileMentions.SelectedIndex, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectFileMatch">
                                <Button
                                    Padding="6,4"
                                    automation:AutomationProperties.AutomationId="FileMentionSuggestionButton"
                                    automation:AutomationProperties.Name="{x:Bind RelativePath}"
                                    Click="OnFileMentionSuggestionInvoked"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource PiToolbarButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource PiTextSecondaryBrush}"
                                            Text="{x:Bind RelativePath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ListView
                x:Name="ComposerContextChipList"
                Grid.Row="1"
                MaxHeight="42"
                Margin="0,0,0,6"
                automation:AutomationProperties.AutomationId="ComposerContextChipList"
                automation:AutomationProperties.Name="Prompt context"
                ItemsSource="{x:Bind ViewModel.ComposerPower.ContextChips, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.ComposerPower.ContextChipsVisibility, Mode=OneWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ComposerContextChipViewModel">
                        <Border Margin="0,0,6,0" Style="{StaticResource PiAttachmentChipStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center" FontSize="{StaticResource PiFontSizeCaption}" Foreground="{ThemeResource PiAccentBrush}" Text="{x:Bind Kind}" />
                                <Button MaxWidth="220" Click="OnContextSourceClicked" Content="{x:Bind Label}" Style="{StaticResource PiToolbarButtonStyle}" ToolTipService.ToolTip="Go to source" />
                                <Button Content="Comment" Click="OnEditCitationComment" Style="{StaticResource PiToolbarButtonStyle}" />
                                <Button Click="OnRemoveContextClicked" Style="{StaticResource PiToolbarIconButtonStyle}" ToolTipService.ToolTip="Remove context">
                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView
                x:Name="DraftAttachmentList"
                Grid.Row="2"
                Height="{x:Bind ViewModel.Composer.AttachmentRailHeight, Mode=OneWay}"
                MaxHeight="42"
                Margin="0,0,0,6"
                automation:AutomationProperties.AutomationId="DraftAttachmentList"
                automation:AutomationProperties.Name="Draft attachments"
                ItemsSource="{x:Bind ViewModel.Composer.Attachments, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DraftAttachmentViewModel">
                        <Border
                            MaxWidth="300"
                            Margin="0,0,6,0"
                            Style="{StaticResource PiAttachmentChipStyle}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="26"
                                    Height="26"
                                    Loaded="OnAttachmentImageLoaded" Unloaded="OnAttachmentImageUnloaded" DataContextChanged="OnAttachmentImageContextChanged"
                                    Stretch="UniformToFill"
                                    Visibility="{x:Bind PreviewVisibility}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind FileName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                    Text="{x:Bind Detail}" />
                                <Button
                                    Grid.Column="3"
                                    automation:AutomationProperties.AutomationId="RemoveAttachmentButton"
                                    automation:AutomationProperties.Name="Remove attachment"
                                    Click="OnRemoveAttachmentClicked"
                                    Style="{StaticResource PiToolbarIconButtonStyle}"
                                    ToolTipService.ToolTip="Remove attachment">
                                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBox
                x:Name="PromptInput"
                IsReadOnly="{x:Bind ViewModel.IsComposerReadOnly, Mode=OneWay}"
                Grid.Row="3"
                Height="48"
                MinHeight="48"
                MaxHeight="144"
                automation:AutomationProperties.AutomationId="PromptInput"
                automation:AutomationProperties.Name="Prompt for Pi"
                AcceptsReturn="True"
                PlaceholderText="Ask Pi anything…"
                PreviewKeyDown="OnPromptInputPreviewKeyDown"
                PreviewKeyUp="OnPromptInputPreviewKeyUp"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionChanged="OnPromptInputChanged"
                SizeChanged="OnPromptInputSizeChanged"
                Style="{StaticResource PiComposerTextBoxStyle}"
                Text="{x:Bind ViewModel.PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="OnPromptInputChanged"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="AttachmentNoticeText"
                Grid.Row="4"
                Height="{x:Bind ViewModel.Composer.AttachmentNoticeHeight, Mode=OneWay}"
                Margin="4,2,4,0"
                automation:AutomationProperties.AutomationId="AttachmentNoticeText"
                FontSize="{StaticResource PiFontSizeCaption}"
                Foreground="{ThemeResource PiTextMutedBrush}"
                Text="{x:Bind ViewModel.Composer.AttachmentNotice, Mode=OneWay}"
                TextWrapping="Wrap" />

            <Border Grid.Row="5" Style="{StaticResource PiComposerToolbarStyle}">
                <Grid ColumnSpacing="6" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6">

                    <Button
                        x:Name="AttachFilesButton"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        automation:AutomationProperties.AutomationId="AttachFilesButton"
                        automation:AutomationProperties.Name="Attach files to draft"
                        Click="OnAttachFilesClicked"
                        IsEnabled="{x:Bind ViewModel.CanAttachFiles, Mode=OneWay}"
                        Style="{StaticResource PiToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="Attach files">
                        <FontIcon FontSize="14" Glyph="&#xE723;" />
                    </Button>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        automation:AutomationProperties.AutomationId="AddComposerContextButton"
                        automation:AutomationProperties.Name="Add terminal or diff context"
                        Content="Context"
                        Style="{StaticResource PiToolbarButtonStyle}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnAddTerminalContextClicked" Text="Terminal output" />
                                <MenuFlyoutItem Click="OnAddDiffContextClicked" Text="Selected diff" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        automation:AutomationProperties.AutomationId="PromptStashButton"
                        automation:AutomationProperties.Name="Prompt stash"
                        Content="Stash"
                        Style="{StaticResource PiToolbarButtonStyle}">
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Width="320" MaxHeight="360" Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource PiPanelHeaderTextStyle}" Text="Prompt stash" />
                                        <Button Grid.Column="1" Click="OnStashPromptClicked" Content="Stash current" IsEnabled="{x:Bind ViewModel.CanStashPrompt, Mode=OneWay}" Style="{StaticResource PiPrimaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="Save a prompt for later without sending it." TextWrapping="Wrap" />
                                    <ListView ItemsSource="{x:Bind ViewModel.ComposerPower.Stashes, Mode=OneWay}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:PromptStash">
                                                <Grid Padding="4" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="{StaticResource PiFontSizeCaption}" Foreground="{ThemeResource PiTextMutedBrush}" Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Click="OnRestorePromptStashClicked" Content="Restore" Style="{StaticResource PiToolbarButtonStyle}" />
                                                    <Button Grid.Column="2" Click="OnDeletePromptStashClicked" Style="{StaticResource PiToolbarIconButtonStyle}" ToolTipService.ToolTip="Delete stash"><FontIcon FontSize="10" Glyph="&#xE74D;" /></Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <StackPanel
                        x:Name="PiConfigurationPanel"
                        Grid.Row="0"
                        Grid.Column="3"
                        automation:AutomationProperties.AutomationId="PiConfigurationPanel"
                        automation:AutomationProperties.Name="Pi configuration"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.Workspace.PiConfigurationVisibility, Mode=OneWay}">
                        <ComboBox
                            x:Name="PiModelSelector"
                            MinWidth="128"
                            automation:AutomationProperties.AutomationId="PiModelSelector"
                            automation:AutomationProperties.Name="Pi model"
                            DisplayMemberPath="DisplayName"
                            IsEnabled="{x:Bind ViewModel.CanConfigurePi, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.PiConfiguration.VisibleModels}"
                            SelectedItem="{x:Bind ViewModel.PiConfiguration.SelectedModel, Mode=OneWay}"
                            SelectionChanged="OnPiModelSelectionChanged"
                            Style="{StaticResource PiComposerComboBoxStyle}"
                            ToolTipService.ToolTip="Model"
                            Visibility="{x:Bind ViewModel.PiConfiguration.ModelSelectorVisibility, Mode=OneWay}" />
                        <ComboBox
                            x:Name="PiThinkingLevelSelector"
                            MinWidth="108"
                            automation:AutomationProperties.AutomationId="PiThinkingLevelSelector"
                            automation:AutomationProperties.Name="Reasoning level"
                            DisplayMemberPath="DisplayName"
                            IsEnabled="{x:Bind ViewModel.CanConfigurePi, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.PiConfiguration.ThinkingLevels}"
                            SelectedItem="{x:Bind ViewModel.PiConfiguration.SelectedThinkingLevel, Mode=OneWay}"
                            SelectionChanged="OnPiThinkingLevelSelectionChanged"
                            Style="{StaticResource PiComposerComboBoxStyle}"
                            ToolTipService.ToolTip="Reasoning"
                            Visibility="{x:Bind ViewModel.PiConfiguration.ThinkingLevelSelectorVisibility, Mode=OneWay}" />
                        <Button Content="Models…" Click="OnOpenModelPicker" IsEnabled="{x:Bind ViewModel.CanConfigurePi, Mode=OneWay}" Style="{StaticResource PiToolbarButtonStyle}" />
                        <ComboBox x:Name="PiPermissionSelector" DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.PiConfiguration.RuntimeModes}" SelectedItem="{x:Bind ViewModel.PiConfiguration.SelectedRuntimeMode, Mode=OneWay}"
                            SelectionChanged="OnPiPermissionModeChanged" IsEnabled="{x:Bind ViewModel.CanConfigurePi, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.PiConfiguration.RuntimeModeVisibility, Mode=OneWay}"
                            Style="{StaticResource PiComposerComboBoxStyle}" automation:AutomationProperties.Name="Pi tool permission mode"
                            ToolTipService.ToolTip="Controls Pi tool approvals, including bundled child agents. Trusted extensions run in the Pi process; this is not an operating-system sandbox." />
                    </StackPanel>

                    <Button Content="Pi shell" Click="OnPiShellClicked"
                        automation:AutomationProperties.AutomationId="PiShellButton"
                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                        Style="{StaticResource PiToolbarButtonStyle}" />
                    <Button
                        automation:AutomationProperties.AutomationId="CompactContextButton"
                        automation:AutomationProperties.Name="Compact Pi context"
                        Click="OnCompactContextClicked"
                        Content="Compact"
                        IsEnabled="{x:Bind ViewModel.CanCompactContext, Mode=OneWay}"
                        Style="{StaticResource PiToolbarButtonStyle}" />
                    <Button
                        x:Name="FollowUpButton"
                        automation:AutomationProperties.AutomationId="FollowUpButton"
                        automation:AutomationProperties.Name="Queue follow-up message"
                        Click="OnFollowUpClicked"
                        Content="Follow up"
                        IsEnabled="{x:Bind ViewModel.CanQueueFollowUp, Mode=OneWay}"
                        Style="{StaticResource PiToolbarButtonStyle}"
                        ToolTipService.ToolTip="Queue after the current response (Ctrl+Enter)"
                        Visibility="{x:Bind ViewModel.FollowUpButtonVisibility, Mode=OneWay}" />
                    <Button Content="{x:Bind ViewModel.BackgroundTaskActionLabel, Mode=OneWay}"
                        Click="OnNewBackgroundTaskClicked" IsEnabled="{x:Bind ViewModel.CanStartBackgroundTask, Mode=OneWay}"
                        automation:AutomationProperties.AutomationId="NewBackgroundTaskButton"
                        ToolTipService.ToolTip="Start an independent task using this thread's Pi and workspace defaults; keep a fresh draft here (Ctrl+Shift+Enter)"
                        Style="{StaticResource PiToolbarButtonStyle}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="ComposerStatusRegion"
                        Grid.Column="0"
                        Margin="4,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PiConfigurationStatusText"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.AutomationId="PiConfigurationStatusText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            FontSize="{StaticResource PiFontSizeCaption}"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Text="{x:Bind ViewModel.PiConfiguration.Status, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind ViewModel.Workspace.PiConfigurationVisibility, Mode=OneWay}" />
                        <TextBlock
                            x:Name="DraftStatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.AutomationId="DraftStatusText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            FontSize="{StaticResource PiFontSizeCaption}"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Text="{x:Bind ViewModel.Composer.Status, Mode=OneWay}" />
                    </Grid>

                    <Button
                        x:Name="StopTurnButton"
                        Grid.Column="1"
                        automation:AutomationProperties.AutomationId="StopTurnButton"
                        automation:AutomationProperties.Name="Stop current turn"
                        Click="OnStopTurnClicked"
                        IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"
                        Style="{StaticResource PiToolbarButtonStyle}"
                        ToolTipService.ToolTip="Stop current turn">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="11" Glyph="&#xE71A;" />
                            <TextBlock VerticalAlignment="Center" Text="Stop" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="SendPromptButton"
                        Grid.Column="2"
                        automation:AutomationProperties.AutomationId="SendPromptButton"
                        automation:AutomationProperties.Name="{x:Bind ViewModel.PrimarySendLabel, Mode=OneWay}"
                        Click="OnSendPromptClicked"
                        IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
                        Style="{StaticResource PiCircularPrimaryButtonStyle}"
                        ToolTipService.ToolTip="Send now; Ctrl+Shift+Enter submits in background">
                        <FontIcon FontSize="14" Glyph="&#xE724;" />
                    </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Row="6"
                Margin="0,8,0,0"
                Padding="8"
                automation:AutomationProperties.AutomationId="TurnQueueInspector"
                automation:AutomationProperties.Name="Active turn message queue"
                Style="{StaticResource PiElevatedSurfaceStyle}"
                Visibility="{x:Bind ViewModel.Thread.Queue.InspectorVisibility, Mode=OneWay}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Turn queue" />
                            <TextBlock
                                x:Name="TurnQueueSummaryText"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.AutomationId="TurnQueueSummaryText"
                                automation:AutomationProperties.LiveSetting="Polite"
                                FontSize="{StaticResource PiFontSizeCaption}"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="{x:Bind ViewModel.Thread.Queue.Summary, Mode=OneWay}" />
                            <TextBlock
                                x:Name="TurnQueueDeliveryStateText"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.AutomationId="TurnQueueDeliveryStateText"
                                automation:AutomationProperties.LiveSetting="Polite"
                                FontSize="{StaticResource PiFontSizeCaption}"
                                Foreground="{ThemeResource PiAccentBrush}"
                                Text="{x:Bind ViewModel.Thread.Queue.DeliveryStateLabel, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            automation:AutomationProperties.AutomationId="RefreshTurnQueueButton"
                            automation:AutomationProperties.Name="Refresh turn queue"
                            Click="OnRefreshTurnQueueClicked"
                            IsEnabled="{x:Bind ViewModel.CanManageQueue, Mode=OneWay}"
                            Style="{StaticResource PiToolbarIconButtonStyle}"
                            ToolTipService.ToolTip="Refresh queue">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            automation:AutomationProperties.AutomationId="ClearTurnQueueButton"
                            automation:AutomationProperties.Name="Clear queued messages"
                            Click="OnClearTurnQueueClicked"
                            Content="Clear"
                            IsEnabled="{x:Bind ViewModel.CanClearQueue, Mode=OneWay}"
                            Style="{StaticResource PiToolbarButtonStyle}" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        MaxHeight="120"
                        automation:AutomationProperties.AutomationId="TurnQueueMessageList"
                        automation:AutomationProperties.Name="Queued steering and follow-up messages"
                        ItemsSource="{x:Bind ViewModel.Thread.Queue.Messages, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.Thread.Queue.MessagesVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:QueuedMessageViewModel">
                                <Grid Padding="2" ColumnSpacing="8" automation:AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind KindLabel}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Text}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Text}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource PiFontSizeCaption}"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Text="Delivery" />
                        <Button
                            automation:AutomationProperties.AutomationId="ToggleSteeringDeliveryModeButton"
                            automation:AutomationProperties.Name="Toggle steering delivery mode"
                            Click="OnToggleSteeringDeliveryModeClicked"
                            Content="{x:Bind ViewModel.Thread.Queue.SteeringModeLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanManageQueue, Mode=OneWay}"
                            Style="{StaticResource PiToolbarButtonStyle}" />
                        <Button
                            automation:AutomationProperties.AutomationId="ToggleFollowUpDeliveryModeButton"
                            automation:AutomationProperties.Name="Toggle follow-up delivery mode"
                            Click="OnToggleFollowUpDeliveryModeClicked"
                            Content="{x:Bind ViewModel.Thread.Queue.FollowUpModeLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanManageQueue, Mode=OneWay}"
                            Style="{StaticResource PiToolbarButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="5" Spacing="6" Margin="8"
                Visibility="{x:Bind ViewModel.Composer.RecoveryConflictVisibility, Mode=OneWay}">
                <TextBlock Text="This device has recovered text that differs from the host draft."
                    TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite" />
                <TextBox Header="Recovered text on this device" Text="{x:Bind ViewModel.Composer.RecoveredText, Mode=OneWay}"
                    IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                    automation:AutomationProperties.AutomationId="RecoveredDraftPreview" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Use recovered text" Click="OnRestoreRecoveredDraft"
                        automation:AutomationProperties.AutomationId="RestoreRecoveredDraft" />
                    <Button Content="Keep host draft" Click="OnKeepHostDraft"
                        automation:AutomationProperties.AutomationId="KeepHostDraft" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
