<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.ComposerSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:models="using:PiStation.Protocol.Models"
    xmlns:viewModels="using:PiStation.App.ViewModels">

    <Border
        x:Name="ComposerRoot"
        MinHeight="{StaticResource PiComposerMinHeight}"
        AllowDrop="True"
        automation:AutomationProperties.AutomationId="ComposerSurface"
        automation:AutomationProperties.Name="Message composer"
        DragOver="OnComposerDragOver"
        Drop="OnComposerDrop"
        Style="{StaticResource PiComposerSurfaceStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ComposerResponsiveStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PiConfigurationPanel.Spacing" Value="4" />
                        <Setter Target="PiModelSelector.MinWidth" Value="96" />
                        <Setter Target="PiThinkingLevelSelector.MinWidth" Value="84" />
                        <Setter Target="ComposerStatusRegion.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PiConfigurationPanel.Spacing" Value="4" />
                        <Setter Target="PiModelSelector.MinWidth" Value="108" />
                        <Setter Target="PiThinkingLevelSelector.MinWidth" Value="92" />
                        <Setter Target="ComposerStatusRegion.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StandardLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PiConfigurationPanel.Spacing" Value="6" />
                        <Setter Target="PiModelSelector.MinWidth" Value="128" />
                        <Setter Target="PiThinkingLevelSelector.MinWidth" Value="108" />
                        <Setter Target="ComposerStatusRegion.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PiConfigurationPanel.Spacing" Value="6" />
                        <Setter Target="PiModelSelector.MinWidth" Value="128" />
                        <Setter Target="PiThinkingLevelSelector.MinWidth" Value="108" />
                        <Setter Target="ComposerStatusRegion.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="FileMentionSuggestionsPanel"
                MaxHeight="240"
                Margin="0,0,0,8"
                Padding="8"
                automation:AutomationProperties.AutomationId="FileMentionSuggestionsPanel"
                automation:AutomationProperties.Name="Project file suggestions"
                Style="{StaticResource PiElevatedSurfaceStyle}"
                Visibility="{x:Bind ViewModel.FileMentions.SuggestionsVisibility, Mode=OneWay}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Project files" />
                        <TextBlock
                            x:Name="FileMentionStatusText"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            automation:AutomationProperties.AutomationId="FileMentionStatusText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource PiTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.FileMentions.Status, Mode=OneWay}" />
                    </Grid>
                    <ListView
                        x:Name="FileMentionSuggestionsList"
                        Grid.Row="1"
                        MaxHeight="180"
                        automation:AutomationProperties.AutomationId="FileMentionSuggestionsList"
                        automation:AutomationProperties.Name="Matching project files"
                        IsItemClickEnabled="True"
                        ItemClick="OnFileMentionSuggestionClicked"
                        ItemsSource="{x:Bind ViewModel.FileMentions.Suggestions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.FileMentions.SelectedIndex, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectFileMatch">
                                <Button
                                    Padding="6,4"
                                    automation:AutomationProperties.AutomationId="FileMentionSuggestionButton"
                                    automation:AutomationProperties.Name="{x:Bind RelativePath}"
                                    Click="OnFileMentionSuggestionInvoked"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource PiToolbarButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource PiTextSecondaryBrush}"
                                            Text="{x:Bind RelativePath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ListView
                x:Name="DraftAttachmentList"
                Grid.Row="1"
                Height="{x:Bind ViewModel.Composer.AttachmentRailHeight, Mode=OneWay}"
                MaxHeight="42"
                Margin="0,0,0,6"
                automation:AutomationProperties.AutomationId="DraftAttachmentList"
                automation:AutomationProperties.Name="Draft attachments"
                ItemsSource="{x:Bind ViewModel.Composer.Attachments, Mode=OneWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DraftAttachmentViewModel">
                        <Border
                            MaxWidth="300"
                            Margin="0,0,6,0"
                            Style="{StaticResource PiAttachmentChipStyle}">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind FileName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                    Text="{x:Bind Detail}" />
                                <Button
                                    Grid.Column="2"
                                    automation:AutomationProperties.AutomationId="RemoveAttachmentButton"
                                    automation:AutomationProperties.Name="Remove attachment"
                                    Click="OnRemoveAttachmentClicked"
                                    Style="{StaticResource PiToolbarIconButtonStyle}"
                                    ToolTipService.ToolTip="Remove attachment">
                                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBox
                x:Name="PromptInput"
                Grid.Row="2"
                Height="48"
                MinHeight="48"
                MaxHeight="144"
                automation:AutomationProperties.AutomationId="PromptInput"
                automation:AutomationProperties.Name="Prompt for Pi"
                AcceptsReturn="True"
                PlaceholderText="Ask Pi anything…"
                PreviewKeyDown="OnPromptInputPreviewKeyDown"
                PreviewKeyUp="OnPromptInputPreviewKeyUp"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionChanged="OnPromptInputChanged"
                SizeChanged="OnPromptInputSizeChanged"
                Style="{StaticResource PiComposerTextBoxStyle}"
                Text="{x:Bind ViewModel.PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="OnPromptInputChanged"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="AttachmentNoticeText"
                Grid.Row="3"
                Height="{x:Bind ViewModel.Composer.AttachmentNoticeHeight, Mode=OneWay}"
                Margin="4,2,4,0"
                automation:AutomationProperties.AutomationId="AttachmentNoticeText"
                FontSize="{StaticResource PiFontSizeCaption}"
                Foreground="{ThemeResource PiTextMutedBrush}"
                Text="{x:Bind ViewModel.Composer.AttachmentNotice, Mode=OneWay}"
                TextWrapping="Wrap" />

            <Border Grid.Row="4" Style="{StaticResource PiComposerToolbarStyle}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="AttachFilesButton"
                        automation:AutomationProperties.AutomationId="AttachFilesButton"
                        automation:AutomationProperties.Name="Attach files to draft"
                        Click="OnAttachFilesClicked"
                        IsEnabled="{x:Bind ViewModel.CanAttachFiles, Mode=OneWay}"
                        Style="{StaticResource PiToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="Attach files">
                        <FontIcon FontSize="14" Glyph="&#xE723;" />
                    </Button>

                    <StackPanel
                        x:Name="PiConfigurationPanel"
                        Grid.Column="1"
                        automation:AutomationProperties.AutomationId="PiConfigurationPanel"
                        automation:AutomationProperties.Name="Pi configuration"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.Workspace.PiConfigurationVisibility, Mode=OneWay}">
                        <ComboBox
                            x:Name="PiModelSelector"
                            MinWidth="128"
                            automation:AutomationProperties.AutomationId="PiModelSelector"
                            automation:AutomationProperties.Name="Pi model"
                            DisplayMemberPath="DisplayName"
                            IsEnabled="{x:Bind ViewModel.CanConfigurePi, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.PiConfiguration.Models}"
                            SelectedItem="{x:Bind ViewModel.PiConfiguration.SelectedModel, Mode=OneWay}"
                            SelectionChanged="OnPiModelSelectionChanged"
                            Style="{StaticResource PiComposerComboBoxStyle}"
                            ToolTipService.ToolTip="Model"
                            Visibility="{x:Bind ViewModel.PiConfiguration.ModelSelectorVisibility, Mode=OneWay}" />
                        <ComboBox
                            x:Name="PiThinkingLevelSelector"
                            MinWidth="108"
                            automation:AutomationProperties.AutomationId="PiThinkingLevelSelector"
                            automation:AutomationProperties.Name="Reasoning level"
                            DisplayMemberPath="DisplayName"
                            IsEnabled="{x:Bind ViewModel.CanConfigurePi, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.PiConfiguration.ThinkingLevels}"
                            SelectedItem="{x:Bind ViewModel.PiConfiguration.SelectedThinkingLevel, Mode=OneWay}"
                            SelectionChanged="OnPiThinkingLevelSelectionChanged"
                            Style="{StaticResource PiComposerComboBoxStyle}"
                            ToolTipService.ToolTip="Reasoning"
                            Visibility="{x:Bind ViewModel.PiConfiguration.ThinkingLevelSelectorVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <Grid
                        x:Name="ComposerStatusRegion"
                        Grid.Column="2"
                        Margin="4,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PiConfigurationStatusText"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.AutomationId="PiConfigurationStatusText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            FontSize="{StaticResource PiFontSizeCaption}"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Text="{x:Bind ViewModel.PiConfiguration.Status, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind ViewModel.Workspace.PiConfigurationVisibility, Mode=OneWay}" />
                        <TextBlock
                            x:Name="DraftStatusText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.AutomationId="DraftStatusText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            FontSize="{StaticResource PiFontSizeCaption}"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Text="{x:Bind ViewModel.Composer.Status, Mode=OneWay}" />
                    </Grid>

                    <Button
                        x:Name="StopTurnButton"
                        Grid.Column="3"
                        automation:AutomationProperties.AutomationId="StopTurnButton"
                        automation:AutomationProperties.Name="Stop current turn"
                        Click="OnStopTurnClicked"
                        IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"
                        Style="{StaticResource PiToolbarButtonStyle}"
                        ToolTipService.ToolTip="Stop current turn">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="11" Glyph="&#xE71A;" />
                            <TextBlock VerticalAlignment="Center" Text="Stop" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="SendPromptButton"
                        Grid.Column="4"
                        automation:AutomationProperties.AutomationId="SendPromptButton"
                        automation:AutomationProperties.Name="Send prompt"
                        Click="OnSendPromptClicked"
                        IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
                        Style="{StaticResource PiCircularPrimaryButtonStyle}"
                        ToolTipService.ToolTip="Send prompt">
                        <FontIcon FontSize="14" Glyph="&#xE724;" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
