<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PiStation.App.Views.Controls.RemoteConnectionsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PiStation.App.Views.Controls"
    xmlns:composition="using:PiStation.App.Composition"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <Border Style="{StaticResource PiElevatedSurfaceStyle}">
        <StackPanel Spacing="10" automation:AutomationProperties.AutomationId="RemoteConnectionsPanel"
            automation:AutomationProperties.Name="Remote connections">
            <TextBlock Text="Connections" Style="{StaticResource PiPanelHeaderTextStyle}" />
            <Expander Header="Tailscale" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                    <TextBlock Text="Use an existing Tailscale connection on both Windows computers. Start PiStation sharing on the host's Tailscale adapter, then pair using its link."
                        TextWrapping="Wrap" />
                    <Button Content="Refresh Tailscale" Click="OnRefreshTailscale" automation:AutomationProperties.AutomationId="RefreshTailscaleButton" />
                    <TextBlock x:Name="TailscaleStatus" Text="Refresh to discover the local adapter and Windows computers." TextWrapping="Wrap"
                        automation:AutomationProperties.AutomationId="TailscaleStatus" automation:AutomationProperties.LiveSetting="Polite" />
                    <CheckBox x:Name="TailscaleMagicDns" Content="Use MagicDNS names (turn off to use Tailscale IP addresses)" IsChecked="True" />
                    <Button x:Name="UseTailscaleAdapter" Content="Use this computer's Tailscale adapter for sharing" IsEnabled="False" Click="OnUseTailscaleAdapter"
                        automation:AutomationProperties.AutomationId="UseTailscaleAdapterButton" />
                    <ComboBox x:Name="TailscalePeers" Header="Windows computers" DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                        automation:AutomationProperties.AutomationId="TailscalePeers" />
                    <NumberBox x:Name="TailscalePort" Header="PiStation sharing port on the other computer" Value="52740" Minimum="1024" Maximum="65535" />
                    <Button Content="Use selected computer's address" Click="OnUseTailscalePeer" automation:AutomationProperties.AutomationId="UseTailscalePeerButton" />
                    <TextBlock Text="The address updates the pairing link below, or the selected saved environment's address. Pairing and Verify and save still check the host identity."
                        TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                </StackPanel>
            </Expander>
            <StackPanel x:Name="HostControls" Spacing="8">
                <ToggleSwitch x:Name="AllowRemoteUpdates" Header="Allow approved operate devices to request host updates"
                    Toggled="OnAllowRemoteUpdatesChanged" />
                <TextBlock Text="Share this computer" FontWeight="SemiBold" />
                <TextBlock Text="Allow approved devices on your LAN or VPN to use this environment. Keep this window open while sharing."
                    TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                <ComboBox x:Name="ListenAddress" Header="Network address · choose your LAN or VPN adapter" DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                    automation:AutomationProperties.AutomationId="RemoteListenAddress" />
                <NumberBox x:Name="ListenPort" Header="Port" Value="52740" Minimum="1024" Maximum="65535"
                    automation:AutomationProperties.AutomationId="RemoteListenPort" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="StartSharing" Content="Start sharing" Click="OnStartSharing" Style="{StaticResource PiSecondaryButtonStyle}"
                        automation:AutomationProperties.AutomationId="StartRemoteSharingButton" />
                    <Button x:Name="StopSharing" Content="Stop sharing" Click="OnStopSharing" Style="{StaticResource PiSecondaryButtonStyle}"
                        automation:AutomationProperties.AutomationId="StopRemoteSharingButton" />
                </StackPanel>
                <TextBlock x:Name="SharingState" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                    automation:AutomationProperties.AutomationId="RemoteSharingState" />
                <ComboBox x:Name="PairingAccess" Header="New device access" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Operate — chat, files, Git, and terminals" />
                    <ComboBoxItem Content="Read only — view projects and conversations" />
                </ComboBox>
                <TextBox x:Name="PairingLabel" Header="Pairing label (optional)" MaxLength="80" PlaceholderText="For example, travel laptop"
                    automation:AutomationProperties.AutomationId="RemotePairingLabel" />
                <NumberBox x:Name="PairingLifetime" Header="Link lifetime in minutes · 1 to 1440 (one day)"
                    Value="5" Minimum="1" Maximum="1440" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                    automation:AutomationProperties.AutomationId="RemotePairingLifetime" />
                <TextBlock Text="The lifetime limits when the link can be used, not how long the device stays approved. Device approvals last 180 days."
                    TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                <Button x:Name="CreatePairingLink" Content="Create pairing link" Click="OnCreatePairingLink"
                    Style="{StaticResource PiSecondaryButtonStyle}" automation:AutomationProperties.AutomationId="CreatePairingLinkButton" />
                <TextBlock Text="Unused pairing links" FontWeight="SemiBold" />
                <ListView x:Name="PairingInvitations" MaxHeight="200" SelectionMode="Single"
                    SelectionChanged="OnInvitationSelectionChanged" automation:AutomationProperties.AutomationId="RemotePairingInvitations"
                    automation:AutomationProperties.Name="Unused pairing links">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="composition:RemoteInvitationRow">
                            <StackPanel Spacing="2" Padding="0,4">
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="InvitationsEmpty" Text="No unused pairing links." TextWrapping="Wrap"
                    Foreground="{ThemeResource PiTextSecondaryBrush}" />
                <TextBlock x:Name="InvitationDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                    automation:AutomationProperties.AutomationId="RemoteInvitationDetails" />
                <Button x:Name="RevokeInvitation" Content="Revoke selected link" IsEnabled="False" Click="OnRevokeInvitation"
                    Style="{StaticResource PiSecondaryButtonStyle}" automation:AutomationProperties.AutomationId="RevokeRemotePairingLinkButton" />
                <TextBlock x:Name="PairingShareHint" TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}"
                    automation:AutomationProperties.AutomationId="RemotePairingShareHint" />
                <TextBox x:Name="PairingLink" Header="Selected one-time link · keep secret" IsReadOnly="True" TextWrapping="Wrap"
                    automation:AutomationProperties.AutomationId="RemotePairingLink" />
                <Button x:Name="CopyPairingLink" Content="Copy pairing link" IsEnabled="False" Click="OnCopyPairingLink"
                    automation:AutomationProperties.AutomationId="CopyRemotePairingLinkButton" Style="{StaticResource PiSecondaryButtonStyle}" />
                <Border x:Name="PairingQrContainer" Visibility="Collapsed" Background="White" Padding="8" HorizontalAlignment="Left" MaxWidth="280">
                    <Image x:Name="PairingQr" Stretch="Uniform" MaxWidth="264" MaxHeight="264"
                        automation:AutomationProperties.AutomationId="RemotePairingQr"
                        automation:AutomationProperties.Name="QR code for the selected secret pairing link" />
                </Border>
                <TextBlock Text="Awaiting approval" FontWeight="SemiBold" />
                <ListView x:Name="PendingDevices" DisplayMemberPath="DeviceName" MaxHeight="140" SelectionMode="Single"
                    SelectionChanged="OnPendingSelectionChanged" automation:AutomationProperties.AutomationId="PendingRemoteDevices" />
                <TextBlock x:Name="PendingDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                    automation:AutomationProperties.AutomationId="RemotePendingVerificationCode" />
                <CheckBox x:Name="VerificationConfirmed" Content="The code matches the other device"
                    Checked="OnVerificationChanged" Unchecked="OnVerificationChanged" IsEnabled="False"
                    automation:AutomationProperties.AutomationId="RemoteVerificationConfirmed" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ApproveDevice" Content="Approve device" IsEnabled="False" Click="OnApproveDevice" Style="{StaticResource PiSecondaryButtonStyle}"
                        automation:AutomationProperties.AutomationId="ApproveRemoteDeviceButton" />
                    <Button x:Name="RejectDevice" Content="Reject" IsEnabled="False" Click="OnRejectDevice" Style="{StaticResource PiSecondaryButtonStyle}" />
                </StackPanel>
                <TextBlock Text="Device sessions" FontWeight="SemiBold" />
                <TextBlock Text="Includes approved devices and CLI-issued sessions. Revoking a link does not revoke an existing session."
                    TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                <ListView x:Name="ApprovedDevices" MaxHeight="200" SelectionMode="Single"
                    SelectionChanged="OnApprovedSelectionChanged" automation:AutomationProperties.AutomationId="ApprovedRemoteDevices"
                    automation:AutomationProperties.Name="Device sessions">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="composition:RemoteSessionRow">
                            <StackPanel Spacing="2" Padding="0,4">
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="SessionsEmpty" Text="No active device sessions." TextWrapping="Wrap"
                    Foreground="{ThemeResource PiTextSecondaryBrush}" />
                <TextBlock x:Name="ApprovedDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                    automation:AutomationProperties.AutomationId="RemoteSessionDetails" />
                <Button x:Name="RevokeDevice" Content="Revoke selected session" IsEnabled="False" Click="OnRevokeDevice" Style="{StaticResource PiSecondaryButtonStyle}"
                    automation:AutomationProperties.AutomationId="RevokeRemoteDeviceButton" />
            </StackPanel>
            <TextBlock Text="Connect to another computer" FontWeight="SemiBold" />
            <TextBox x:Name="IncomingLink" Header="Pairing link from the host" TextWrapping="Wrap"
                automation:AutomationProperties.AutomationId="RemoteIncomingLink" />
            <TextBox x:Name="DeviceName" Header="Name for this device" MaxLength="80"
                automation:AutomationProperties.AutomationId="RemoteDeviceName" />
            <TextBlock x:Name="PairingProgress" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                automation:AutomationProperties.AutomationId="RemoteClientVerificationCode"
                automation:AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PairDevice" Content="Pair device" Click="OnPairDevice" Style="{StaticResource PiSecondaryButtonStyle}"
                    automation:AutomationProperties.AutomationId="PairRemoteDeviceButton" />
                <Button x:Name="CancelPairing" Content="Cancel" Click="OnCancelPairing" IsEnabled="False"
                    Style="{StaticResource PiSecondaryButtonStyle}" />
            </StackPanel>
            <TextBlock Text="Saved environments" FontWeight="SemiBold" />
            <TextBlock Text="If access expires or is revoked, pair again with a fresh host link, then select Open. You do not need to forget the saved environment."
                TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
            <ListView x:Name="SavedEnvironments" DisplayMemberPath="Name" MaxHeight="180" SelectionMode="Single"
                SelectionChanged="OnSavedSelectionChanged" automation:AutomationProperties.AutomationId="SavedRemoteEnvironments" />
            <TextBlock x:Name="SavedDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBox x:Name="EndpointAddress" Header="Host address" PlaceholderText="https://host:52740/"
                automation:AutomationProperties.AutomationId="RemoteEndpointAddress" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Test connection" Click="OnTestEndpoint" Style="{StaticResource PiSecondaryButtonStyle}" />
                <Button Content="Verify and save address" Click="OnSaveEndpoint" Style="{StaticResource PiSecondaryButtonStyle}" />
                <Button Content="Cancel" Click="OnCancelPairing" Style="{StaticResource PiSecondaryButtonStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open" Click="OnOpenEnvironment" Style="{StaticResource PiSecondaryButtonStyle}"
                    automation:AutomationProperties.AutomationId="OpenRemoteEnvironmentButton" />
                <Button Content="Disconnect" Click="OnDisconnectEnvironment" Style="{StaticResource PiSecondaryButtonStyle}" />
                <Button Content="Copy diagnostics" Click="OnCopyDiagnostics" Style="{StaticResource PiSecondaryButtonStyle}" />
                <Button Content="Forget" Click="OnForgetEnvironment" Style="{StaticResource PiSecondaryButtonStyle}" />
            </StackPanel>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}"
                automation:AutomationProperties.AutomationId="RemoteConnectionStatus" automation:AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Install host update" Click="OnInstallHostUpdate" Style="{StaticResource PiSecondaryButtonStyle}" />
                <Button Content="Check update status" Click="OnCheckHostUpdate" Style="{StaticResource PiSecondaryButtonStyle}" />
            </StackPanel>
            <controls:SshConnectionsPanel x:Name="SshConnections" />
        </StackPanel>
    </Border>
</UserControl>
