<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.FilePreviewWebViewSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    automation:AutomationProperties.Name="Rendered file preview">
    <Grid Background="{ThemeResource PiCanvasBrush}">
        <WebView2 x:Name="Browser" />
        <ProgressRing
            x:Name="LoadingIndicator"
            Width="20"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True" />
    </Grid>
</UserControl>
