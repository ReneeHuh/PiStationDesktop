<UserControl
    x:Class="PiStation.App.Views.Controls.BrowserSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <StackPanel Spacing="8">
        <TextBlock Text="Browser" FontWeight="SemiBold" />
        <TextBlock Text="These preferences apply to all environment windows on this computer. Defaults apply to new tabs." TextWrapping="Wrap" />
        <ComboBox Header="Open links in" HorizontalAlignment="Stretch"
            SelectedIndex="{x:Bind ViewModel.Layout.BrowserLinkTargetIndex, Mode=TwoWay}"
            automation:AutomationProperties.AutomationId="BrowserLinkTargetSetting">
            <ComboBoxItem Content="System browser" /><ComboBoxItem Content="App preview" />
        </ComboBox>
        <TextBlock Text="Ctrl-click a chat link to use your system browser. Terminal links follow this preference." TextWrapping="Wrap" />
        <ComboBox Header="Default viewport" HorizontalAlignment="Stretch"
            SelectedIndex="{x:Bind ViewModel.Layout.BrowserDefaultViewportIndex, Mode=TwoWay}"
            automation:AutomationProperties.AutomationId="BrowserDefaultViewportSetting">
            <ComboBoxItem Content="Fill available space" /><ComboBoxItem Content="Desktop (1440 × 900)" />
            <ComboBoxItem Content="Tablet (768 × 1024)" /><ComboBoxItem Content="Phone (390 × 844)" />
        </ComboBox>
        <NumberBox Header="Default zoom (%)" Minimum="25" Maximum="300" SmallChange="10"
            Value="{x:Bind ViewModel.Layout.BrowserDefaultZoomPercent, Mode=TwoWay}"
            automation:AutomationProperties.AutomationId="BrowserDefaultZoomSetting" />
        <ComboBox Header="Default appearance" HorizontalAlignment="Stretch"
            SelectedIndex="{x:Bind ViewModel.Layout.BrowserDefaultAppearanceIndex, Mode=TwoWay}"
            automation:AutomationProperties.AutomationId="BrowserDefaultAppearanceSetting">
            <ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
        </ComboBox>
        <ComboBox x:Name="DefaultProfileSelector" Header="Default browser profile" DisplayMemberPath="Name"
            HorizontalAlignment="Stretch" SelectionChanged="OnDefaultProfileChanged"
            automation:AutomationProperties.AutomationId="BrowserDefaultProfileSetting" />
        <ComboBox Header="Recording frame rate" HorizontalAlignment="Stretch"
            SelectedIndex="{x:Bind ViewModel.Layout.BrowserRecordingFrameRateIndex, Mode=TwoWay}"
            automation:AutomationProperties.AutomationId="BrowserRecordingFrameRateSetting">
            <ComboBoxItem Content="30 FPS" /><ComboBoxItem Content="60 FPS" />
        </ComboBox>
        <TextBlock Text="Recordings use up to 1280 pixels per edge, two minutes and 64 MiB. Actual frame rate depends on page rendering and encoder performance." TextWrapping="Wrap" />
        <TextBlock Text="Profiles keep separate cookies and logins for each environment. Choose Incognito on a new tab for a private session; those tabs are not restored." TextWrapping="Wrap" />
        <ContentControl x:Name="ProfileEditor" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="8">
            <ComboBox x:Name="ProfileSelector" Header="Manage profiles" DisplayMemberPath="Name"
                HorizontalAlignment="Stretch" SelectionChanged="OnProfileChanged"
                automation:AutomationProperties.AutomationId="BrowserManageProfileSelector" />
            <TextBox x:Name="ProfileName" Header="Profile name" MaxLength="48"
                automation:AutomationProperties.AutomationId="BrowserProfileNameInput" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Create" Click="OnCreate" automation:AutomationProperties.AutomationId="BrowserCreateProfileButton" />
                <Button x:Name="RenameButton" Content="Rename" Click="OnRename" automation:AutomationProperties.AutomationId="BrowserRenameProfileButton" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Clear data" Click="OnClear" automation:AutomationProperties.AutomationId="BrowserClearProfileButton" />
                <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove" automation:AutomationProperties.AutomationId="BrowserRemoveProfileButton" />
            </StackPanel>
        </StackPanel>
        </ContentControl>
        <ContentControl x:Name="ImportEditor" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="8">
            <TextBlock Text="Import cookies from an installed browser" FontWeight="SemiBold" />
            <TextBlock Text="Copy cookies and sign-ins from a selected local Firefox or compatible Helium profile into a new profile for this environment. Source data stays unchanged. Unsupported encrypted, partitioned or container cookies are skipped. Chrome and Edge import is unavailable." TextWrapping="Wrap" />
            <Button Content="Find local browser profiles" Click="OnFindImportSources" automation:AutomationProperties.AutomationId="BrowserFindImportSources" />
            <ComboBox x:Name="ImportSourceSelector" Header="Source profile" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" automation:AutomationProperties.AutomationId="BrowserImportSource" />
            <TextBox x:Name="ImportName" Header="New PiStation profile name" MaxLength="48" Text="Imported browser" />
            <Button Content="Copy cookies into new profile" Click="OnImportCookies" automation:AutomationProperties.AutomationId="BrowserImportCookies" />
        </StackPanel>
        </ContentControl>
        <StackPanel x:Name="Confirmation" Spacing="6" Visibility="Collapsed">
            <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="ConfirmButton" Content="Confirm" Click="OnConfirm" automation:AutomationProperties.AutomationId="BrowserConfirmProfileAction" />
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="Status" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"
            automation:AutomationProperties.AutomationId="BrowserProfileStatus" />
        <ContentControl x:Name="ClearBrowserHost" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" IsTabStop="False" />
    </StackPanel>
</UserControl>
