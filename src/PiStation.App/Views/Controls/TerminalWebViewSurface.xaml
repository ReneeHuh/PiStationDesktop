<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.TerminalWebViewSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    automation:AutomationProperties.Name="Terminal output"
    IsTabStop="True">
    <Grid>
        <WebView2
            x:Name="Browser"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
        <Border
            x:Name="LoadingOverlay"
            Background="{ThemeResource PiCanvasBrush}"
            IsHitTestVisible="False">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <ProgressRing
                    x:Name="LoadingProgress"
                    Width="20"
                    Height="20"
                    IsActive="True" />
                <TextBlock
                    x:Name="LoadingMessage"
                    FontSize="{StaticResource PiFontSizeCaption}"
                    Foreground="{ThemeResource PiTextMutedBrush}"
                    Text="Loading terminal renderer…" />
            </StackPanel>
        </Border>
        <Border
            x:Name="SearchOverlay"
            Width="372"
            Margin="8"
            Padding="6"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            automation:AutomationProperties.AutomationId="TerminalSearchOverlay"
            automation:AutomationProperties.Name="Find in terminal"
            Background="{ThemeResource PiSurfaceElevatedBrush}"
            BorderBrush="{ThemeResource PiBorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PiRadiusControl}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchTextBox"
                    MinWidth="118"
                    automation:AutomationProperties.AutomationId="TerminalSearchTextBox"
                    automation:AutomationProperties.Name="Find text"
                    KeyDown="OnSearchKeyDown"
                    PlaceholderText="Find"
                    Style="{StaticResource PiTextBoxStyle}"
                    TextChanged="OnSearchTextChanged" />
                <TextBlock
                    x:Name="SearchCountText"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    automation:AutomationProperties.AutomationId="TerminalSearchCountText"
                    automation:AutomationProperties.LiveSetting="Polite"
                    FontSize="{StaticResource PiFontSizeCaption}"
                    Foreground="{ThemeResource PiTextMutedBrush}"
                    Text="0 of 0" />
                <ToggleButton
                    x:Name="SearchMatchCaseToggle"
                    Grid.Column="2"
                    automation:AutomationProperties.AutomationId="TerminalSearchMatchCaseToggle"
                    automation:AutomationProperties.Name="Match case"
                    Click="OnSearchOptionClicked"
                    Content="Aa"
                    Style="{StaticResource PiIconToggleButtonStyle}"
                    ToolTipService.ToolTip="Match case" />
                <ToggleButton
                    x:Name="SearchWholeWordToggle"
                    Grid.Column="3"
                    automation:AutomationProperties.AutomationId="TerminalSearchWholeWordToggle"
                    automation:AutomationProperties.Name="Match whole word"
                    Click="OnSearchOptionClicked"
                    Content="ab"
                    Style="{StaticResource PiIconToggleButtonStyle}"
                    ToolTipService.ToolTip="Match whole word" />
                <Button
                    x:Name="SearchPreviousButton"
                    Grid.Column="4"
                    automation:AutomationProperties.AutomationId="TerminalSearchPreviousButton"
                    automation:AutomationProperties.Name="Previous match"
                    Click="OnSearchPreviousClicked"
                    IsEnabled="False"
                    Style="{StaticResource PiToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="Previous match (Shift+Enter)">
                    <FontIcon FontSize="11" Glyph="&#xE70E;" />
                </Button>
                <Button
                    x:Name="SearchNextButton"
                    Grid.Column="5"
                    automation:AutomationProperties.AutomationId="TerminalSearchNextButton"
                    automation:AutomationProperties.Name="Next match"
                    Click="OnSearchNextClicked"
                    IsEnabled="False"
                    Style="{StaticResource PiToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="Next match (Enter)">
                    <FontIcon FontSize="11" Glyph="&#xE70D;" />
                </Button>
                <Button
                    x:Name="CloseSearchButton"
                    Grid.Column="6"
                    automation:AutomationProperties.AutomationId="TerminalSearchCloseButton"
                    automation:AutomationProperties.Name="Close terminal search"
                    Click="OnCloseSearchClicked"
                    Style="{StaticResource PiToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="Close (Escape)">
                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
