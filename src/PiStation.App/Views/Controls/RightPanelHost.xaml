<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PiStation.App.Views.Controls.RightPanelHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:local="using:PiStation.App.Views.Controls"
    xmlns:models="using:PiStation.Protocol.Models"
    xmlns:viewModels="using:PiStation.App.ViewModels"
    xmlns:views="using:PiStation.App.Views">

    <Border
        x:Name="Root"
        automation:AutomationProperties.AutomationId="RightPanelHost"
        automation:AutomationProperties.Name="Workbench"
        Style="{StaticResource PiWorkbenchSurfaceStyle}"
        Visibility="{x:Bind ViewModel.Layout.RightPanelVisibility, Mode=OneWay}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <local:WorkbenchResizeHandle
                x:Name="RightPanelResizeHandle"
                automation:AutomationProperties.AutomationId="RightPanelResizeHandle"
                automation:AutomationProperties.Name="Resize workbench"
                Background="Transparent"
                PointerCaptureLost="OnResizePointerCaptureLost"
                PointerMoved="OnResizePointerMoved"
                PointerPressed="OnResizePointerPressed"
                PointerReleased="OnResizePointerReleased">
                <Border
                    Width="1"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource PiDividerBrush}" />
            </local:WorkbenchResizeHandle>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid MinHeight="40" Padding="12,0,8,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource PiPanelHeaderTextStyle}"
                        Text="Workbench" />
                    <Button
                        x:Name="CloseRightPanelButton"
                        Grid.Column="1"
                        automation:AutomationProperties.AutomationId="CloseRightPanelButton"
                        automation:AutomationProperties.Name="Close workbench"
                        Click="OnCloseClicked"
                        Style="{StaticResource PiToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="Close workbench">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <StackPanel
                        x:Name="RightPanelTabs"
                        automation:AutomationProperties.AutomationId="RightPanelTabs"
                        automation:AutomationProperties.Name="Workbench views"
                        Orientation="Horizontal">
                        <ToggleButton
                            x:Name="ChangesPanelTab"
                            automation:AutomationProperties.AutomationId="ChangesPanelTab"
                            automation:AutomationProperties.Name="Show changes workbench"
                            Click="OnPanelTabClicked"
                            Content="Changes"
                            Style="{StaticResource PiWorkbenchTabStyle}"
                            Tag="Changes" />
                        <ToggleButton
                            x:Name="FilesPanelTab"
                            automation:AutomationProperties.AutomationId="FilesPanelTab"
                            automation:AutomationProperties.Name="Show files workbench"
                            Click="OnPanelTabClicked"
                            Content="Files"
                            Style="{StaticResource PiWorkbenchTabStyle}"
                            Tag="Files" />
                        <ToggleButton
                            x:Name="TerminalPanelTab"
                            automation:AutomationProperties.AutomationId="TerminalPanelTab"
                            automation:AutomationProperties.Name="Show terminal workbench"
                            Click="OnPanelTabClicked"
                            Content="Terminal"
                            Style="{StaticResource PiWorkbenchTabStyle}"
                            Tag="Terminal" />
                        <ToggleButton
                            x:Name="PreviewPanelTab"
                            automation:AutomationProperties.AutomationId="PreviewPanelTab"
                            automation:AutomationProperties.Name="Show preview workbench"
                            Click="OnPanelTabClicked"
                            Content="Preview"
                            Style="{StaticResource PiWorkbenchTabStyle}"
                            Tag="Preview" />
                        <ToggleButton
                            x:Name="AgentsPanelTab"
                            automation:AutomationProperties.AutomationId="AgentsPanelTab"
                            automation:AutomationProperties.Name="Show agents workbench"
                            Click="OnPanelTabClicked"
                            Content="Agents"
                            Style="{StaticResource PiWorkbenchTabStyle}"
                            Tag="Agents" />
                    </StackPanel>
                </ScrollViewer>

                <Grid
                    x:Name="RightPanelContent"
                    Grid.Row="2"
                    automation:AutomationProperties.AutomationId="RightPanelContent"
                    automation:AutomationProperties.Name="Selected workbench view">
                    <StackPanel
                        Margin="28"
                        MaxWidth="300"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.Layout.WorkbenchEmptyStateVisibility, Mode=OneWay}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="24"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Glyph="&#xE8A5;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource PiPanelHeaderTextStyle}"
                            Text="{x:Bind ViewModel.Layout.SelectedPanelTitle, Mode=OneWay}" />
                        <TextBlock
                            x:Name="WorkbenchEmptyStateText"
                            HorizontalAlignment="Center"
                            automation:AutomationProperties.AutomationId="WorkbenchEmptyStateText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource PiTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.Layout.SelectedPanelDescription, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <Grid
                        x:Name="ChangesWorkbenchSurface"
                        Padding="12"
                        automation:AutomationProperties.AutomationId="ChangesWorkbenchSurface"
                        automation:AutomationProperties.Name="Git changes"
                        RowSpacing="8"
                        Visibility="{x:Bind ViewModel.Layout.ChangesPanelVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0.8*" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.2*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Canvas
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.AccessibilityView="Raw">
                                <Path
                                    Data="M 4,4 L 4,12 M 4,8 L 8,8 C 10.2,8 12,6.2 12,5"
                                    Stroke="{ThemeResource PiTextSecondaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.4" />
                                <Ellipse
                                    Width="3"
                                    Height="3"
                                    Canvas.Left="2.5"
                                    Canvas.Top="1"
                                    Fill="{ThemeResource PiTextSecondaryBrush}" />
                                <Ellipse
                                    Width="3"
                                    Height="3"
                                    Canvas.Left="2.5"
                                    Canvas.Top="12"
                                    Fill="{ThemeResource PiTextSecondaryBrush}" />
                                <Ellipse
                                    Width="3"
                                    Height="3"
                                    Canvas.Left="10.5"
                                    Canvas.Top="2"
                                    Fill="{ThemeResource PiTextSecondaryBrush}" />
                            </Canvas>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    x:Name="GitBranchNameText"
                                    automation:AutomationProperties.AutomationId="GitBranchNameText"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.WorkbenchChanges.BranchName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="GitBranchDetailText"
                                    automation:AutomationProperties.AutomationId="GitBranchDetailText"
                                    FontSize="{StaticResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                    Text="{x:Bind ViewModel.WorkbenchChanges.BranchDetail, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                x:Name="RefreshChangesButton"
                                Grid.Column="2"
                                automation:AutomationProperties.AutomationId="RefreshChangesButton"
                                automation:AutomationProperties.Name="Refresh Git changes"
                                Click="OnRefreshChangesClicked"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Refresh changes">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            </Button>
                        </Grid>

                        <TextBlock
                            x:Name="WorkbenchChangesStatusText"
                            Grid.Row="1"
                            automation:AutomationProperties.AutomationId="WorkbenchChangesStatusText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            FontSize="{StaticResource PiFontSizeCaption}"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Text="{x:Bind ViewModel.WorkbenchChanges.Status, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.WorkbenchChanges.StatusVisibility, Mode=OneWay}" />

                        <StackPanel Grid.Row="2" Spacing="6">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="GitBranchSelector"
                                    MinWidth="100"
                                    automation:AutomationProperties.AutomationId="GitBranchSelector"
                                    automation:AutomationProperties.Name="Git branch"
                                    DisplayMemberPath="Name"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchChanges.CanRunGitCommand, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.WorkbenchChanges.Branches}"
                                    SelectedItem="{x:Bind ViewModel.WorkbenchChanges.SelectedBranch, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    automation:AutomationProperties.AutomationId="SwitchGitBranchButton"
                                    Click="OnSwitchGitBranchClicked"
                                    Content="Switch"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchChanges.CanRunGitCommand, Mode=OneWay}" />
                                <Button
                                    Grid.Column="2"
                                    automation:AutomationProperties.AutomationId="PullGitBranchButton"
                                    Click="OnPullGitBranchClicked"
                                    Content="Pull"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchChanges.CanRunGitCommand, Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="NewGitBranchNameBox"
                                    automation:AutomationProperties.AutomationId="NewGitBranchNameBox"
                                    PlaceholderText="New branch"
                                    Text="{x:Bind ViewModel.WorkbenchChanges.NewBranchName, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    automation:AutomationProperties.AutomationId="CreateGitBranchButton"
                                    Click="OnCreateGitBranchClicked"
                                    Content="Create"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchChanges.CanRunGitCommand, Mode=OneWay}" />
                                <Button
                                    Grid.Column="2"
                                    automation:AutomationProperties.AutomationId="InitializeGitButton"
                                    Click="OnInitializeGitClicked"
                                    Content="Init"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchChanges.CanRunGitCommand, Mode=OneWay}" />
                            </Grid>
                            <TextBox
                                x:Name="GitCommitMessageBox"
                                automation:AutomationProperties.AutomationId="GitCommitMessageBox"
                                PlaceholderText="Commit message (Pi generates one if empty)"
                                AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180"
                                Text="{x:Bind ViewModel.WorkbenchChanges.CommitMessage, Mode=TwoWay}" />
                            <Button Content="Load more branches" Click="OnLoadMoreRefsClicked" IsEnabled="{x:Bind ViewModel.WorkbenchChanges.CanLoadMoreRefs, Mode=OneWay}" />
                            <Button Content="Generate message with Pi" Click="OnGenerateCommitMessageClicked" IsEnabled="{x:Bind ViewModel.Settings.CanGenerateText, Mode=OneWay}" automation:AutomationProperties.AutomationId="GenerateCommitMessageButton" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    automation:AutomationProperties.AutomationId="CommitGitChangesButton"
                                    Click="OnCommitGitChangesClicked"
                                    Content="Commit selected"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchChanges.CanCommit, Mode=OneWay}" />
                                <Button
                                    automation:AutomationProperties.AutomationId="CommitPushGitChangesButton"
                                    Click="OnCommitPushGitChangesClicked"
                                    Content="Commit selected + push"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchChanges.CanCommit, Mode=OneWay}" />
                                <Button
                                    automation:AutomationProperties.AutomationId="PushGitBranchButton"
                                    Click="OnPushGitBranchClicked"
                                    Content="Push"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchChanges.CanRunGitCommand, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Left"
                                automation:AutomationProperties.AutomationId="RemoveThreadWorktreeButton"
                                Click="OnRemoveThreadWorktreeClicked"
                                Content="Remove thread worktree…"
                                IsEnabled="{x:Bind ViewModel.WorkbenchChanges.CanRunGitCommand, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.WorkbenchChanges.RemoveWorktreeVisibility, Mode=OneWay}" />
                        </StackPanel>

                        <ListView
                            x:Name="WorkbenchChangeList"
                            Grid.Row="3"
                            automation:AutomationProperties.AutomationId="WorkbenchChangeList"
                            automation:AutomationProperties.Name="Changed files"
                            IsTabStop="False"
                            ItemContainerStyle="{StaticResource PiSidebarListViewItemStyle}"
                            ItemsSource="{x:Bind ViewModel.WorkbenchChanges.Changes}"
                            SelectedItem="{x:Bind ViewModel.WorkbenchChanges.SelectedChange, Mode=OneWay}"
                            SelectionChanged="OnWorkbenchChangeSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:WorkbenchChangeItemViewModel">
                                    <Grid
                                        MinHeight="42"
                                        Padding="2,3"
                                        automation:AutomationProperties.Name="{x:Bind AccessibleName}"
                                        ToolTipService.ToolTip="{x:Bind StatusLabel}"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelectedForCommit, Mode=TwoWay}" VerticalAlignment="Center"
                                                  automation:AutomationProperties.Name="{x:Bind AccessibleName}" Content="{x:Bind StatusCode}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind FileName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontFamily="{StaticResource PiMonospaceFontFamily}"
                                                FontSize="{StaticResource PiFontSizeCaption}"
                                                Foreground="{ThemeResource PiTextMutedBrush}"
                                                Text="{x:Bind RelativePath}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Spacing="1">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                CharacterSpacing="45"
                                                FontSize="9"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource PiTextMutedBrush}"
                                                Text="{x:Bind AreaLabel}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontFamily="{StaticResource PiMonospaceFontFamily}"
                                                FontSize="{StaticResource PiFontSizeCaption}"
                                                Foreground="{ThemeResource PiTextMutedBrush}"
                                                Text="{x:Bind LineSummary}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Grid.Row="4" Background="{ThemeResource PiDividerBrush}" />

                        <StackPanel Grid.Row="5" Spacing="2">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource PiSectionLabelTextStyle}" Text="DIFF" />
                                <Button
                                    x:Name="AddDiffSelectionToComposerButton"
                                    Grid.Column="1"
                                    automation:AutomationProperties.AutomationId="AddDiffSelectionToComposerButton"
                                    Click="OnAddDiffSelectionToComposerClicked"
                                    Content="Add selection"
                                    Style="{StaticResource PiToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Add selected diff lines to the composer" />
                            </Grid>
                            <TextBlock
                                x:Name="WorkbenchDiffPathText"
                                automation:AutomationProperties.AutomationId="WorkbenchDiffPathText"
                                FontFamily="{StaticResource PiMonospaceFontFamily}"
                                Foreground="{ThemeResource PiTextPrimaryBrush}"
                                Text="{x:Bind ViewModel.WorkbenchChanges.DiffPath, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="WorkbenchDiffStatusText"
                                automation:AutomationProperties.AutomationId="WorkbenchDiffStatusText"
                                automation:AutomationProperties.LiveSetting="Polite"
                                FontSize="{StaticResource PiFontSizeCaption}"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="{x:Bind ViewModel.WorkbenchChanges.DiffMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <local:DiffView
                            x:Name="WorkbenchDiffPreview"
                            Grid.Row="6"
                            automation:AutomationProperties.AutomationId="WorkbenchDiffPreview"
                            automation:AutomationProperties.Name="Git diff content"
                            Text="{x:Bind ViewModel.WorkbenchChanges.DiffContent, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.WorkbenchChanges.DiffContentVisibility, Mode=OneWay}" />
                        <StackPanel Grid.Row="7" Spacing="8">
                        <Border Padding="8" Style="{StaticResource PiElevatedSurfaceStyle}"
                            Visibility="{x:Bind ViewModel.Workspace.LinkedPullRequestVisibility, Mode=OneWay}"
                            automation:AutomationProperties.AutomationId="LinkedPullRequestCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Linked pull request" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.Workspace.LinkedPullRequestSummary, Mode=OneWay}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                                <Button Content="Open linked PR" Click="OnOpenLinkedPullRequest" Style="{StaticResource PiSecondaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Button HorizontalAlignment="Stretch" Click="OnHostingReviewClicked" Content="Pull requests…"
                            automation:AutomationProperties.AutomationId="HostingReviewButton" Style="{StaticResource PiSecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid
                        x:Name="TerminalWorkbenchSurface"
                        Padding="12"
                        automation:AutomationProperties.AutomationId="TerminalWorkbenchSurface"
                        automation:AutomationProperties.Name="Project terminal"
                        RowSpacing="8"
                        Visibility="{x:Bind ViewModel.Layout.TerminalPanelVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="TerminalShellSelector"
                                MinWidth="150"
                                HorizontalAlignment="Stretch"
                                automation:AutomationProperties.AutomationId="TerminalShellSelector"
                                automation:AutomationProperties.Name="New terminal shell"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.WorkbenchTerminal.Shells}"
                                SelectedItem="{x:Bind ViewModel.WorkbenchTerminal.SelectedShell, Mode=OneWay}"
                                SelectionChanged="OnTerminalShellSelectionChanged" />
                            <Button
                                x:Name="NewTerminalButton"
                                Grid.Column="1"
                                automation:AutomationProperties.AutomationId="NewTerminalButton"
                                automation:AutomationProperties.Name="Start new terminal"
                                Click="OnNewTerminalClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchTerminal.CanCreate, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="New terminal">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="TerminalSessionSelector"
                                HorizontalAlignment="Stretch"
                                automation:AutomationProperties.AutomationId="TerminalSessionSelector"
                                automation:AutomationProperties.Name="Terminal session"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.WorkbenchTerminal.Sessions}"
                                SelectedItem="{x:Bind ViewModel.WorkbenchTerminal.SelectedSession, Mode=OneWay}"
                                SelectionChanged="OnTerminalSessionSelectionChanged" />
                            <Button
                                x:Name="StopTerminalButton"
                                Grid.Column="1"
                                automation:AutomationProperties.AutomationId="StopTerminalButton"
                                automation:AutomationProperties.Name="Stop terminal"
                                Click="OnStopTerminalClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchTerminal.CanStop, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Stop terminal">
                                <FontIcon FontSize="11" Glyph="&#xE71A;" />
                            </Button>
                            <Button
                                x:Name="RestartTerminalButton"
                                Grid.Column="2"
                                automation:AutomationProperties.AutomationId="RestartTerminalButton"
                                automation:AutomationProperties.Name="Restart terminal"
                                Click="OnRestartTerminalClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchTerminal.CanRestart, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Restart terminal">
                                <FontIcon FontSize="11" Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                x:Name="ClearTerminalButton"
                                Grid.Column="3"
                                automation:AutomationProperties.AutomationId="ClearTerminalButton"
                                automation:AutomationProperties.Name="Clear terminal output and saved history"
                                Click="OnClearTerminalClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchTerminal.CanClose, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Clear output and saved history on the host">
                                <FontIcon FontSize="11" Glyph="&#xE74D;" />
                            </Button>
                            <Button
                                x:Name="CloseTerminalButton"
                                Grid.Column="4"
                                automation:AutomationProperties.AutomationId="CloseTerminalButton"
                                automation:AutomationProperties.Name="Close terminal session"
                                Click="OnCloseTerminalClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchTerminal.CanClose, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Close terminal">
                                <FontIcon FontSize="11" Glyph="&#xE711;" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock
                                    x:Name="TerminalSessionSummaryText"
                                    automation:AutomationProperties.AutomationId="TerminalSessionSummaryText"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.WorkbenchTerminal.SessionSummary, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="TerminalPaneSummaryText"
                                    automation:AutomationProperties.AutomationId="TerminalPaneSummaryText"
                                    automation:AutomationProperties.LiveSetting="Polite"
                                    FontSize="{StaticResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                                    Text="{x:Bind ViewModel.WorkbenchTerminal.PaneSummary, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="TerminalStatusText"
                                    automation:AutomationProperties.AutomationId="TerminalStatusText"
                                    automation:AutomationProperties.LiveSetting="Polite"
                                    FontSize="{StaticResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                    Text="{x:Bind ViewModel.WorkbenchTerminal.Status, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button
                                    x:Name="SplitTerminalRightButton"
                                    automation:AutomationProperties.AutomationId="SplitTerminalRightButton"
                                    automation:AutomationProperties.Name="Split terminal right"
                                    Click="OnSplitTerminalRightClicked"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchTerminal.CanSplit, Mode=OneWay}"
                                    Style="{StaticResource PiToolbarIconButtonStyle}"
                                    ToolTipService.ToolTip="Split terminal right (Ctrl+Shift+5)">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Rectangle
                                                Width="14"
                                                Height="12"
                                                Canvas.Left="1"
                                                Canvas.Top="2"
                                                RadiusX="1"
                                                RadiusY="1"
                                                Stroke="{ThemeResource PiTextSecondaryBrush}"
                                                StrokeThickness="1.3" />
                                            <Path
                                                Data="M 8,2 L 8,14"
                                                Stroke="{ThemeResource PiTextSecondaryBrush}"
                                                StrokeThickness="1.3" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button
                                    x:Name="SplitTerminalDownButton"
                                    automation:AutomationProperties.AutomationId="SplitTerminalDownButton"
                                    automation:AutomationProperties.Name="Split terminal down"
                                    Click="OnSplitTerminalDownClicked"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchTerminal.CanSplit, Mode=OneWay}"
                                    Style="{StaticResource PiToolbarIconButtonStyle}"
                                    ToolTipService.ToolTip="Split terminal down (Ctrl+Shift+D)">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="16" Height="16">
                                            <Rectangle
                                                Width="14"
                                                Height="12"
                                                Canvas.Left="1"
                                                Canvas.Top="2"
                                                RadiusX="1"
                                                RadiusY="1"
                                                Stroke="{ThemeResource PiTextSecondaryBrush}"
                                                StrokeThickness="1.3" />
                                            <Path
                                                Data="M 1,8 L 15,8"
                                                Stroke="{ThemeResource PiTextSecondaryBrush}"
                                                StrokeThickness="1.3" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button
                                    x:Name="CloseTerminalPaneButton"
                                    automation:AutomationProperties.AutomationId="CloseTerminalPaneButton"
                                    automation:AutomationProperties.Name="Close active terminal pane"
                                    Click="OnCloseTerminalPaneClicked"
                                    IsEnabled="{x:Bind ViewModel.WorkbenchTerminal.CanClosePane, Mode=OneWay}"
                                    Style="{StaticResource PiToolbarIconButtonStyle}"
                                    ToolTipService.ToolTip="Close active pane (Ctrl+Shift+W)">
                                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid
                            x:Name="TerminalPaneHost"
                            Grid.Row="3"
                            automation:AutomationProperties.AutomationId="TerminalPaneTree"
                            automation:AutomationProperties.Name="Terminal pane tree" />

                        <Grid Grid.Row="4" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TerminalInput"
                                automation:AutomationProperties.AutomationId="TerminalInput"
                                automation:AutomationProperties.Name="Terminal command"
                                IsEnabled="{x:Bind ViewModel.WorkbenchTerminal.CanStop, Mode=OneWay}"
                                KeyDown="OnTerminalInputKeyDown"
                                PlaceholderText="Run a command (focus output for interactive keys)"
                                Style="{StaticResource PiTextBoxStyle}"
                                Text="{x:Bind ViewModel.WorkbenchTerminal.InputText, Mode=OneWay}"
                                TextChanged="OnTerminalInputTextChanged" />
                            <Button
                                x:Name="SendTerminalInputButton"
                                Grid.Column="1"
                                automation:AutomationProperties.AutomationId="SendTerminalInputButton"
                                automation:AutomationProperties.Name="Run terminal command"
                                Click="OnSendTerminalInputClicked"
                                Content="Run"
                                IsEnabled="{x:Bind ViewModel.WorkbenchTerminal.CanSend, Mode=OneWay}" />
                        </Grid>
                    </Grid>

                        <Grid
                            x:Name="FileWorkbenchSurface"
                        Padding="8"
                        automation:AutomationProperties.AutomationId="FileWorkbenchSurface"
                        automation:AutomationProperties.Name="Project files"
                        Visibility="{x:Bind ViewModel.Layout.FilesPanelVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="6" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="WorkbenchFileSearchMode"
                                automation:AutomationProperties.AutomationId="WorkbenchFileSearchMode"
                                automation:AutomationProperties.Name="File search mode"
                                SelectedIndex="{x:Bind ViewModel.WorkbenchFiles.SearchModeIndex, Mode=OneWay}"
                                SelectionChanged="OnFileSearchModeChanged">
                                <x:String>Files</x:String>
                                <x:String>Contents</x:String>
                            </ComboBox>
                            <TextBox
                                x:Name="WorkbenchFileSearchInput"
                                Grid.Column="1"
                                automation:AutomationProperties.AutomationId="WorkbenchFileSearchInput"
                                automation:AutomationProperties.Name="Filter project files"
                                PlaceholderText="{x:Bind ViewModel.WorkbenchFiles.SearchPlaceholder, Mode=OneWay}"
                                Style="{StaticResource PiTextBoxStyle}"
                                Text="{x:Bind ViewModel.WorkbenchFiles.SearchQuery, Mode=OneWay}"
                                TextChanged="OnFileSearchTextChanged" />
                            <Button
                                x:Name="RefreshWorkbenchFilesButton"
                                Grid.Column="2"
                                automation:AutomationProperties.AutomationId="RefreshWorkbenchFilesButton"
                                automation:AutomationProperties.Name="Refresh project files"
                                Click="OnRefreshFilesClicked"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Refresh files">
                                <FontIcon FontSize="12" Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                x:Name="OpenExternalReadOnlyFileButton"
                                Grid.Row="1"
                                Grid.Column="0"
                                automation:AutomationProperties.AutomationId="OpenExternalReadOnlyFileButton"
                                automation:AutomationProperties.Name="Open a read-only file outside the workspace"
                                Click="OnOpenExternalReadOnlyFileClicked"
                                Content="Open file…"
                                Style="{StaticResource PiToolbarButtonStyle}"
                                ToolTipService.ToolTip="Open an external file read-only" />
                            <ToggleButton
                                Grid.Row="1"
                                Grid.Column="1"
                                automation:AutomationProperties.Name="Match case"
                                Click="OnContentSearchOptionClicked"
                                Content="Aa"
                                IsChecked="{x:Bind ViewModel.WorkbenchFiles.CaseSensitive, Mode=OneWay}"
                                Style="{StaticResource PiIconToggleButtonStyle}"
                                Tag="case"
                                ToolTipService.ToolTip="Match case"
                                Visibility="{x:Bind ViewModel.WorkbenchFiles.ContentSearchOptionsVisibility, Mode=OneWay}" />
                            <ToggleButton
                                Grid.Row="1"
                                Grid.Column="2"
                                automation:AutomationProperties.Name="Match whole word"
                                Click="OnContentSearchOptionClicked"
                                Content="ab"
                                IsChecked="{x:Bind ViewModel.WorkbenchFiles.WholeWord, Mode=OneWay}"
                                Style="{StaticResource PiIconToggleButtonStyle}"
                                Tag="word"
                                ToolTipService.ToolTip="Match whole word"
                                Visibility="{x:Bind ViewModel.WorkbenchFiles.ContentSearchOptionsVisibility, Mode=OneWay}" />
                            <ToggleButton
                                Grid.Row="1"
                                Grid.Column="3"
                                automation:AutomationProperties.Name="Use regular expression"
                                Click="OnContentSearchOptionClicked"
                                Content=".*"
                                IsChecked="{x:Bind ViewModel.WorkbenchFiles.UseRegularExpression, Mode=OneWay}"
                                Style="{StaticResource PiIconToggleButtonStyle}"
                                Tag="regex"
                                ToolTipService.ToolTip="Use regular expression"
                                Visibility="{x:Bind ViewModel.WorkbenchFiles.ContentSearchOptionsVisibility, Mode=OneWay}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Load more" Click="OnLoadMoreFilesClicked" IsEnabled="{x:Bind ViewModel.WorkbenchFiles.CanLoadMore, Mode=OneWay}" />
                        <TextBlock
                            x:Name="WorkbenchFileStatusText"
                            Grid.Row="1"
                            automation:AutomationProperties.AutomationId="WorkbenchFileStatusText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            FontSize="{StaticResource PiFontSizeCaption}"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Text="{x:Bind ViewModel.WorkbenchFiles.Status, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.WorkbenchFiles.StatusVisibility, Mode=OneWay}" />
                        </StackPanel>

                        <Grid
                            x:Name="FileWorkbenchLayoutGrid"
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            ColumnSpacing="8"
                            RowSpacing="8"
                            SizeChanged="OnFileWorkbenchLayoutSizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FileWorkbenchTreeColumn" Width="240" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition x:Name="FileWorkbenchEditorColumn" Width="62*" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="FileWorkbenchTreeHost">
                                <TreeView
                                    x:Name="WorkspaceFileTree"
                                    automation:AutomationProperties.AutomationId="WorkspaceFileTree"
                                    automation:AutomationProperties.Name="Workspace directory tree"
                                    ItemInvoked="OnWorkspaceTreeItemInvoked"
                                    ItemsSource="{x:Bind ViewModel.WorkbenchFiles.TreeRoots, Mode=OneWay}"
                                    SelectionMode="Single"
                                    Visibility="{x:Bind ViewModel.WorkbenchFiles.TreeVisibility, Mode=OneWay}">
                                    <TreeView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:WorkspaceTreeItemViewModel">
                                            <TreeViewItem
                                                CanDrag="True"
                                                DragStarting="OnWorkspaceTreeItemDragStarting"
                                                IsExpanded="True"
                                                ItemsSource="{x:Bind Children}">
                                                <StackPanel Orientation="Horizontal" Spacing="7" ToolTipService.ToolTip="{x:Bind RelativePath}">
                                                    <FontIcon FontSize="12" Glyph="{x:Bind Glyph}" />
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </TreeViewItem>
                                        </DataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <ListView
                                    x:Name="WorkbenchFileList"
                                    automation:AutomationProperties.AutomationId="WorkbenchFileList"
                                    automation:AutomationProperties.Name="Matching workspace files"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnWorkbenchFileClicked"
                                    ItemsSource="{x:Bind ViewModel.WorkbenchFiles.Files, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.WorkbenchFiles.SelectedFile, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.WorkbenchFiles.PathResultsVisibility, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProjectFileMatch">
                                            <Grid
                                                MinHeight="40"
                                                Padding="4,3"
                                                CanDrag="True"
                                                DragStarting="OnProjectFileDragStarting"
                                                ToolTipService.ToolTip="{x:Bind RelativePath}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontFamily="{StaticResource PiMonospaceFontFamily}" FontSize="11" Foreground="{ThemeResource PiTextMutedBrush}" Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <ListView
                                    x:Name="WorkbenchContentSearchResults"
                                    automation:AutomationProperties.AutomationId="WorkbenchContentSearchResults"
                                    automation:AutomationProperties.Name="Workspace content matches"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnWorkbenchContentMatchClicked"
                                    ItemsSource="{x:Bind ViewModel.WorkbenchFiles.ContentMatches, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.WorkbenchFiles.SelectedContentMatch, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.WorkbenchFiles.ContentResultsVisibility, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProjectContentMatch">
                                            <Grid
                                                MinHeight="54"
                                                Padding="4"
                                                CanDrag="True"
                                                DragStarting="OnContentMatchDragStarting"
                                                ToolTipService.ToolTip="{x:Bind RelativePath}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource PiTextMutedBrush}" Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontFamily="{StaticResource PiMonospaceFontFamily}" FontSize="11" Text="{x:Bind LineContent}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="10" Foreground="{ThemeResource PiTextMutedBrush}" Text="{x:Bind LineNumber}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <Border x:Name="FileWorkbenchDivider" Grid.Column="1" Background="{ThemeResource PiDividerBrush}" />

                            <Grid x:Name="FileWorkbenchEditorHost" Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ListView
                                    x:Name="WorkbenchFileTabs"
                                    MinHeight="36"
                                    automation:AutomationProperties.AutomationId="WorkbenchFileTabs"
                                    automation:AutomationProperties.Name="Open file tabs"
                                    ItemsSource="{x:Bind ViewModel.WorkbenchFiles.OpenDocuments, Mode=OneWay}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    SelectedItem="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument, Mode=OneWay}"
                                    SelectionChanged="OnWorkbenchFileTabSelectionChanged">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:WorkbenchFileDocumentViewModel">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock MaxWidth="150" VerticalAlignment="Center" Text="{x:Bind DisplayTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind RelativePath}" />
                                                <Button Grid.Column="1" Click="OnCloseWorkbenchFileTabClicked" Style="{StaticResource PiToolbarIconButtonStyle}" ToolTipService.ToolTip="Close file">
                                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,4"
                                    RowSpacing="4"
                                    Visibility="{x:Bind ViewModel.WorkbenchFiles.DocumentVisibility, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        x:Name="WorkbenchFilePreviewPathText"
                                        VerticalAlignment="Center"
                                        automation:AutomationProperties.AutomationId="WorkbenchFilePreviewPathText"
                                        FontFamily="{StaticResource PiMonospaceFontFamily}"
                                        Text="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.RelativePath, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="1" RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer
                                            HorizontalScrollBarVisibility="Auto"
                                            HorizontalScrollMode="Enabled"
                                            VerticalScrollBarVisibility="Disabled"
                                            VerticalScrollMode="Disabled">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button automation:AutomationProperties.AutomationId="SaveWorkbenchFileButton" Click="OnSaveWorkbenchFileClicked" IsEnabled="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.CanSave, Mode=OneWay}" Style="{StaticResource PiToolbarButtonStyle}" ToolTipService.ToolTip="Save (Ctrl+S)" Content="Save" />
                                                <Button automation:AutomationProperties.AutomationId="ReloadWorkbenchFileButton" Click="OnReloadWorkbenchFileClicked" IsEnabled="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.CanReloadFromWorkspace, Mode=OneWay}" Style="{StaticResource PiToolbarIconButtonStyle}" ToolTipService.ToolTip="Reload from disk"><FontIcon FontSize="12" Glyph="&#xE72C;" /></Button>
                                                <Button automation:AutomationProperties.AutomationId="OpenWorkbenchFileInEditorButton" Click="OnOpenWorkbenchFileInEditorClicked" IsEnabled="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.CanOpenInEditor, Mode=OneWay}" Style="{StaticResource PiToolbarButtonStyle}" ToolTipService.ToolTip="Open in external editor" Content="Open in Editor" />
                                            </StackPanel>
                                        </ScrollViewer>
                                        <ScrollViewer
                                            Grid.Row="1"
                                            HorizontalScrollBarVisibility="Auto"
                                            HorizontalScrollMode="Enabled"
                                            VerticalScrollBarVisibility="Disabled"
                                            VerticalScrollMode="Disabled">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button automation:AutomationProperties.AutomationId="AddFileSelectionToComposerButton" Click="OnAddFileSelectionToComposerClicked" Content="Add selection" Style="{StaticResource PiToolbarButtonStyle}" ToolTipService.ToolTip="Add selected file lines to the composer" />
                                                <ToggleButton automation:AutomationProperties.AutomationId="WorkbenchMarkdownToggle" IsChecked="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.ShowRenderedContent, Mode=TwoWay}" Style="{StaticResource PiIconToggleButtonStyle}" ToolTipService.ToolTip="Toggle source and rendered preview" Visibility="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.RenderedToggleVisibility, Mode=OneWay}">
                                                    <FontIcon FontSize="12" Glyph="&#xE890;" />
                                                </ToggleButton>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>

                                <TextBlock
                                    x:Name="WorkbenchFilePreviewStatusText"
                                    Grid.Row="2"
                                    Margin="0,0,0,4"
                                    automation:AutomationProperties.AutomationId="WorkbenchFilePreviewStatusText"
                                    automation:AutomationProperties.LiveSetting="Polite"
                                    FontSize="{StaticResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                    Text="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.Status, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind ViewModel.WorkbenchFiles.DocumentVisibility, Mode=OneWay}" />

                                <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.WorkbenchFiles.DocumentVisibility, Mode=OneWay}">
                                    <TextBox
                                        x:Name="WorkbenchFileEditor"
                                        automation:AutomationProperties.AutomationId="WorkbenchFileEditor"
                                        automation:AutomationProperties.Name="Editable workspace file"
                                        AcceptsReturn="True"
                                        Background="{ThemeResource PiControlSurfaceBrush}"
                                        FontFamily="{StaticResource PiMonospaceFontFamily}"
                                        FontSize="{StaticResource PiFontSizeCaption}"
                                        IsReadOnly="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.IsReadOnly, Mode=OneWay}"
                                        Padding="10"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        Text="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.SourceVisibility, Mode=OneWay}" />

                                    <ScrollViewer Visibility="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.MarkdownVisibility, Mode=OneWay}" VerticalScrollBarVisibility="Auto">
                                        <views:MarkdownView Margin="12" automation:AutomationProperties.AutomationId="WorkbenchMarkdownPreview" Text="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.Content, Mode=OneWay}" />
                                    </ScrollViewer>

                                    <ScrollViewer Visibility="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.ImageVisibility, Mode=OneWay}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled">
                                        <Image x:Name="WorkbenchFileImage" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1600" MaxHeight="1200" Stretch="Uniform" />
                                    </ScrollViewer>

                                    <local:FilePreviewWebViewSurface
                                        x:Name="WorkbenchRenderedFilePreview"
                                        automation:AutomationProperties.AutomationId="WorkbenchRenderedFilePreview"
                                        Visibility="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.WebPreviewVisibility, Mode=OneWay}" />

                                    <MediaPlayerElement
                                        x:Name="WorkbenchFileMediaPreview"
                                        automation:AutomationProperties.AutomationId="WorkbenchFileMediaPreview"
                                        AreTransportControlsEnabled="True"
                                        AutoPlay="False"
                                        Stretch="Uniform"
                                        Visibility="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.MediaVisibility, Mode=OneWay}" />

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.WorkbenchFiles.ActiveDocument.UnsupportedBinaryVisibility, Mode=OneWay}">
                                        <FontIcon FontSize="28" Foreground="{ThemeResource PiTextMutedBrush}" Glyph="&#xE7C3;" />
                                        <TextBlock Foreground="{ThemeResource PiTextMutedBrush}" Text="No safe in-app renderer is available for this binary file." TextAlignment="Center" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.WorkbenchFiles.EmptyDocumentVisibility, Mode=OneWay}">
                                    <FontIcon FontSize="28" Foreground="{ThemeResource PiTextMutedBrush}" Glyph="&#xE8A5;" />
                                    <TextBlock Foreground="{ThemeResource PiTextMutedBrush}" Text="Choose a file to open it in a tab" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="PreviewWorkbenchSurface"
                        automation:AutomationProperties.AutomationId="WorkbenchPreviewPanel"
                        automation:AutomationProperties.Name="Web preview"
                        Visibility="{x:Bind ViewModel.Layout.PreviewPanelVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="PreviewTabsBar"
                            automation:AutomationProperties.AutomationId="PreviewTabsBar"
                            Padding="6,4,6,0"
                            ColumnSpacing="4"
                            Visibility="{x:Bind ViewModel.WorkbenchPreview.TabStripVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListView
                                x:Name="PreviewTabStrip"
                                MinHeight="34"
                                automation:AutomationProperties.AutomationId="PreviewTabStrip"
                                automation:AutomationProperties.Name="Open browser preview tabs"
                                ItemsSource="{x:Bind ViewModel.WorkbenchPreview.Tabs, Mode=OneWay}"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                SelectedItem="{x:Bind ViewModel.WorkbenchPreview.ActiveTab, Mode=OneWay}"
                                SelectionChanged="OnPreviewTabSelectionChanged">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:WorkbenchPreviewTabViewModel">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock MaxWidth="130" VerticalAlignment="Center" Text="{x:Bind TabTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind CurrentUrl}" />
                                            <Button Grid.Column="1" automation:AutomationProperties.Name="Close preview tab" Click="OnClosePreviewTabClicked" Style="{StaticResource PiToolbarIconButtonStyle}" ToolTipService.ToolTip="Close preview tab">
                                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button
                                x:Name="AddPreviewTabButton"
                                Grid.Column="1"
                                automation:AutomationProperties.AutomationId="AddPreviewTabButton"
                                automation:AutomationProperties.Name="New preview tab"
                                Click="OnAddPreviewTabClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanAddTab, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="New preview tab">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Padding="8,6" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="PreviewBackButton"
                                automation:AutomationProperties.AutomationId="PreviewBackButton"
                                automation:AutomationProperties.Name="Go back in preview"
                                Click="OnPreviewBackClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanGoBack, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Back">
                                <FontIcon FontSize="12" Glyph="&#xE72B;" />
                            </Button>
                            <Button
                                x:Name="PreviewForwardButton"
                                Grid.Column="1"
                                automation:AutomationProperties.AutomationId="PreviewForwardButton"
                                automation:AutomationProperties.Name="Go forward in preview"
                                Click="OnPreviewForwardClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanGoForward, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Forward">
                                <FontIcon FontSize="12" Glyph="&#xE72A;" />
                            </Button>
                            <Button
                                x:Name="PreviewReloadStopButton"
                                Grid.Column="2"
                                automation:AutomationProperties.AutomationId="PreviewReloadStopButton"
                                automation:AutomationProperties.Name="{x:Bind ViewModel.WorkbenchPreview.ReloadStopLabel, Mode=OneWay}"
                                Click="OnPreviewReloadStopClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanReloadOrStop, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Reload or stop preview">
                                <FontIcon
                                    FontSize="12"
                                    Glyph="{x:Bind ViewModel.WorkbenchPreview.ReloadStopGlyph, Mode=OneWay}" />
                            </Button>
                            <TextBox
                                x:Name="PreviewAddressBox"
                                Grid.Column="3"
                                MinWidth="80"
                                automation:AutomationProperties.AutomationId="PreviewAddressBox"
                                automation:AutomationProperties.Name="Preview address"
                                IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanNavigate, Mode=OneWay}"
                                KeyDown="OnPreviewAddressKeyDown"
                                PlaceholderText="localhost:5173"
                                Style="{StaticResource PiTextBoxStyle}"
                                Text="{x:Bind ViewModel.WorkbenchPreview.AddressText, Mode=OneWay}"
                                TextChanged="OnPreviewAddressTextChanged" />
                            <Button
                                x:Name="PreviewAnnotateButton"
                                Grid.Column="4"
                                automation:AutomationProperties.AutomationId="PreviewAnnotateButton"
                                automation:AutomationProperties.Name="{x:Bind ViewModel.WorkbenchPreview.AnnotationLabel, Mode=OneWay}"
                                Click="OnPreviewAnnotateClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanAnnotate, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Select an element and add it to the composer">
                                <FontIcon FontSize="12" Glyph="&#xE7C8;" />
                            </Button>
                            <Button
                                x:Name="PreviewCaptureButton"
                                Grid.Column="5"
                                automation:AutomationProperties.AutomationId="PreviewCaptureButton"
                                automation:AutomationProperties.Name="Capture preview screenshot"
                                Click="OnPreviewCaptureClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanCapture, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Capture screenshot">
                                <FontIcon FontSize="12" Glyph="&#xE722;" />
                            </Button>
                            <Button
                                x:Name="PreviewOpenExternalButton"
                                Grid.Column="6"
                                automation:AutomationProperties.AutomationId="PreviewOpenExternalButton"
                                automation:AutomationProperties.Name="Open preview in system browser"
                                Click="OnPreviewOpenExternalClicked"
                                IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanOpenExternal, Mode=OneWay}"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Open externally">
                                <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2" Height="2">
                            <ProgressBar
                                x:Name="PreviewLoadingProgress"
                                automation:AutomationProperties.AutomationId="PreviewLoadingProgress"
                                IsIndeterminate="True"
                                Visibility="{x:Bind ViewModel.WorkbenchPreview.LoadingProgressVisibility, Mode=OneWay}" />
                        </Grid>

                        <ScrollViewer
                            Grid.Row="3"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled"
                            Visibility="{x:Bind ViewModel.WorkbenchPreview.ViewportControlsVisibility, Mode=OneWay}">
                            <StackPanel Padding="8,4" Orientation="Horizontal" Spacing="6">
                            <ComboBox
                                x:Name="PreviewViewportSelector"
                                Width="178"
                                automation:AutomationProperties.AutomationId="PreviewViewportSelector"
                                automation:AutomationProperties.Name="Preview device size"
                                SelectedIndex="{x:Bind ViewModel.WorkbenchPreview.ViewportPresetIndex, Mode=OneWay}"
                                SelectionChanged="OnPreviewViewportSelectionChanged">
                                <x:String>Responsive</x:String>
                                <x:String>Desktop 1440 × 900</x:String>
                                <x:String>Tablet 768 × 1024</x:String>
                                <x:String>Phone 390 × 844</x:String>
                            </ComboBox>
                            <Button
                                x:Name="RotatePreviewViewportButton"
                                automation:AutomationProperties.AutomationId="RotatePreviewViewportButton"
                                automation:AutomationProperties.Name="Rotate preview device"
                                Click="OnRotatePreviewViewportClicked"
                                Style="{StaticResource PiToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="Rotate device">
                                <FontIcon FontSize="12" Glyph="&#xE7AD;" />
                            </Button>
                            <TextBlock
                                x:Name="PreviewViewportDescriptionText"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.AutomationId="PreviewViewportDescriptionText"
                                FontSize="11"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="{x:Bind ViewModel.WorkbenchPreview.ViewportDescription, Mode=OneWay}" />
                            <Rectangle Width="1" Height="24" Fill="{ThemeResource PiDividerBrush}" />
                            <ComboBox
                                x:Name="PreviewProfileSelector"
                                Width="130"
                                automation:AutomationProperties.AutomationId="PreviewProfileSelector"
                                automation:AutomationProperties.Name="Browser profile"
                                DisplayMemberPath="Name"
                                IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanChangeProfile, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.WorkbenchPreview.BrowserProfiles, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.WorkbenchPreview.SelectedProfile, Mode=OneWay}"
                                SelectionChanged="OnPreviewProfileSelectionChanged" />
                            <Button
                                automation:AutomationProperties.AutomationId="AddPreviewProfileButton"
                                Click="OnAddPreviewProfileClicked"
                                Content="New profile"
                                Style="{StaticResource PiToolbarButtonStyle}" />
                            <Button
                                automation:AutomationProperties.AutomationId="SetDefaultPreviewProfileButton"
                                Click="OnSetDefaultPreviewProfileClicked"
                                Content="Make default"
                                Style="{StaticResource PiToolbarButtonStyle}" />
                            <Button
                                x:Name="PreviewRecentUrlsButton"
                                automation:AutomationProperties.AutomationId="PreviewRecentUrlsButton"
                                Content="Recent"
                                Style="{StaticResource PiToolbarButtonStyle}">
                                <Button.Flyout>
                                    <MenuFlyout x:Name="PreviewRecentUrlsFlyout" Opening="OnPreviewRecentUrlsFlyoutOpening" />
                                </Button.Flyout>
                            </Button>
                            <ComboBox
                                x:Name="PreviewColorSchemeSelector"
                                Width="96"
                                automation:AutomationProperties.AutomationId="PreviewColorSchemeSelector"
                                automation:AutomationProperties.Name="Preview page color scheme"
                                SelectedIndex="{x:Bind ViewModel.WorkbenchPreview.ColorSchemeIndex, Mode=OneWay}"
                                SelectionChanged="OnPreviewColorSchemeSelectionChanged">
                                <x:String>System</x:String>
                                <x:String>Light</x:String>
                                <x:String>Dark</x:String>
                            </ComboBox>
                            <Button automation:AutomationProperties.AutomationId="PreviewZoomOutButton" Click="OnPreviewZoomOutClicked" Content="−" Style="{StaticResource PiToolbarButtonStyle}" />
                            <TextBlock
                                MinWidth="42"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.AutomationId="PreviewZoomDescriptionText"
                                Text="{x:Bind ViewModel.WorkbenchPreview.ZoomDescription, Mode=OneWay}"
                                TextAlignment="Center" />
                            <Button automation:AutomationProperties.AutomationId="PreviewZoomInButton" Click="OnPreviewZoomInClicked" Content="+" Style="{StaticResource PiToolbarButtonStyle}" />
                            <Button automation:AutomationProperties.AutomationId="PreviewZoomResetButton" Click="OnPreviewZoomResetClicked" Content="Reset" Style="{StaticResource PiToolbarButtonStyle}" />
                            <ToggleButton
                                x:Name="PreviewDevToolsPolicyToggle"
                                automation:AutomationProperties.AutomationId="PreviewDevToolsPolicyToggle"
                                Click="OnPreviewDevToolsPolicyClicked"
                                Content="Allow DevTools"
                                Style="{StaticResource PiToolbarToggleButtonStyle}" />
                            <Button
                                x:Name="PreviewOpenDevToolsButton"
                                automation:AutomationProperties.AutomationId="PreviewOpenDevToolsButton"
                                Click="OnPreviewOpenDevToolsClicked"
                                Content="DevTools"
                                Style="{StaticResource PiToolbarButtonStyle}" />
                            <Button
                                automation:AutomationProperties.AutomationId="PreviewImportCookiesButton"
                                Click="OnPreviewImportCookiesClicked"
                                Content="Import cookies…"
                                Style="{StaticResource PiToolbarButtonStyle}" />
                            <Button
                                x:Name="PreviewRecordingButton"
                                automation:AutomationProperties.AutomationId="PreviewRecordingButton"
                                Click="OnPreviewRecordingClicked"
                                Content="{x:Bind ViewModel.WorkbenchPreview.RecordingLabel, Mode=OneWay}"
                                Style="{StaticResource PiToolbarButtonStyle}" />
                            <Button
                                x:Name="PreviewPictureInPictureButton"
                                automation:AutomationProperties.AutomationId="PreviewPictureInPictureButton"
                                Click="OnPreviewPictureInPictureClicked"
                                Content="Picture in picture"
                                Style="{StaticResource PiToolbarButtonStyle}" />
                            <ComboBox
                                x:Name="PreviewAutomationPermissionSelector"
                                Width="148"
                                automation:AutomationProperties.AutomationId="PreviewAutomationPermissionSelector"
                                automation:AutomationProperties.Name="Agent browser automation permission"
                                SelectedIndex="{x:Bind ViewModel.WorkbenchPreview.AutomationPermissionIndex, Mode=OneWay}"
                                SelectionChanged="OnPreviewAutomationPermissionSelectionChanged">
                                <x:String>Agent access off</x:String>
                                <x:String>Agent inspect only</x:String>
                                <x:String>Agent interact</x:String>
                            </ComboBox>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid
                            Grid.Row="4"
                            Margin="10,0,10,4"
                            ColumnSpacing="6"
                            Visibility="{x:Bind ViewModel.WorkbenchPreview.CaptureStatusVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                            x:Name="PreviewCaptureStatusText"
                            automation:AutomationProperties.AutomationId="PreviewCaptureStatusText"
                            automation:AutomationProperties.LiveSetting="Polite"
                            FontSize="11"
                            Foreground="{ThemeResource PiTextMutedBrush}"
                            Text="{x:Bind ViewModel.WorkbenchPreview.CaptureStatus, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="RevealPreviewCaptureButton"
                                Grid.Column="1"
                                automation:AutomationProperties.AutomationId="RevealPreviewCaptureButton"
                                automation:AutomationProperties.Name="Open captured screenshot"
                                Click="OnRevealPreviewCaptureClicked"
                                Content="Open"
                                IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanRevealCapture, Mode=OneWay}"
                                Style="{StaticResource PiToolbarButtonStyle}" />
                        </Grid>

                        <Grid Grid.Row="5">
                            <ScrollViewer
                                x:Name="PreviewBrowserHost"
                                automation:AutomationProperties.AutomationId="PreviewBrowserHost"
                                HorizontalScrollBarVisibility="Auto"
                                SizeChanged="OnPreviewBrowserHostSizeChanged"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{x:Bind ViewModel.WorkbenchPreview.BrowserVisibility, Mode=OneWay}"
                                ZoomMode="Disabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.WorkbenchPreview.Tabs, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:WorkbenchPreviewTabViewModel">
                                            <Border
                                                Width="{x:Bind SurfaceWidth, Mode=OneWay}"
                                                Height="{x:Bind SurfaceHeight, Mode=OneWay}"
                                                MinWidth="240"
                                                MinHeight="240"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource PiCanvasBrush}"
                                                BorderBrush="{ThemeResource PiBorderStrongBrush}"
                                                BorderThickness="1"
                                                Visibility="{x:Bind SurfaceVisibility, Mode=OneWay}">
                                                <local:PreviewWebViewSurface
                                                    Tag="{x:Bind TabId}"
                                                    Loaded="OnPreviewBrowserLoaded"
                                                    Unloaded="OnPreviewBrowserUnloaded" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{x:Bind ViewModel.WorkbenchPreview.EmptyStateVisibility, Mode=OneWay}">
                                <StackPanel
                                    Margin="24"
                                    MaxWidth="320"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="26"
                                        Foreground="{ThemeResource PiTextMutedBrush}"
                                        Glyph="&#xE774;" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource PiPanelHeaderTextStyle}"
                                        Text="No preview yet" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                                        Text="Enter an address above or run a local development server."
                                        TextAlignment="Center"
                                        TextWrapping="WrapWholeWords" />
                                    <Grid Margin="0,8,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource PiSectionLabelTextStyle}"
                                            Text="LOCAL SERVERS" />
                                        <Button
                                            x:Name="PreviewRefreshServersButton"
                                            Grid.Column="1"
                                            automation:AutomationProperties.AutomationId="PreviewRefreshServersButton"
                                            automation:AutomationProperties.Name="Refresh local preview servers"
                                            Click="OnPreviewRefreshServersClicked"
                                            IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanDiscover, Mode=OneWay}"
                                            Style="{StaticResource PiToolbarIconButtonStyle}"
                                            ToolTipService.ToolTip="Refresh local servers">
                                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                        </Button>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            IsActive="{x:Bind ViewModel.WorkbenchPreview.IsDiscovering, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.WorkbenchPreview.DiscoveryProgressVisibility, Mode=OneWay}" />
                                        <TextBlock
                                            x:Name="PreviewDiscoveryStatusText"
                                            automation:AutomationProperties.AutomationId="PreviewDiscoveryStatusText"
                                            automation:AutomationProperties.LiveSetting="Polite"
                                            FontSize="{StaticResource PiFontSizeCaption}"
                                            Foreground="{ThemeResource PiTextMutedBrush}"
                                            Text="{x:Bind ViewModel.WorkbenchPreview.DiscoveryStatus, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords"
                                            Visibility="{x:Bind ViewModel.WorkbenchPreview.DiscoveryStatusVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                    <ListView
                                        x:Name="PreviewServerList"
                                        MaxHeight="280"
                                        automation:AutomationProperties.AutomationId="PreviewServerList"
                                        automation:AutomationProperties.Name="Local preview servers"
                                        IsItemClickEnabled="True"
                                        IsTabStop="False"
                                        ItemClick="OnPreviewServerClicked"
                                        ItemContainerStyle="{StaticResource PiSidebarListViewItemStyle}"
                                        ItemsSource="{x:Bind ViewModel.WorkbenchPreview.DiscoveredServers}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscoveredPreviewServer">
                                                <Grid MinHeight="44" Padding="4" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="{ThemeResource PiAccentBrush}"
                                                        Glyph="&#xE774;" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock
                                                            FontFamily="{StaticResource PiMonospaceFontFamily}"
                                                            Text="{x:Bind Url}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="{StaticResource PiFontSizeCaption}"
                                                            Foreground="{ThemeResource PiTextMutedBrush}"
                                                            Text="{x:Bind ProcessName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </ScrollViewer>

                            <Border
                                x:Name="PreviewFailureOverlay"
                                Margin="16"
                                Padding="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.AutomationId="PreviewFailureOverlay"
                                automation:AutomationProperties.Name="Preview unavailable"
                                Background="{ThemeResource PiSurfaceElevatedBrush}"
                                BorderBrush="{ThemeResource PiBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PiRadiusControl}"
                                Visibility="{x:Bind ViewModel.WorkbenchPreview.FailureVisibility, Mode=OneWay}">
                                <StackPanel MaxWidth="300" Spacing="10">
                                    <TextBlock
                                        Style="{StaticResource PiPanelHeaderTextStyle}"
                                        Text="Preview unavailable" />
                                    <TextBlock
                                        x:Name="PreviewFailureMessageText"
                                        automation:AutomationProperties.AutomationId="PreviewFailureMessageText"
                                        automation:AutomationProperties.LiveSetting="Assertive"
                                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                                        Text="{x:Bind ViewModel.WorkbenchPreview.FailureMessage, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="PreviewFailureReloadButton"
                                            automation:AutomationProperties.AutomationId="PreviewFailureReloadButton"
                                            automation:AutomationProperties.Name="Reload failed preview"
                                            Click="OnPreviewFailureReloadClicked"
                                            Content="Reload"
                                            IsEnabled="{x:Bind ViewModel.WorkbenchPreview.CanReloadOrStop, Mode=OneWay}" />
                                        <Button
                                            x:Name="PreviewReturnToServersButton"
                                            automation:AutomationProperties.AutomationId="PreviewReturnToServersButton"
                                            automation:AutomationProperties.Name="Return to local servers"
                                            Click="OnPreviewReturnToServersClicked"
                                            Content="Servers" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="AgentsWorkbenchSurface"
                        Padding="12"
                        automation:AutomationProperties.AutomationId="AgentsWorkbenchSurface"
                        automation:AutomationProperties.Name="Agents and workflows"
                        RowSpacing="10"
                        Visibility="{x:Bind ViewModel.Layout.AgentsPanelVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Agents &amp; workflows" />
                            <TextBlock
                                x:Name="AgentActivitySummaryText"
                                automation:AutomationProperties.AutomationId="AgentActivitySummaryText"
                                automation:AutomationProperties.LiveSetting="Polite"
                                FontSize="{StaticResource PiFontSizeCaption}"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="{x:Bind ViewModel.WorkbenchAgents.Summary, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                            <Expander Header="Run workflow" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                IsExpanded="{x:Bind ViewModel.Agents.LauncherExpanded, Mode=TwoWay}"
                                automation:AutomationProperties.AutomationId="AgentWorkflowExpander"
                                Visibility="{x:Bind ViewModel.Agents.Visibility, Mode=OneWay}">
                                <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8" Padding="2">
                                        <TextBlock automation:AutomationProperties.AutomationId="AgentSetupSummaryText"
                                            Text="{x:Bind ViewModel.Agents.SetupSummary, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                        <ComboBox Header="Workflow mode" HorizontalAlignment="Stretch"
                                            automation:AutomationProperties.AutomationId="AgentWorkflowModeComboBox"
                                            ItemsSource="{x:Bind ViewModel.Agents.Modes}"
                                            SelectedItem="{x:Bind ViewModel.Agents.Mode, Mode=TwoWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.Agents.WorkflowHint, Mode=OneWay}" TextWrapping="WrapWholeWords"
                                            FontSize="{StaticResource PiFontSizeCaption}" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Agents.Tasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:AgentTaskEditorViewModel">
                                                    <StackPanel Spacing="5" Margin="0,0,0,8">
                                                        <ComboBox Header="Agent preset" HorizontalAlignment="Stretch"
                                                            automation:AutomationProperties.AutomationId="AgentTaskPresetComboBox"
                                                            ItemsSource="{x:Bind PresetNames}" SelectedItem="{x:Bind Agent, Mode=TwoWay}" />
                                                        <TextBox Header="Delegated task" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="110" MaxLength="8192"
                                                            automation:AutomationProperties.AutomationId="AgentTaskTextBox"
                                                            Text="{x:Bind Task, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Content="Remove task" Click="OnRemoveAgentTaskClicked" Style="{StaticResource PiToolbarButtonStyle}"
                                                            automation:AutomationProperties.AutomationId="RemoveAgentTaskButton" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Add task" Click="OnAddAgentTaskClicked" automation:AutomationProperties.AutomationId="AddAgentTaskButton" />
                                            <Button Content="Run workflow" Click="OnRunAgentWorkflowClicked" IsEnabled="{x:Bind ViewModel.Agents.CanRun, Mode=OneWay}"
                                                automation:AutomationProperties.AutomationId="RunAgentWorkflowButton" />
                                        </StackPanel>
                                        <Expander Header="Agent setup and presets" HorizontalAlignment="Stretch"
                                            automation:AutomationProperties.AutomationId="AgentSetupExpander">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Refresh" Tag="inspect" Click="OnManageAgentsClicked" IsEnabled="{x:Bind ViewModel.Agents.CanManage, Mode=OneWay}"
                                                        automation:AutomationProperties.AutomationId="RefreshAgentSetupButton" />
                                                    <Button Content="{x:Bind ViewModel.Agents.ToggleLabel, Mode=OneWay}" Tag="{x:Bind ViewModel.Agents.ToggleAction, Mode=OneWay}"
                                                        Click="OnManageAgentsClicked" IsEnabled="{x:Bind ViewModel.Agents.CanManage, Mode=OneWay}"
                                                        automation:AutomationProperties.AutomationId="ToggleAgentIntegrationButton" />
                                                </StackPanel>
                                                <ComboBox Header="Edit a preset" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Agents.PresetNames}"
                                                    SelectedItem="{x:Bind ViewModel.Agents.SelectedPreset, Mode=TwoWay}" automation:AutomationProperties.AutomationId="EditAgentPresetComboBox" />
                                                <Button Content="New preset" Click="OnNewAgentPresetClicked" automation:AutomationProperties.AutomationId="NewAgentPresetButton" />
                                                <Button Content="Reload preset" Click="OnReloadAgentPresetClicked" automation:AutomationProperties.AutomationId="ReloadAgentPresetButton" />
                                                <TextBox Header="Name" MaxLength="40" Text="{x:Bind ViewModel.Agents.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="AgentPresetNameTextBox" />
                                                <TextBox Header="Description" MaxLength="240" Text="{x:Bind ViewModel.Agents.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="AgentPresetDescriptionTextBox" />
                                                <TextBox Header="Instructions" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="140" MaxLength="8192"
                                                    Text="{x:Bind ViewModel.Agents.Instructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="AgentPresetInstructionsTextBox" />
                                                <TextBox Header="Tools (comma separated)" Text="{x:Bind ViewModel.Agents.Tools, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="AgentPresetToolsTextBox" />
                                                <TextBlock Text="Supported tools: read, grep, find, ls, bash, powershell (Windows), edit, write. Dedicated host tool restrictions also apply to child presets." TextWrapping="WrapWholeWords" FontSize="{StaticResource PiFontSizeCaption}" />
                                                <TextBox Header="Model (optional provider/model)" MaxLength="240" PlaceholderText="Inherit from parent"
                                                    Text="{x:Bind ViewModel.Agents.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="AgentPresetModelTextBox" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Save preset" Tag="save" Click="OnManageAgentsClicked" IsEnabled="{x:Bind ViewModel.Agents.CanManage, Mode=OneWay}" automation:AutomationProperties.AutomationId="SaveAgentPresetButton" />
                                                    <Button Content="Delete preset" Tag="delete" Click="OnManageAgentsClicked" IsEnabled="{x:Bind ViewModel.Agents.CanManage, Mode=OneWay}" automation:AutomationProperties.AutomationId="DeleteAgentPresetButton" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Expander>
                            <TextBlock Text="{x:Bind ViewModel.Agents.Status, Mode=OneWay}" TextWrapping="WrapWholeWords"
                                automation:AutomationProperties.AutomationId="AgentWorkflowStatusText" automation:AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="AgentActivityList"
                                automation:AutomationProperties.AutomationId="AgentActivityList"
                                automation:AutomationProperties.Name="Agent and workflow activity"
                                ItemsSource="{x:Bind ViewModel.WorkbenchAgents.Activities, Mode=OneWay}"
                                SelectionMode="None"
                                Visibility="{x:Bind ViewModel.WorkbenchAgents.ActivityVisibility, Mode=OneWay}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:AgentActivityRowViewModel">
                                        <Border
                                            Margin="{x:Bind IndentMargin, Mode=OneWay}"
                                            Padding="10"
                                            automation:AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                            Style="{StaticResource PiElevatedSurfaceStyle}">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="{StaticResource PiFontSizeCaption}"
                                                            Foreground="{ThemeResource PiTextMutedBrush}"
                                                            Text="{x:Bind KindLabel, Mode=OneWay}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="{StaticResource PiFontSizeCaption}"
                                                        Foreground="{ThemeResource PiAccentBrush}"
                                                        Text="{x:Bind StateLabel, Mode=OneWay}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        automation:AutomationProperties.AutomationId="InterruptAgentButton"
                                                        automation:AutomationProperties.Name="{x:Bind InterruptLabel, Mode=OneWay}"
                                                        Click="OnInterruptAgentClicked"
                                                        Content="{x:Bind InterruptLabel, Mode=OneWay}"
                                                        IsEnabled="{x:Bind CanInterrupt, Mode=OneWay}"
                                                        Style="{StaticResource PiToolbarButtonStyle}"
                                                        ToolTipService.ToolTip="{x:Bind InterruptLabel, Mode=OneWay}"
                                                        Visibility="{x:Bind InterruptVisibility, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock
                                                    FontSize="{StaticResource PiFontSizeCaption}"
                                                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                                                    Text="{x:Bind CurrentActivity, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock
                                                    FontSize="{StaticResource PiFontSizeCaption}"
                                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                                    Text="{x:Bind Metrics, Mode=OneWay}" />
                                                <TextBlock
                                                    FontFamily="{StaticResource PiMonospaceFontFamily}"
                                                    FontSize="{StaticResource PiFontSizeCaption}"
                                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                                    Text="{x:Bind ModelSummary, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{x:Bind ModelVisibility, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="{StaticResource PiFontSizeCaption}"
                                                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                                                    Text="{x:Bind Task, Mode=OneWay}"
                                                    Visibility="{x:Bind TaskVisibility, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords" />
                                                <Button Content="View transcript" Click="OnAgentDetailsClicked" HorizontalAlignment="Left"
                                                    Visibility="{x:Bind DetailsVisibility, Mode=OneWay}"
                                                    automation:AutomationProperties.AutomationId="AgentDetailsButton" />
                                                <TextBlock
                                                    FontSize="{StaticResource PiFontSizeCaption}"
                                                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                                                    Text="{x:Bind ResultSummary, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{x:Bind ResultVisibility, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="{StaticResource PiFontSizeCaption}"
                                                    Foreground="{ThemeResource PiCriticalBrush}"
                                                    Text="{x:Bind FailureSummary, Mode=OneWay}"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{x:Bind FailureVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel
                                Margin="24"
                                MaxWidth="300"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Visibility="{x:Bind ViewModel.WorkbenchAgents.EmptyVisibility, Mode=OneWay}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="26"
                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                    Glyph="&#xE716;" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource PiPanelHeaderTextStyle}" Text="No agent activity yet" />
                                <TextBlock
                                    x:Name="AgentEmptyStateText"
                                    HorizontalAlignment="Center"
                                    automation:AutomationProperties.AutomationId="AgentEmptyStateText"
                                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                                    Text="Subagents and workflows started by Pi will appear here with live status, usage, and results."
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
