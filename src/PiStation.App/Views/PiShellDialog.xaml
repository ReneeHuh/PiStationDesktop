<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PiStation.App.Views.PiShellDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pi shell" CloseButtonText="Close"
    AutomationProperties.AutomationId="PiShellDialog">
    <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" MinWidth="320" MaxWidth="640">
            <TextBlock Text="Run a command with Pi's shell in this thread's workspace. Your message draft stays separate." TextWrapping="Wrap" />
            <TextBox Header="Command" Text="{x:Bind ViewModel.PiShell.CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True" TextWrapping="Wrap" MaxLength="32768" MaxHeight="120"
                IsReadOnly="{x:Bind ViewModel.PiShell.IsInputReadOnly, Mode=OneWay}"
                AutomationProperties.AutomationId="PiShellCommandInput" />
            <CheckBox Content="Include output in the next prompt's context"
                IsChecked="{x:Bind ViewModel.PiShell.IncludeInContext, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.PiShell.CanEdit, Mode=OneWay}"
                AutomationProperties.AutomationId="PiShellIncludeContext" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Run command" Click="OnRun" IsEnabled="{x:Bind ViewModel.PiShell.CanRun, Mode=OneWay}"
                    AutomationProperties.AutomationId="PiShellRunButton" Style="{StaticResource PiPrimaryButtonStyle}" />
                <Button Content="Cancel command" Click="OnCancel" IsEnabled="{x:Bind ViewModel.PiShell.CanCancel, Mode=OneWay}"
                    AutomationProperties.AutomationId="PiShellCancelButton" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.PiShell.Notice, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="Latest command" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.PiShell.LastCommand, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock Text="{x:Bind ViewModel.PiShell.ResultSummary, Mode=OneWay}" TextWrapping="Wrap"
                AutomationProperties.AutomationId="PiShellResultStatus" AutomationProperties.LiveSetting="Polite" />
            <TextBox Text="{x:Bind ViewModel.PiShell.Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                TextWrapping="Wrap" MinHeight="100" MaxHeight="240" FontFamily="Consolas"
                AutomationProperties.Name="Shell output" AutomationProperties.AutomationId="PiShellOutput" />
            <TextBlock Text="Closing this window leaves a running command active. Open Pi shell again to view or cancel it."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
