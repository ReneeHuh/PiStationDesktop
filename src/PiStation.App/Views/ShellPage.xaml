<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PiStation.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:PiStation.App.Views.Controls"
    xmlns:models="using:PiStation.Protocol.Models"
    xmlns:viewModels="using:PiStation.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{ThemeResource PiSansFontFamily}"
    mc:Ignorable="d">

    <Grid x:Name="PageLayoutGrid" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PageResponsiveStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConversationTimelineHost.Margin" Value="12,8,12,0" />
                        <Setter Target="RecoveryBannerHost.Margin" Value="12,0" />
                        <Setter Target="ComposerSurfaceHost.Margin" Value="12,8,12,0" />
                        <Setter Target="WorkspaceStatusBarHost.Margin" Value="12,0,12,4" />
                        <Setter Target="SettingsShell.MinWidth" Value="0" />
                        <Setter Target="ProjectDialogContent.MinWidth" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConversationTimelineHost.Margin" Value="16,10,16,0" />
                        <Setter Target="RecoveryBannerHost.Margin" Value="16,0" />
                        <Setter Target="ComposerSurfaceHost.Margin" Value="16,8,16,0" />
                        <Setter Target="WorkspaceStatusBarHost.Margin" Value="16,0,16,6" />
                        <Setter Target="SettingsShell.MinWidth" Value="0" />
                        <Setter Target="ProjectDialogContent.MinWidth" Value="340" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StandardLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConversationTimelineHost.Margin" Value="20,12,20,0" />
                        <Setter Target="RecoveryBannerHost.Margin" Value="20,0" />
                        <Setter Target="ComposerSurfaceHost.Margin" Value="20,10,20,0" />
                        <Setter Target="WorkspaceStatusBarHost.Margin" Value="20,0,20,8" />
                        <Setter Target="SettingsShell.MinWidth" Value="0" />
                        <Setter Target="ProjectDialogContent.MinWidth" Value="380" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConversationTimelineHost.Margin" Value="24,12,24,0" />
                        <Setter Target="RecoveryBannerHost.Margin" Value="24,0" />
                        <Setter Target="ComposerSurfaceHost.Margin" Value="24,10,24,0" />
                        <Setter Target="WorkspaceStatusBarHost.Margin" Value="24,0,24,8" />
                        <Setter Target="SettingsShell.MinWidth" Value="0" />
                        <Setter Target="ProjectDialogContent.MinWidth" Value="380" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:WorkspaceShell x:Name="ShellLayout">
            <controls:WorkspaceShell.MainContent>
                <Grid Background="{ThemeResource PiCanvasBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl
                        x:Name="ConversationTimelineHost"
                        MaxWidth="{StaticResource PiReadingColumnWidth}"
                        Margin="24,12,24,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

                    <StackPanel Grid.Row="1" Spacing="6">
                        <Expander Header="{x:Bind ViewModel.Plan.Heading, Mode=OneWay}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            MaxWidth="{StaticResource PiReadingColumnWidth}" Margin="24,0" Visibility="{x:Bind ViewModel.Plan.Visibility, Mode=OneWay}" automation:AutomationProperties.AutomationId="PiPlanPanel" automation:AutomationProperties.Name="{x:Bind ViewModel.Plan.Heading, Mode=OneWay}">
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.Plan.Policy, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="PiPlanPolicyText" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Plan mode" Tag="plan" Click="OnPlanActionClicked" IsEnabled="{x:Bind ViewModel.Plan.CanChangeMode, Mode=OneWay}" automation:AutomationProperties.AutomationId="StartPlanningButton" />
                                        <Button Content="Refresh" Tag="inspect" Click="OnPlanActionClicked" IsEnabled="{x:Bind ViewModel.Plan.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="RefreshPlanButton" />
                                    </StackPanel>
                                    <TextBox Header="Review or edit the numbered plan" Text="{x:Bind ViewModel.Plan.EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="160" MaxLength="32768" IsEnabled="{x:Bind ViewModel.Plan.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="PiPlanEditor" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save plan" Click="OnPlanActionClicked" Tag="save" IsEnabled="{x:Bind ViewModel.Plan.CanSave, Mode=OneWay}" automation:AutomationProperties.AutomationId="SavePlanButton" />
                                        <Button Content="Reload saved plan" Click="OnReloadPlanClicked" IsEnabled="{x:Bind ViewModel.Plan.CanAct, Mode=OneWay}" />
                                        <Button Content="Export" Click="OnExportPlanClicked" IsEnabled="{x:Bind ViewModel.Plan.CanExport, Mode=OneWay}" automation:AutomationProperties.AutomationId="ExportPlanButton" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.Plan.Progress, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PiPlanProgressText" />
                                    <Button Content="Approve and execute remaining steps" Tag="execute" Click="OnPlanActionClicked" IsEnabled="{x:Bind ViewModel.Plan.CanExecute, Mode=OneWay}" automation:AutomationProperties.AutomationId="ExecutePlanButton" />
                                    <TextBlock Text="Use Stop in the composer to interrupt execution. Completed steps are reported by the agent." TextWrapping="Wrap" />
                                    <Button Content="Return to normal tools" Tag="off" Click="OnPlanActionClicked" IsEnabled="{x:Bind ViewModel.Plan.CanChangeMode, Mode=OneWay}" automation:AutomationProperties.AutomationId="LeavePlanningButton" />
                                    <TextBlock Text="{x:Bind ViewModel.Plan.Status, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="PiPlanStatusText" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                        <Expander Header="{x:Bind ViewModel.ExtensionUi.Heading, Mode=OneWay}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            MaxWidth="{StaticResource PiReadingColumnWidth}" Margin="24,0" Visibility="{x:Bind ViewModel.ExtensionUi.PanelVisibility, Mode=OneWay}" automation:AutomationProperties.AutomationId="PiExtensionPanel">
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.ExtensionUi.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind ViewModel.ExtensionUi.Notifications, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind ViewModel.ExtensionUi.AboveWidgets, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <StackPanel Visibility="{x:Bind ViewModel.ExtensionUi.SuggestionVisibility, Mode=OneWay}" Spacing="4">
                                        <TextBlock Text="Suggested draft text" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.ExtensionUi.SuggestedText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" MaxHeight="80" />
                                        <Button Content="Insert into draft" Click="OnInsertExtensionTextClicked" automation:AutomationProperties.AutomationId="InsertExtensionTextButton" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                        <InfoBar IsOpen="{x:Bind ViewModel.RequiresPiSetup, Mode=OneWay}" IsClosable="False" Severity="Informational"
                            Title="Set up Pi" Message="Choose the Pi executable in Settings to start your first task.">
                            <InfoBar.ActionButton><Button Content="Set up Pi" Click="OnOpenPiSetupClicked" /></InfoBar.ActionButton>
                        </InfoBar>
                    <ContentControl
                        x:Name="RecoveryBannerHost"
                        MaxWidth="{StaticResource PiReadingColumnWidth}"
                        Margin="24,0"
                        HorizontalContentAlignment="Stretch" />
                    </StackPanel>

                    <ContentControl
                        x:Name="ComposerSurfaceHost"
                        Grid.Row="2"
                        MaxWidth="{StaticResource PiReadingColumnWidth}"
                        Margin="24,10,24,0"
                        HorizontalContentAlignment="Stretch" />

                    <StackPanel Grid.Row="3">
                        <ScrollViewer MaxHeight="100" MaxWidth="{StaticResource PiReadingColumnWidth}" Margin="24,4,24,0" Visibility="{x:Bind ViewModel.ExtensionUi.BelowVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ExtensionUi.BelowWidgets, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PiExtensionBelowWidget" />
                        </ScrollViewer>
                    <ContentControl
                        x:Name="WorkspaceStatusBarHost"
                        MaxWidth="{StaticResource PiReadingColumnWidth}"
                        Margin="24,0,24,8"
                        HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </controls:WorkspaceShell.MainContent>
        </controls:WorkspaceShell>

        <ContentDialog
            x:Name="CommandPaletteDialog"
            automation:AutomationProperties.AutomationId="CommandPaletteDialog"
            Closed="OnCommandPaletteClosed"
            CloseButtonText="Close"
            DefaultButton="None"
            Title="Command Palette">
            <Grid MinWidth="620" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="CommandPaletteQuery"
                    automation:AutomationProperties.AutomationId="CommandPaletteQuery"
                    automation:AutomationProperties.Name="Search commands and workspace"
                    KeyDown="OnCommandPaletteQueryKeyDown"
                    PlaceholderText="Search commands, projects, branches, messages, and threads…"
                    Style="{StaticResource PiTextBoxStyle}"
                    TextChanged="OnCommandPaletteQueryChanged" />
                <ProgressBar
                    x:Name="CommandPaletteProgress"
                    Grid.Row="1"
                    Height="2"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
                <ListView
                    x:Name="CommandPaletteResults"
                    Grid.Row="2"
                    MaxHeight="430"
                    automation:AutomationProperties.AutomationId="CommandPaletteResults"
                    IsItemClickEnabled="True"
                    ItemClick="OnCommandPaletteResultClicked"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                MinHeight="54"
                                Padding="8,6"
                                ColumnSpacing="12"
                                Opacity="{Binding ResultOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{ThemeResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                    Text="{Binding KindLabel}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource PiTextPrimaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MaxLines="2"
                                        FontSize="{ThemeResource PiFontSizeCaption}"
                                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Border
                                    Grid.Column="2"
                                    Padding="7,3"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource PiControlSurfaceBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                        FontSize="{ThemeResource PiFontSizeCaption}"
                                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                                        Text="{Binding ShortcutLabel}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="3" Spacing="6">
                <Button x:Name="CommandPaletteLoadMore" Content="Load more search results"
                    automation:AutomationProperties.AutomationId="CommandPaletteLoadMore"
                    Click="OnCommandPaletteLoadMore" Visibility="Collapsed" />
                <TextBlock
                    x:Name="CommandPaletteStatusText"
                    automation:AutomationProperties.AutomationId="CommandPaletteStatusText"
                    FontSize="{ThemeResource PiFontSizeCaption}"
                    Foreground="{ThemeResource PiTextMutedBrush}"
                    Text="Type &gt; to search commands only. Use Up, Down, and Enter to navigate."
                    TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ContentDialog>

        <controls:SettingsPageSurface
            x:Name="SettingsDialog"
            automation:AutomationProperties.AutomationId="SettingsDialog"
            Closed="OnSettingsDialogClosed"
            Title="Settings">
            <NavigationView
                x:Name="SettingsNavigation"
                MinWidth="0"
                CompactPaneLength="48"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                OpenPaneLength="256"
                PaneDisplayMode="Left"
                SelectionChanged="OnSettingsNavigationSelectionChanged">
                <NavigationView.PaneHeader>
                    <AutoSuggestBox x:Name="SettingsSearch" PlaceholderText="Search settings" Margin="8,4" QueryIcon="Find"
                        TextChanged="OnSettingsSearchChanged" automation:AutomationProperties.Name="Search settings" />
                </NavigationView.PaneHeader>
                <NavigationView.MenuItems>
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsGeneralNavItem" Content="General" Tag="General" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsProjectsNavItem" Content="Projects" Tag="Projects" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsRuntimeNavItem" Content="Pi / runtime" Tag="PiRuntime" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsPiResourcesNavItem" Content="Pi resources" Tag="PiResources" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsPiSessionsNavItem" Content="Sessions" Tag="PiSessions" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsSourceControlNavItem" Content="Source control" Tag="SourceControl" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsAppearanceNavItem" Content="Appearance" Tag="Appearance" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsIntegrationsNavItem" Content="Integrations" Tag="Integrations" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsDiagnosticsNavItem" Content="Diagnostics" Tag="Diagnostics" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsUsageNavItem" Content="Usage" Tag="Usage" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsLimitsNavItem" Content="Limits" Tag="Limits" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsUpdatesNavItem" Content="Updates" Tag="Updates" />
                </NavigationView.MenuItems>
                <NavigationView.Content>
            <ScrollViewer VerticalScrollBarVisibility="Auto" automation:AutomationProperties.AutomationId="SettingsContentScroll">
                <StackPanel
                    x:Name="SettingsShell"
                    MinWidth="0" MaxWidth="920" Margin="24,16,24,32" HorizontalAlignment="Stretch"
                    automation:AutomationProperties.AutomationId="SettingsShell"
                    automation:AutomationProperties.Name="Pi Station settings"
                    Spacing="12">
                    <TextBlock
                        Tag="Appearance"
                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                        Text="Configure Pi Station appearance, workspace, and connections."
                        TextWrapping="Wrap" />

                    <Border Tag="General" Style="{StaticResource PiElevatedSurfaceStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Automatic thread settlement" FontWeight="SemiBold" />
                            <CheckBox Content="Settle inactive threads" IsChecked="{x:Bind ViewModel.Settings.AutoSettleInactive, Mode=TwoWay}" />
                            <NumberBox Header="Days of inactivity (1–365)" Minimum="1" Maximum="365" Value="{x:Bind ViewModel.Settings.AutoSettleDays, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Settings.AutoSettleInactive, Mode=OneWay}" automation:AutomationProperties.AutomationId="AutoSettleDaysInput" />
                            <CheckBox Content="Settle idle threads when their PR merges" IsChecked="{x:Bind ViewModel.Settings.AutoSettleMerged, Mode=TwoWay}" />
                            <CheckBox Content="Settle idle threads when their PR closes" IsChecked="{x:Bind ViewModel.Settings.AutoSettleClosed, Mode=TwoWay}" />
                            <TextBlock Text="Checked every minute while PiStation is open. Active tasks and approvals are protected. Un-settle keeps a thread active until its next task. Saving rules does not reopen settled threads." TextWrapping="Wrap" />
                            <Button Content="Save settlement rules" Click="OnSaveSettlementSettingsClicked" automation:AutomationProperties.AutomationId="SaveSettlementSettingsButton" />
                            <TextBlock Text="{x:Bind ViewModel.Settings.Status, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <ContentControl x:Name="ThemeEditorHost" HorizontalContentAlignment="Stretch" />
                    </Border>
                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Typography and surfaces" />
                            <TextBlock Text="Enter installed font families, separated by commas. Leave blank for the default. Changes apply to this window immediately and are saved for new windows." TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <TextBox Header="Interface font" PlaceholderText="Default font" MaxLength="200" Text="{x:Bind ViewModel.Layout.InterfaceFontFamily, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceInterfaceFont" />
                                <NumberBox Grid.Column="1" Header="Size (px)" Minimum="12" Maximum="20" SmallChange="1" Value="{x:Bind ViewModel.Layout.InterfaceFontSize, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceInterfaceSize" automation:AutomationProperties.Name="Interface font size" />
                            </Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <TextBox Header="Composer font" PlaceholderText="Default font" MaxLength="200" Text="{x:Bind ViewModel.Layout.ComposerFontFamily, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceComposerFont" />
                                <NumberBox Grid.Column="1" Header="Size (px)" Minimum="12" Maximum="20" SmallChange="1" Value="{x:Bind ViewModel.Layout.ComposerFontSize, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceComposerSize" automation:AutomationProperties.Name="Composer font size" />
                            </Grid>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <TextBox Header="Code font" PlaceholderText="Default font" MaxLength="200" Text="{x:Bind ViewModel.Layout.CodeFontFamily, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceCodeFont" />
                                <NumberBox Grid.Column="1" Header="Size (px)" Minimum="10" Maximum="18" SmallChange="1" Value="{x:Bind ViewModel.Layout.CodeFontSize, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceCodeSize" automation:AutomationProperties.Name="Code font size" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Layout.AppearanceSummary, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="AppearanceSummary" />
                            <NumberBox Header="Contrast (%)" Minimum="50" Maximum="200" SmallChange="10" Value="{x:Bind ViewModel.Layout.AppearanceContrast, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceContrast" />
                            <NumberBox Header="Surface opacity (%)" Minimum="40" Maximum="100" SmallChange="10" Value="{x:Bind ViewModel.Layout.GlassOpacity, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceOpacity" />
                            <TextBlock Text="Lower opacity reveals the Windows backdrop. High Contrast uses the Windows palette; disabling transparency keeps surfaces opaque." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Editors and motion" />
                            <ToggleSwitch Header="Word wrap in files and diffs" IsOn="{x:Bind ViewModel.Layout.WordWrap, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceWordWrap" />
                            <ComboBox Header="Diff layout" SelectedIndex="{x:Bind ViewModel.Layout.DiffLayoutIndex, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceDiffLayout">
                                <ComboBoxItem Content="Unified" /><ComboBoxItem Content="Split" />
                            </ComboBox>
                            <ToggleSwitch Header="Ignore whitespace in workspace and checkpoint diffs" IsOn="{x:Bind ViewModel.Layout.DiffIgnoreWhitespace, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceIgnoreWhitespace" />
                            <NumberBox Header="Panel animation duration (ms)" Minimum="0" Maximum="400" SmallChange="25" Value="{x:Bind ViewModel.Layout.PanelAnimationDurationMs, Mode=TwoWay}" automation:AutomationProperties.AutomationId="AppearanceAnimation" />
                            <TextBlock Text="0 turns panel motion off. Windows reduced motion also disables animations." TextWrapping="Wrap" />
                            <Button Content="Reset appearance and editor preferences" Click="OnResetAppearanceClicked" automation:AutomationProperties.AutomationId="ResetAppearance" />
                        </StackPanel>
                    </Border>

                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sidebar" Style="{StaticResource PiPanelHeaderTextStyle}" />
                            <Button Content="Configure grouping and sorting…" Click="OnConfigureSidebar" />
                        </StackPanel>
                    </Border>
                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Appearance" />
                                <TextBlock
                                    x:Name="SettingsThemeStatusText"
                                    automation:AutomationProperties.AutomationId="SettingsThemeStatusText"
                                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Layout.ThemeSummary, Mode=OneWay}" />
                            </StackPanel>
                            <ComboBox
                                x:Name="PiThemeSelector"
                                Grid.Column="1"
                                MinWidth="116"
                                automation:AutomationProperties.AutomationId="PiThemeSelector"
                                automation:AutomationProperties.Name="Application theme"
                                SelectionChanged="OnThemeSelectionChanged"
                                Style="{StaticResource PiComboBoxStyle}">
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                                <ComboBoxItem Content="System" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                            </ComboBox>
                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="System follows Windows, including high contrast."
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Keyboard shortcuts" />
                            <TextBlock
                                x:Name="KeybindingSummaryText"
                                automation:AutomationProperties.AutomationId="KeybindingSummaryText"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <ComboBox
                                x:Name="KeybindingCommandSelector"
                                automation:AutomationProperties.AutomationId="KeybindingCommandSelector"
                                DisplayMemberPath="Title"
                                Header="Command"
                                SelectionChanged="OnKeybindingCommandSelectionChanged"
                                Style="{StaticResource PiComboBoxStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="KeybindingGestureInput"
                                    automation:AutomationProperties.AutomationId="KeybindingGestureInput"
                                    Header="Shortcut"
                                    PlaceholderText="Ctrl+K"
                                    Style="{StaticResource PiTextBoxStyle}" />
                                <TextBox
                                    x:Name="KeybindingWhenInput"
                                    Grid.Column="1"
                                    automation:AutomationProperties.AutomationId="KeybindingWhenInput"
                                    Header="When"
                                    PlaceholderText="projectOpen &amp;&amp; !terminalFocus"
                                    Style="{StaticResource PiTextBoxStyle}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="SaveKeybindingButton"
                                    automation:AutomationProperties.AutomationId="SaveKeybindingButton"
                                    Click="OnSaveKeybindingClicked"
                                    Content="Save shortcut"
                                    Style="{StaticResource PiPrimaryButtonStyle}" />
                                <Button
                                    x:Name="ResetAllKeybindingsButton"
                                    automation:AutomationProperties.AutomationId="ResetAllKeybindingsButton"
                                    Click="OnResetAllKeybindingsClicked"
                                    Content="Reset all"
                                    Style="{StaticResource PiSecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock
                                x:Name="KeybindingValidationText"
                                automation:AutomationProperties.AutomationId="KeybindingValidationText"
                                Foreground="{ThemeResource PiWaitingBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="KeybindingEmptyText"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="No custom overrides. Default shortcuts are active."
                                TextWrapping="Wrap" />
                            <ListView
                                x:Name="KeybindingOverridesList"
                                MaxHeight="180"
                                automation:AutomationProperties.AutomationId="KeybindingOverridesList"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="44" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding CommandTitle}" />
                                                <TextBlock
                                                    FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                                    FontSize="{ThemeResource PiFontSizeCaption}"
                                                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                                                    Text="{Binding Summary}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Click="OnResetKeybindingClicked"
                                                Content="Reset"
                                                Style="{StaticResource PiToolbarButtonStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="Conditions support !, &amp;&amp;, ||, and parentheses. Conflicting shortcuts with overlapping contexts are rejected."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Terminal" />
                            <TextBlock
                                x:Name="SettingsTerminalAppearanceStatusText"
                                Grid.Row="1"
                                automation:AutomationProperties.AutomationId="SettingsTerminalAppearanceStatusText"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.Layout.TerminalAppearanceSummary, Mode=OneWay}" />
                            <Grid Grid.Row="2" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="TerminalFontFamilySelector"
                                    MinWidth="170"
                                    automation:AutomationProperties.AutomationId="TerminalFontFamilySelector"
                                    automation:AutomationProperties.Name="Terminal font family"
                                    Header="Font family"
                                    SelectionChanged="OnTerminalFontFamilySelectionChanged"
                                    Style="{StaticResource PiComboBoxStyle}">
                                    <ComboBoxItem Content="Cascadia Mono" Tag="Cascadia Mono, Consolas" />
                                    <ComboBoxItem Content="Consolas" Tag="Consolas" />
                                    <ComboBoxItem Content="Cascadia Code" Tag="Cascadia Code" />
                                    <ComboBoxItem Content="CaskaydiaCove Nerd Font" Tag="CaskaydiaCove Nerd Font" />
                                    <ComboBoxItem Content="JetBrains Mono" Tag="JetBrains Mono" />
                                    <ComboBoxItem Content="Fira Code" Tag="Fira Code" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="TerminalFontSizeSelector"
                                    Grid.Column="1"
                                    automation:AutomationProperties.AutomationId="TerminalFontSizeSelector"
                                    automation:AutomationProperties.Name="Terminal font size"
                                    Header="Size"
                                    SelectionChanged="OnTerminalFontSizeSelectionChanged"
                                    Style="{StaticResource PiComboBoxStyle}">
                                    <ComboBoxItem Content="10 px" Tag="10" />
                                    <ComboBoxItem Content="11 px" Tag="11" />
                                    <ComboBoxItem Content="12 px" Tag="12" />
                                    <ComboBoxItem Content="13 px" Tag="13" />
                                    <ComboBoxItem Content="14 px" Tag="14" />
                                    <ComboBoxItem Content="16 px" Tag="16" />
                                    <ComboBoxItem Content="18 px" Tag="18" />
                                    <ComboBoxItem Content="20 px" Tag="20" />
                                </ComboBox>
                            </Grid>
                            <Button
                                x:Name="ResetTerminalAppearanceButton"
                                Grid.Row="3"
                                HorizontalAlignment="Left"
                                automation:AutomationProperties.AutomationId="ResetTerminalAppearanceButton"
                                automation:AutomationProperties.Name="Reset terminal appearance"
                                Click="OnResetTerminalAppearanceClicked"
                                Content="Reset terminal font"
                                Style="{StaticResource PiSecondaryButtonStyle}" />
                            <TextBlock
                                Grid.Row="4"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="Changes apply to open terminals immediately. Missing or proportional fonts fall back to the default monospace stack."
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Workspace layout" />
                            <TextBlock
                                x:Name="SettingsLayoutSummaryText"
                                Grid.Row="1"
                                automation:AutomationProperties.AutomationId="SettingsLayoutSummaryText"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.Layout.LayoutSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="ResetLayoutButton"
                                Grid.Row="2"
                                HorizontalAlignment="Left"
                                automation:AutomationProperties.AutomationId="ResetLayoutButton"
                                automation:AutomationProperties.Name="Reset workspace layout"
                                Click="OnResetLayoutClicked"
                                Content="Reset layout"
                                Style="{StaticResource PiSecondaryButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Shell and composer" />
                            <ComboBox Header="Close window shortcut (Ctrl+Q)" HorizontalAlignment="Stretch"
                                SelectedIndex="{x:Bind ViewModel.Layout.QuitConfirmationModeIndex, Mode=TwoWay}"
                                automation:AutomationProperties.AutomationId="QuitConfirmationModeSelector">
                                <ComboBoxItem Content="Close immediately" />
                                <ComboBoxItem Content="Hold for 1.2 seconds, then release" />
                                <ComboBoxItem Content="Press twice within half a second" />
                            </ComboBox>
                            <TextBlock Text="The title-bar close button and Alt+F4 work normally. Unsaved plan edits always require confirmation; drafts and file edits are preserved."
                                TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                            <ToggleSwitch Header="Open changes or linked PR details automatically" IsOn="{x:Bind ViewModel.Layout.ProactivePanelsEnabled, Mode=TwoWay}"
                                automation:AutomationProperties.AutomationId="ProactivePanelsToggle" />
                            <ToggleSwitch Header="Collapse resting composer when focus leaves" IsOn="{x:Bind ViewModel.Layout.ComposerCollapseOnBlur, Mode=TwoWay}"
                                automation:AutomationProperties.AutomationId="ComposerCollapseOnBlurToggle" />
                            <ToggleSwitch Header="Collapse resting composer when reading older messages" IsOn="{x:Bind ViewModel.Layout.ComposerCollapseOnScroll, Mode=TwoWay}"
                                automation:AutomationProperties.AutomationId="ComposerCollapseOnScrollToggle" />
                            <ToggleSwitch Header="Show skills in the slash menu" IsOn="{x:Bind ViewModel.Layout.ShowSkillsInSlashMenu, Mode=TwoWay}"
                                automation:AutomationProperties.AutomationId="ShowSkillsInSlashMenuToggle" />
                            <TextBlock Text="Skills remain available through $ search. Composer preferences keep your text, attachments, and context intact."
                                TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Tag="PiRuntime" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="{x:Bind ViewModel.EnvironmentLabel}" />
                            <TextBlock
                                x:Name="SettingsConnectionStatusText"
                                Grid.Row="1"
                                automation:AutomationProperties.AutomationId="SettingsConnectionStatusText"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.Connection.Status, Mode=OneWay}" />
                            <TextBlock
                                x:Name="SettingsProjectPathText"
                                Grid.Row="2"
                                automation:AutomationProperties.AutomationId="SettingsProjectPathText"
                                FontFamily="{ThemeResource PiMonospaceFontFamily}"
                                FontSize="{ThemeResource PiFontSizeCaption}"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="{x:Bind ViewModel.Workspace.ActiveProjectPath, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Workspace.ActiveProjectPath, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <ContentControl x:Name="RemoteConnectionsHost" HorizontalContentAlignment="Stretch" />

                    <Border
                        x:Name="ProjectsSettingsSection"
                        Tag="Projects"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Projects" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Workspace.ActiveProjectName, Mode=OneWay}" />
                            <TextBlock FontFamily="{ThemeResource PiMonospaceFontFamily}" FontSize="{ThemeResource PiFontSizeCaption}" Foreground="{ThemeResource PiTextMutedBrush}" Text="{x:Bind ViewModel.Workspace.ActiveProjectPath, Mode=OneWay}" TextWrapping="Wrap" />
                            <ComboBox x:Name="ProjectDefaultWorkspaceModeSelector" Header="Default thread workspace" Style="{StaticResource PiComboBoxStyle}">
                                <ComboBoxItem Content="Local" Tag="Local" />
                                <ComboBoxItem Content="Git worktree" Tag="Worktree" />
                            </ComboBox>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ProjectDefaultModelProviderInput" Header="Default model provider" PlaceholderText="openai" TextChanged="OnProjectModelDefaultsChanged" Style="{StaticResource PiTextBoxStyle}" />
                                <TextBox x:Name="ProjectDefaultModelIdInput" Grid.Column="1" Header="Default model ID" PlaceholderText="model ID" TextChanged="OnProjectModelDefaultsChanged" Style="{StaticResource PiTextBoxStyle}" />
                            </Grid>
                            <ComboBox x:Name="ProjectDefaultThinkingSelector" Header="Default reasoning level" Style="{StaticResource PiComboBoxStyle}">
                                <ComboBoxItem Content="Runtime default" Tag="" />
                                <ComboBoxItem Content="Off" Tag="Off" />
                                <ComboBoxItem Content="Minimal" Tag="Minimal" />
                                <ComboBoxItem Content="Low" Tag="Low" />
                                <ComboBoxItem Content="Medium" Tag="Medium" />
                                <ComboBoxItem Content="High" Tag="High" />
                                <ComboBoxItem Content="Extra high" Tag="XHigh" />
                                <ComboBoxItem Content="Maximum" Tag="Max" />
                            </ComboBox>
                            <TextBlock Text="Reasoning levels depend on the selected model. Pi validates the default when starting a thread." TextWrapping="Wrap" />
                            <ComboBox x:Name="ProjectPermissionSelector" Header="Default tool permission mode" DisplayMemberPath="DisplayName" />
                            <ToggleSwitch x:Name="ProjectAutoPullToggle" Header="Automatically fast-forward the clean default branch when Pi Station starts" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnSaveProjectDefaultsClicked" Content="Save defaults" Style="{StaticResource PiPrimaryButtonStyle}" />
                                <Button Click="OnRemoveProjectClicked" Content="Remove project" Style="{StaticResource PiSecondaryButtonStyle}" />
                                <Button automation:AutomationProperties.AutomationId="CustomizeProjectButton" Click="OnCustomizeProjectClicked" Content="Icon and scripts…" Style="{StaticResource PiSecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="Project icons are loaded from iconPath in t3.json, then common favicon locations. Named t3.json scripts appear in the Add menu." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="RuntimeSettingsSection"
                        Tag="PiRuntime"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Pi and runtime" />
                            <TextBlock Text="Shared Pi automation preferences" FontWeight="SemiBold" />
                            <TextBlock Text="Overrides apply to all PiStation threads before their next turn. Pi writes these values to its shared settings file, which other Pi clients may also use. Clearing an override leaves Pi's current value unchanged; it does not restore an earlier value. Child-agent presets retain their own retry/compaction policy." TextWrapping="Wrap" />
                            <CheckBox Content="Manage auto-compaction" IsChecked="{x:Bind ViewModel.Settings.ManageAutoCompaction, Mode=TwoWay}" automation:AutomationProperties.AutomationId="ManageAutoCompactionToggle" />
                            <CheckBox Content="Enable automatic compaction" IsChecked="{x:Bind ViewModel.Settings.AutoCompaction, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Settings.ManageAutoCompaction, Mode=OneWay}" />
                            <CheckBox Content="Manage auto-retry" IsChecked="{x:Bind ViewModel.Settings.ManageAutoRetry, Mode=TwoWay}" automation:AutomationProperties.AutomationId="ManageAutoRetryToggle" />
                            <CheckBox Content="Enable automatic retry" IsChecked="{x:Bind ViewModel.Settings.AutoRetry, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Settings.ManageAutoRetry, Mode=OneWay}" />
                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2">
                                <Button Content="Reload preferences" Click="OnReloadPiAutomationClicked" />
                                <Button Content="Save preferences" Click="OnSavePiAutomationClicked" automation:AutomationProperties.AutomationId="SavePiAutomationButton" />
                                <Button Content="Apply saved preferences to idle runtime" Click="OnApplyPiAutomationClicked" />
                                <Button Content="Refresh runtime status" Click="OnRefreshPiAutomationClicked" />
                            </WrapGrid>
                            <TextBlock Text="{x:Bind ViewModel.Settings.AutomationStatus, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Settings.RuntimeSetupStatus, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBox x:Name="PiExecutablePathInput" automation:AutomationProperties.AutomationId="PiExecutablePathInput" Header="{x:Bind ViewModel.PiExecutablePathHeader}" IsEnabled="{x:Bind ViewModel.CanConfigurePiRuntime, Mode=OneWay}" PlaceholderText="Leave empty to discover Pi on PATH" Text="{x:Bind ViewModel.Settings.PiExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PiTextBoxStyle}" />
                            <CheckBox Content="Discover installed Pi extensions" IsEnabled="{x:Bind ViewModel.CanConfigurePiRuntime, Mode=OneWay}" IsChecked="{x:Bind ViewModel.Settings.DiscoverPiExtensions, Mode=TwoWay}" automation:AutomationProperties.AutomationId="DiscoverPiExtensionsToggle" />
                            <Button Content="Reload host runtime settings" Click="OnReloadPiRuntimeClicked" IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" />
                            <Expander Header="Cache, telemetry and startup networking" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanConfigurePiRuntime, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Host preferences for new or restarted runtimes (Pi 0.85.0+). Inherit preserves raw launch settings and Pi defaults. Offline skips startup catalog/version refresh; it does not block model requests. Long cache retention is provider-specific." TextWrapping="Wrap" />
                                    <ComboBox Header="Prompt cache retention" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.Settings.RuntimePreferences.CacheIndex, Mode=TwoWay}" automation:AutomationProperties.AutomationId="PiCachePreference"><ComboBoxItem Content="Inherit" /><ComboBoxItem Content="Long" /><ComboBoxItem Content="Provider default" /></ComboBox>
                                    <ComboBox Header="Install telemetry" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.Settings.RuntimePreferences.TelemetryIndex, Mode=TwoWay}" automation:AutomationProperties.AutomationId="PiTelemetryPreference"><ComboBoxItem Content="Inherit" /><ComboBoxItem Content="Enabled" /><ComboBoxItem Content="Disabled" /></ComboBox>
                                    <ComboBox Header="Offline startup" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.Settings.RuntimePreferences.OfflineIndex, Mode=TwoWay}" automation:AutomationProperties.AutomationId="PiOfflinePreference"><ComboBoxItem Content="Inherit" /><ComboBoxItem Content="Enabled" /><ComboBoxItem Content="Disabled" /></ComboBox>
                                    <ComboBox Header="Version checks" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.Settings.RuntimePreferences.VersionIndex, Mode=TwoWay}" automation:AutomationProperties.AutomationId="PiVersionPreference"><ComboBoxItem Content="Inherit" /><ComboBoxItem Content="Skip" /><ComboBoxItem Content="Allow" /></ComboBox>
                                    <TextBlock Text="Use Save and connect below, then restart idle threads. Refresh Pi resources to inspect the running environment." TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Agent tools and Windows PowerShell" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanConfigurePiRuntime, Mode=OneWay}"
                                automation:AutomationProperties.AutomationId="PiToolSettingsExpander">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Host settings for new/restarted runtimes (Pi 0.85.0+). Explicit allowlists include only the named built-in or extension tools; an empty allowlist enables none. Exclusions win, including equivalent planning readers. Existing threads keep their current policy until restarted."
                                        TextWrapping="Wrap" />
                                    <StackPanel Spacing="8">
                                        <ComboBox Header="Tool selection" HorizontalAlignment="Stretch"
                                            SelectedIndex="{x:Bind ViewModel.Settings.ToolSelection.ModeIndex, Mode=TwoWay}"
                                            automation:AutomationProperties.AutomationId="PiToolSelectionMode">
                                            <ComboBoxItem Content="Pi defaults / existing launch flags" />
                                            <ComboBoxItem Content="Only the listed tools" />
                                            <ComboBoxItem Content="No agent tools" />
                                        </ComboBox>
                                        <TextBox Header="Allowed tools (exact names, comma-separated or one per line)" AcceptsReturn="True" MinHeight="60" MaxHeight="160"
                                            IsEnabled="{x:Bind ViewModel.Settings.ToolSelection.IsAllowlist, Mode=OneWay}"
                                            Text="{x:Bind ViewModel.Settings.ToolSelection.Allowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            automation:AutomationProperties.AutomationId="PiAllowedToolsInput" />
                                        <TextBox Header="Excluded tools (exact names; no wildcards)" AcceptsReturn="True" MinHeight="48" MaxHeight="120"
                                            Text="{x:Bind ViewModel.Settings.ToolSelection.Excluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            automation:AutomationProperties.AutomationId="PiExcludedToolsInput" />
                                        <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2">
                                            <Button Content="Read/search preset" Click="OnReadOnlyToolsClicked" automation:AutomationProperties.AutomationId="PiReadOnlyToolsPreset" />
                                            <Button Content="Windows coding preset" Click="OnWindowsToolsClicked" automation:AutomationProperties.AutomationId="PiWindowsToolsPreset" />
                                            <Button Content="Add PowerShell to allowlist" Click="OnAddPowerShellToolClicked"
                                                IsEnabled="{x:Bind ViewModel.Settings.ToolSelection.IsAllowlist, Mode=OneWay}" automation:AutomationProperties.AutomationId="PiAddPowerShellTool" />
                                        </WrapGrid>
                                        <TextBlock Text="Presets fill the allowlist without clearing exclusions. Save and connect below, restart each idle thread, then refresh its inventory. Remove conflicting --tools/--exclude-tools flags from advanced arguments when using these controls."
                                            TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Text="PowerShell requires a Windows host with pwsh.exe or powershell.exe. Dedicated restrictions also intersect PiStation child-agent presets. This is tool selection, not an OS sandbox: trusted extension code and user-run shell/terminal commands are separate."
                                        TextWrapping="Wrap" FontSize="12" />
                                    <Button Content="Refresh selected thread's tool inventory" Click="OnRefreshPiResourcesClicked" HorizontalAlignment="Left"
                                        IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" automation:AutomationProperties.AutomationId="RefreshPiToolsButton" />
                                    <TextBlock Text="{x:Bind ViewModel.PiResources.Status, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.PiResources.ToolInventory.Summary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                        automation:AutomationProperties.AutomationId="PiToolInventorySummary" />
                                    <TextBlock Text="{x:Bind ViewModel.PiResources.ToolInventory.PowerShell, Mode=OneWay}" TextWrapping="Wrap"
                                        automation:AutomationProperties.AutomationId="PiPowerShellToolStatus" />
                                    <ListView ItemsSource="{x:Bind ViewModel.PiResources.ToolInventory.Tools}" MaxHeight="280" SelectionMode="None"
                                        automation:AutomationProperties.AutomationId="PiToolInventoryList">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:PiToolRow">
                                                <StackPanel Spacing="2" Padding="4">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind State}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" MaxLines="3" FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Expander>
                            <Expander automation:AutomationProperties.AutomationId="AdvancedPiRuntimeExpander" Header="Advanced runtime settings" IsEnabled="{x:Bind ViewModel.CanConfigurePiRuntime, Mode=OneWay}" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBox automation:AutomationProperties.AutomationId="PiArgumentsInput" Header="Launch arguments (one argument per line)" Text="{x:Bind ViewModel.Settings.PiArguments, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" MaxHeight="180" />
                                    <TextBox automation:AutomationProperties.AutomationId="PiEnvironmentInput" Header="Environment variables (NAME=value; NAME alone removes an inherited variable)" Text="{x:Bind ViewModel.Settings.PiEnvironment, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" MaxHeight="180" />
                                    <NumberBox automation:AutomationProperties.AutomationId="PiCommandTimeoutInput" Header="Command timeout in seconds" Minimum="5" Maximum="600" Value="{x:Bind ViewModel.Settings.PiCommandTimeout, Mode=TwoWay}" />
                                    <NumberBox automation:AutomationProperties.AutomationId="PiShutdownTimeoutInput" Header="Shutdown timeout in seconds" Minimum="1" Maximum="30" Value="{x:Bind ViewModel.Settings.PiShutdownTimeout, Mode=TwoWay}" />
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="Discovery follows Pi's saved project trust decisions. Explicit paths below load code you choose to trust. The bundled browser extension stays available with its per-thread browser permission controls." TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                            <TextBox Header="Additional trusted extensions (one absolute host path per line)" IsEnabled="{x:Bind ViewModel.CanConfigurePiRuntime, Mode=OneWay}" Text="{x:Bind ViewModel.Settings.PiExtensionPaths, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" MaxHeight="160" TextWrapping="Wrap" Style="{StaticResource PiTextBoxStyle}" automation:AutomationProperties.AutomationId="PiExtensionPathsInput" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button automation:AutomationProperties.AutomationId="BrowsePiExecutableButton" Click="OnBrowsePiExecutableClicked" Content="{x:Bind ViewModel.PiExecutableBrowseLabel}" IsEnabled="{x:Bind ViewModel.CanConfigurePiRuntime, Mode=OneWay}" Style="{StaticResource PiSecondaryButtonStyle}" />
                                <Button automation:AutomationProperties.AutomationId="ConfigurePiRuntimeButton" Click="OnConfigurePiRuntimeClicked" Content="Save and connect" IsEnabled="{x:Bind ViewModel.CanConfigurePiRuntime, Mode=OneWay}" Style="{StaticResource PiPrimaryButtonStyle}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="RestartConfiguredPiButton" Click="OnRestartConfiguredPiClicked" Content="Restart selected thread" IsEnabled="{x:Bind ViewModel.CanRestartPi, Mode=OneWay}" Style="{StaticResource PiSecondaryButtonStyle}" />
                            <TextBlock Text="Install Pi, then select its executable or leave the path empty for automatic discovery. Authenticate your model provider using Pi in a terminal. Return here and choose Save and connect; you can retry without restarting Pi Station." TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind ViewModel.Connection.Status, Mode=OneWay}" />
                            <TextBlock Foreground="{ThemeResource PiTextMutedBrush}" Text="Project defaults seed the model, reasoning level, runtime mode, and workspace mode for new threads. Per-thread model and reasoning controls remain in the composer." TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Click="OnConfigurePiRuntimeClicked" Content="Recheck runtime" IsEnabled="{x:Bind ViewModel.CanConfigurePiRuntime, Mode=OneWay}" Style="{StaticResource PiSecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Tag="PiResources" Style="{StaticResource PiElevatedSurfaceStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="10" automation:AutomationProperties.AutomationId="PiResourcesSettingsPanel">
                            <TextBlock Text="Pi resources and providers" Style="{StaticResource PiPanelHeaderTextStyle}" />
                            <Expander Header="Extension compatibility" HorizontalAlignment="Stretch">
                                <TextBlock Text="Native Pi RPC supports dialogs, text editors, status messages, notifications, and text widgets. Terminal components, custom TUI editors, overlays, headers, and footers require Pi's terminal UI. Extensions that register no commands or tools cannot be confirmed loaded by RPC. Targeted external-agent controls require a stable child handle and a compatible control command from that extension." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Expander>
                            <TextBlock Text="{x:Bind ViewModel.PiResources.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PiResourcesStatusText" />
                            <Expander Header="Provider transport and runtime preferences" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Transport saves to this host user's Pi settings and affects future Pi sessions, including terminal sessions. Trusted project settings take precedence. Existing runtimes require restart." TextWrapping="Wrap" />
                                    <ComboBox Header="Saved user transport" SelectedIndex="{x:Bind ViewModel.PiResources.TransportIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}"><ComboBoxItem Content="Auto" /><ComboBoxItem Content="SSE" /><ComboBoxItem Content="WebSocket" /><ComboBoxItem Content="WebSocket cached" /></ComboBox>
                                    <Button Content="Save transport" Click="OnSavePiTransportClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.PiResources.NativeSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                            <Button Content="Refresh resources" Click="OnRefreshPiResourcesClicked" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="RefreshPiResourcesButton" />
                            <Button Content="Restart selected thread" Click="OnRestartConfiguredPiClicked" IsEnabled="{x:Bind ViewModel.CanRestartPi, Mode=OneWay}" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="RestartResourcePiButton" />
                            <Expander Header="Project and configuration folders" HorizontalAlignment="Stretch">
                                <TextBlock Text="{x:Bind ViewModel.PiResources.Directories, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                            </Expander>
                            <TextBlock Text="{x:Bind ViewModel.PiResources.TrustSummary, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="PiProjectTrustText" />
                            <TextBlock Text="Trust allows Pi to load this project's settings, extensions and skills, including executable code. Saved decisions apply after restarting Pi and remain subject to Pi's trust extensions." TextWrapping="Wrap" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Trust project" Click="OnTrustPiProjectClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}" automation:AutomationProperties.AutomationId="TrustPiProjectButton" />
                                <Button Content="Do not trust" Click="OnUntrustPiProjectClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}" automation:AutomationProperties.AutomationId="UntrustPiProjectButton" />
                            </StackPanel>
                            <TextBlock Text="Reload resources to apply saved changes. Node Pi installations report exact extension load results. Edit explicit extension paths under Pi / runtime." TextWrapping="Wrap" FontSize="12" />
                            <ScrollViewer MaxHeight="300" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.PiResources.Resources}" automation:AutomationProperties.AutomationId="PiResourceList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:PiResourceRow">
                                            <StackPanel Spacing="4" Margin="0,0,0,14">
                                                <TextBlock Text="{x:Bind Heading}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Source}" TextWrapping="Wrap" FontSize="12" />
                                                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                                                <TextBlock Text="{x:Bind State}" TextWrapping="Wrap" FontSize="12" />
                                                <Button Content="{x:Bind ToggleLabel}" IsEnabled="{x:Bind CanToggle}" Click="OnTogglePiResourceClicked" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="TogglePiResourceButton" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Content="Reload resources in this Pi process" Tag="reload" Click="OnPiNativeAccountClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanUseSdk, Mode=OneWay}" />
                            <ComboBox Header="Tool execution within a batch" SelectedIndex="{x:Bind ViewModel.PiResources.ToolExecutionIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.PiResources.CanUseSdk, Mode=OneWay}"><x:String>Parallel</x:String><x:String>Sequential</x:String></ComboBox>
                            <Button Content="Apply tool execution to this runtime" Tag="toolExecution" Click="OnPiNativeAccountClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanUseSdk, Mode=OneWay}" />
                            <TextBlock Text="Per-tool sequential restrictions and permissions still apply. This setting lasts until the runtime stops." TextWrapping="Wrap" FontSize="12" />
                            <Button Content="Manage resources in Pi terminal" Tag="resources" Click="OnPiSetupTerminalClicked" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="ManagePiResourcesTerminalButton" />
                            <Button Content="Open Pi package terminal" Tag="packages" Click="OnPiSetupTerminalClicked" HorizontalAlignment="Left" />
                            <Expander Header="Providers and login" IsExpanded="True" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Credential configured means Pi found a credential source. It does not verify an authenticated model request. Credentials stay in Pi's login flow." TextWrapping="Wrap" FontSize="12" />
                                    <Button Content="Open Pi login / logout" Tag="login" Click="OnPiSetupTerminalClicked" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="OpenPiLoginButton" />
                                    <TextBlock Text="In the terminal, enter /login or /logout and follow Pi's prompts. Exit Pi, restart the thread, then refresh here." TextWrapping="Wrap" />
                                    <ScrollViewer MaxHeight="180">
                                        <TextBlock Text="{x:Bind ViewModel.PiResources.ProviderSummary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PiProviderSummaryText" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Expander>
                            <ComboBox Header="Provider account" ItemsSource="{x:Bind ViewModel.PiResources.Providers}" DisplayMemberPath="DisplayName" SelectedItem="{x:Bind ViewModel.PiResources.SelectedProvider, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Sign in with browser" Tag="login" Click="OnPiNativeAccountClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanOAuth, Mode=OneWay}" />
                                <Button Content="Sign in with API key" Tag="loginApiKey" Click="OnPiNativeAccountClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanApiKey, Mode=OneWay}" />
                                <Button Content="Sign out" Tag="logout" Click="OnPiNativeAccountClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}" />
                            </StackPanel>
                            <Expander Header="Packages" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <TextBox Header="Find Pi packages on npm" Text="{x:Bind ViewModel.PiResources.PackageSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Search packages" Click="OnSearchPiPackagesClicked" />
                                        <Button Content="Load more packages" Tag="more" Click="OnSearchPiPackagesClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanLoadMorePackages, Mode=OneWay}" />
                                    </StackPanel>
                                    <ListView MaxHeight="180" ItemsSource="{x:Bind ViewModel.PiResources.PackageSearchResults}" SelectionMode="None">
                                        <ListView.ItemTemplate><DataTemplate x:DataType="models:PiPackageSearchItem">
                                            <StackPanel Spacing="4"><TextBlock Text="{x:Bind Name}" /><TextBlock Text="{x:Bind Version}" />
                                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                <Button Content="Use this package" Click="OnSelectPiPackageClicked" />
                                            </StackPanel>
                                        </DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                    <TextBox Header="Package source" PlaceholderText="npm:package, Git URL, or local path" Text="{x:Bind ViewModel.PiResources.PackageSource, Mode=TwoWay}" />
                                    <CheckBox Content="Install for this project" IsChecked="{x:Bind ViewModel.PiResources.PackageLocal, Mode=TwoWay}" />
                                    <Button Content="Install package" Tag="packageInstall" Click="OnPiPackageClicked" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.PiResources.Packages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PiPackageDescriptor">
                                                <StackPanel Spacing="4" Margin="0,6">
                                                    <TextBlock Text="{x:Bind Source}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Scope}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Update" Tag="packageUpdate" Click="OnPiPackageClicked" ToolTipService.ToolTip="Update this package source in all scopes where Pi has it configured" />
                                                        <Button Content="Reinstall" Tag="packageInstall" Click="OnPiPackageClicked" />
                                                        <Button Content="Remove" Tag="packageRemove" Click="OnPiPackageClicked" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Add or update a custom model" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}" automation:AutomationProperties.AutomationId="CustomPiModelExpander">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Save to Pi's models.json. The endpoint and API apply to every model under the provider ID. Other providers and model settings are preserved; comments and formatting are rewritten." TextWrapping="Wrap" FontSize="12" />
                                    <TextBox Header="Provider ID" Text="{x:Bind ViewModel.PiResources.ModelProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="CustomPiProviderInput" />
                                    <TextBox Header="Model ID" Text="{x:Bind ViewModel.PiResources.ModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="CustomPiModelInput" />
                                    <TextBox Header="Display name" Text="{x:Bind ViewModel.PiResources.ModelDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Endpoint URL" PlaceholderText="http://localhost:11434/v1" Text="{x:Bind ViewModel.PiResources.ModelBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="CustomPiEndpointInput" />
                                    <ComboBox Header="API" ItemsSource="{x:Bind ViewModel.PiResources.ModelApis}" SelectedItem="{x:Bind ViewModel.PiResources.ModelApi, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <TextBox Header="API key environment-variable name" PlaceholderText="MY_PROVIDER_API_KEY" Text="{x:Bind ViewModel.PiResources.ModelKeyEnvironmentVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="CustomPiKeyVariableInput" />
                                    <TextBlock Text="Enter a variable name, never the key itself. Leave empty to keep the existing credential configuration. Set the variable before starting PiStation." TextWrapping="Wrap" FontSize="12" />
                                    <CheckBox Content="Local server needs no key" IsChecked="{x:Bind ViewModel.PiResources.ModelKeyless, Mode=TwoWay}" automation:AutomationProperties.AutomationId="CustomPiKeylessToggle" />
                                    <CheckBox Content="Model supports reasoning" IsChecked="{x:Bind ViewModel.PiResources.ModelReasoning, Mode=TwoWay}" />
                                    <Button Content="Save provider and model" Click="OnSavePiModelClicked" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="SaveCustomPiModelButton" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Configuration and startup messages" HorizontalAlignment="Stretch">
                                <ScrollViewer MaxHeight="180">
                                    <TextBlock Text="{x:Bind ViewModel.PiResources.Diagnostics, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border Tag="PiSessions" Style="{StaticResource PiElevatedSurfaceStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Pi sessions" Style="{StaticResource PiPanelHeaderTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PiSessions.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PiSessionsStatusText" />
                            <TextBlock Text="Import and fork create independent threads on the connected host in the selected project. Originals and unsent drafts are preserved. Workspace files are not copied or rewound." TextWrapping="Wrap" FontSize="12" />
                            <Button Content="Cancel file transfer" Click="OnCancelPiSessionTransferClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanCancelTransfer, Mode=OneWay}" automation:AutomationProperties.AutomationId="CancelPiSessionTransferButton" />
                            <TextBox Header="New thread title (optional)" Text="{x:Bind ViewModel.PiSessions.NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="PiSessionTitleInput" />
                            <Expander Header="Import a session" IsExpanded="True" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Browse existing sessions on the host, or upload a JSONL file or ZIP bundle from this PC." TextWrapping="Wrap" />
                                    <TextBox Header="Session folder on the host" PlaceholderText="Empty uses Pi's default session folder on the host" Text="{x:Bind ViewModel.PiSessions.Directory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="PiSessionDirectoryInput" />
                                    <Button Content="Refresh session files" Click="OnBrowsePiSessionsClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="BrowsePiSessionsButton" />
                                    <Button Content="Use host's default session folder" Click="OnUseDefaultPiSessionFolderClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" />
                                    <Button Content="Choose folder…" Click="OnChoosePiSessionFolderClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.LocalSessionFolderPickerVisibility, Mode=OneWay}" />
                                    <Button Content="Import file from this PC…" Click="OnChoosePiSessionFileClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ImportPiSessionFileButton" />
                                    <Button Content="Retry last file import" Click="OnRetryPiSessionImportClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanRetryImport, Mode=OneWay}" automation:AutomationProperties.AutomationId="RetryPiSessionImportButton" />
                                    <ListView ItemsSource="{x:Bind ViewModel.PiSessions.Candidates}" SelectedItem="{x:Bind ViewModel.PiSessions.SelectedCandidate, Mode=TwoWay}" MaxHeight="240" SelectionMode="Single" automation:AutomationProperties.AutomationId="PiSessionCandidateList">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:PiSessionCandidateRow">
                                                <StackPanel Spacing="4" Margin="0,6">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Button Content="Import selected host session" Click="OnImportSelectedPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ImportSelectedPiSessionButton" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Selected thread" IsExpanded="True" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <Button Content="Refresh session tree" Click="OnInspectPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="InspectPiSessionButton" />
                                    <TextBlock Text="{x:Bind ViewModel.PiSessions.Summary, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="PiSessionSummaryText" />
                                    <TextBox Header="Search session tree" PlaceholderText="Words in messages or bookmarks" MaxLength="1024" Text="{x:Bind ViewModel.PiSessions.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="PiSessionTreeSearch" />
                                    <ComboBox Header="Show entries" SelectedIndex="{x:Bind ViewModel.PiSessions.FilterIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" HorizontalAlignment="Stretch" automation:AutomationProperties.AutomationId="PiSessionTreeFilter">
                                        <ComboBoxItem Content="Conversation (Pi default)" />
                                        <ComboBoxItem Content="Hide tool results" />
                                        <ComboBoxItem Content="User messages only" />
                                        <ComboBoxItem Content="Bookmarked entries only" />
                                        <ComboBoxItem Content="All entries" />
                                    </ComboBox>
                                    <CheckBox Content="Active branch only" IsChecked="{x:Bind ViewModel.PiSessions.ActiveBranchOnly, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="PiSessionActiveBranchOnly" />
                                    <StackPanel Spacing="8">
                                        <Button Content="Apply search and filters" Click="OnInspectPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="SearchPiSessionTreeButton" />
                                        <Button Content="Clear filters" Click="OnClearPiSessionFiltersClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ClearPiSessionFiltersButton" />
                                    </StackPanel>
                                    <TextBlock Text="Switch branch changes the conversation in this session. Your draft, attachments, context and workspace files are kept. Selecting a user message returns to its parent and makes that prompt available for copying. Fork creates an independent thread." TextWrapping="Wrap" FontSize="12" />
                                    <ListView KeyDown="OnSessionTreeKeyDown" ItemsSource="{x:Bind ViewModel.PiSessions.Entries}" SelectedItem="{x:Bind ViewModel.PiSessions.SelectedEntry, Mode=TwoWay}" MaxHeight="300" SelectionMode="Single" automation:AutomationProperties.AutomationId="PiSessionTreeList">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:PiSessionTreeRow">
                                                <StackPanel Spacing="4" Margin="{x:Bind Indent}">
                                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <CheckBox Content="Show bookmark timestamps" IsChecked="{x:Bind ViewModel.PiSessions.ShowLabelTimestamps, Mode=TwoWay}" automation:AutomationProperties.AutomationId="PiSessionShowTimestamps" />
                                    <Button Content="Fold / unfold selected entry" Click="OnFoldPiSessionEntryClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanFold, Mode=OneWay}" automation:AutomationProperties.AutomationId="FoldPiSessionEntryButton" />
                                    <Button Content="Expand all branches" Click="OnExpandPiSessionTreeClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" />
                                    <Button Content="Previous branch point" Click="OnPreviousPiBranchClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanNavigate, Mode=OneWay}" />
                                    <Button Content="Next branch point" Click="OnNextPiBranchClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanNavigate, Mode=OneWay}" />
                                    <Button Content="Copy selected entry text" Click="OnCopyPiSessionEntryClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanNavigate, Mode=OneWay}" automation:AutomationProperties.AutomationId="CopyPiSessionEntryButton" />
                                    <Button Content="Fork after selected response" Click="OnForkPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ForkPiSessionButton" />
                                    <TextBox Header="Selected entry bookmark" PlaceholderText="Name this conversation point" MaxLength="256" Text="{x:Bind ViewModel.PiSessions.EntryLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.PiSessions.CanNavigate, Mode=OneWay}" automation:AutomationProperties.AutomationId="PiSessionEntryLabel" />
                                    <StackPanel Spacing="8">
                                        <Button Content="Save bookmark" Click="OnSavePiSessionLabelClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanSaveLabel, Mode=OneWay}" automation:AutomationProperties.AutomationId="SavePiSessionLabelButton" />
                                        <Button Content="Remove bookmark" Click="OnRemovePiSessionLabelClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanRemoveLabel, Mode=OneWay}" automation:AutomationProperties.AutomationId="RemovePiSessionLabelButton" />
                                    </StackPanel>
                                    <CheckBox Content="Summarize the branch being left (uses the selected model)" IsChecked="{x:Bind ViewModel.PiSessions.SummarizeBranch, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="SummarizePiBranchCheckBox" />
                                    <TextBox Header="Summary instructions (optional)" Text="{x:Bind ViewModel.PiSessions.SummaryInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="16384" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" />
                                    <CheckBox Content="Use these instructions in place of Pi's default summary instructions" IsChecked="{x:Bind ViewModel.PiSessions.ReplaceSummaryInstructions, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" />
                                    <Button Content="Switch to selected branch" Click="OnNavigatePiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanNavigate, Mode=OneWay}" automation:AutomationProperties.AutomationId="NavigatePiSessionButton" />
                                    <Button Content="Cancel branch switch" Click="OnCancelPiSessionNavigationClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanCancelNavigation, Mode=OneWay}" automation:AutomationProperties.AutomationId="CancelPiSessionNavigationButton" />
                                    <TextBox Header="Selected prompt returned by Pi" Text="{x:Bind ViewModel.PiSessions.NavigationPrompt, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" automation:AutomationProperties.AutomationId="PiNavigationPrompt" />
                                    <Button Content="Copy selected prompt" Click="OnCopyNavigationPromptClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanCopyNavigationPrompt, Mode=OneWay}" />
                                    <Button Content="Copy whole session" Click="OnCopyPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="CopyPiSessionButton" />
                                    <TextBlock Text="JSONL retains the full tree and embedded images. HTML is a readable text transcript of the active branch. Linked files remain external." TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock Text="Exports are downloaded and saved on this PC. Choose a ZIP bundle to include sent attachments and citation comments." TextWrapping="Wrap" FontSize="12" />
                                    <Button Content="Export Pi JSONL…" Tag="jsonl" Click="OnExportPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ExportPiSessionJsonlButton" />
                                    <Button Content="Load more tree entries" Click="OnLoadMoreSessionEntries" IsEnabled="{x:Bind ViewModel.PiSessions.HasMoreEntries, Mode=OneWay}" />
                                    <Button Content="Load more session files" Click="OnLoadMoreSessionFiles" IsEnabled="{x:Bind ViewModel.PiSessions.HasMoreCandidates, Mode=OneWay}" />
                                    <Button Content="New temporary local session" Click="OnTemporarySessionClicked" automation:AutomationProperties.AutomationId="NewTemporarySessionButton" />
                                    <TextBlock Text="Temporary sessions discard conversation and draft when their window closes. Project edits and explicit exports remain." TextWrapping="Wrap" FontSize="12" />
                                    <Button Content="Share conversation as a GitHub gist…" Click="OnSharePiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="SharePiSessionButton" />
                                    <Button Content="Export readable HTML…" Tag="html" Click="OnExportPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ExportPiSessionHtmlButton" />
                                    <Button Content="Export session and attachments…" Tag="bundle" Click="OnExportPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="SourceControlSettingsSection"
                        Tag="SourceControl"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Source-control hosting" />
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind ViewModel.Settings.SourceControlSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <Expander Header="Commit and PR writing" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <ComboBox Header="Writing style" SelectedIndex="{x:Bind ViewModel.Settings.WritingStyleIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" automation:AutomationProperties.AutomationId="SourceControlWritingStyle">
                                        <ComboBoxItem Content="Default" />
                                        <ComboBoxItem Content="Conventional Commits" />
                                        <ComboBoxItem Content="Repository conventions" />
                                        <ComboBoxItem Content="Custom instructions" />
                                    </ComboBox>
                                    <TextBox Header="Custom writing instructions" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="20000" Text="{x:Bind ViewModel.Settings.WritingInstructions, Mode=TwoWay}" />
                                    <TextBlock Text="Leave provider and model empty to use the current Pi model. Use Pi provider/model IDs for a dedicated writer." TextWrapping="Wrap" />
                                    <ComboBox Header="Choose a Pi model" ItemsSource="{x:Bind ViewModel.PiConfiguration.Models, Mode=OneWay}" DisplayMemberPath="DisplayName" SelectionChanged="OnWriterModelSelected" HorizontalAlignment="Stretch" />
                                    <TextBox Header="Writer provider" MaxLength="256" Text="{x:Bind ViewModel.Settings.WriterProvider, Mode=TwoWay}" />
                                    <TextBox Header="Writer model" MaxLength="256" Text="{x:Bind ViewModel.Settings.WriterModel, Mode=TwoWay}" />
                                    <Button Content="Use current model" Click="OnUseCurrentWriterModelClicked" />
                                    <Button Content="Save writing preferences" Click="OnSaveWritingSettingsClicked" automation:AutomationProperties.AutomationId="SaveWritingSettingsButton" />
                                    <TextBox Header="PR base branch" PlaceholderText="Automatic (remote default, main or master)" MaxLength="256" Text="{x:Bind ViewModel.Settings.PullRequestBaseBranch, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.Settings.WritingStatus, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Recent hosting operations">
                                <StackPanel Spacing="8">
                                    <Button Click="OnRefreshSettingsClicked" Content="Refresh operation history" Style="{StaticResource PiSecondaryButtonStyle}" />
                                    <ListView MaxHeight="240" ItemsSource="{x:Bind ViewModel.Settings.HostingOperations}" SelectionMode="None">
                                        <ListView.ItemTemplate><DataTemplate x:DataType="models:HostingOperation">
                                            <StackPanel Padding="4" Spacing="4">
                                                <TextBlock Text="{x:Bind Action}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind State}" />
                                                <TextBlock Text="{x:Bind Result.Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Clone hosted repository">
                                <StackPanel Padding="0,8,0,0" Spacing="6">
                                    <Button HorizontalAlignment="Left" Click="OnBrowseHostedRepositoriesClicked" Content="Browse accounts and repositories" automation:AutomationProperties.AutomationId="BrowseHostedRepositoriesButton" />
                                    <TextBox x:Name="CloneRemoteInput" Header="Remote URL" PlaceholderText="https://github.com/owner/repository.git" Style="{StaticResource PiTextBoxStyle}" />
                                    <TextBox x:Name="CloneDestinationInput" Header="Destination" PlaceholderText="C:\Projects\repository" Style="{StaticResource PiTextBoxStyle}" />
                                    <Button HorizontalAlignment="Left" Click="OnCloneRepositoryClicked" Content="Clone and add project" Style="{StaticResource PiPrimaryButtonStyle}" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Publish selected project" automation:AutomationProperties.AutomationId="PublishRepositoryExpander">
                                <StackPanel Padding="0,8,0,0" Spacing="6">
                                    <ComboBox x:Name="PublishProviderSelector" SelectedIndex="0" Header="Provider" SelectionChanged="OnPublishProviderChanged" IsEnabled="{x:Bind ViewModel.Settings.CanPublishRepository, Mode=OneWay}" Style="{StaticResource PiComboBoxStyle}" automation:AutomationProperties.AutomationId="PublishProviderSelector">
                                        <ComboBoxItem Content="GitHub" Tag="GitHub" />
                                        <ComboBoxItem Content="GitLab" Tag="GitLab" />
                                        <ComboBoxItem Content="Azure DevOps" Tag="AzureDevOps" />
                                        <ComboBoxItem Content="Bitbucket Cloud" Tag="Bitbucket" />
                                    </ComboBox>
                                    <UserControl IsEnabled="{x:Bind ViewModel.Settings.CanPublishRepository, Mode=OneWay}"><StackPanel Spacing="6">
                                        <TextBox x:Name="PublishHostInput" Header="Hosting server" Text="github.com" MaxLength="255" Style="{StaticResource PiTextBoxStyle}" automation:AutomationProperties.AutomationId="PublishHostInput" />
                                        <TextBox x:Name="PublishOrganizationInput" Header="Azure organization URL" PlaceholderText="https://dev.azure.com/my-organization" Visibility="Collapsed" MaxLength="255" Style="{StaticResource PiTextBoxStyle}" automation:AutomationProperties.AutomationId="PublishOrganizationInput" />
                                        <TextBox x:Name="PublishOwnerInput" Header="Owner / organization" MaxLength="1024" Style="{StaticResource PiTextBoxStyle}" automation:AutomationProperties.AutomationId="PublishOwnerInput" />
                                        <TextBox x:Name="PublishRepositoryInput" Header="Repository name" MaxLength="255" Style="{StaticResource PiTextBoxStyle}" automation:AutomationProperties.AutomationId="PublishRepositoryInput" />
                                        <CheckBox x:Name="PublishResumeCheckBox" Content="Resume existing repository" Checked="OnPublishModeChanged" Unchecked="OnPublishModeChanged" automation:AutomationProperties.AutomationId="PublishResumeCheckBox" />
                                        <TextBlock Text="Resume looks up this repository, configures its HTTPS remote, and pushes the current branch. Use it after an interrupted publication or after adding the first commit." TextWrapping="Wrap" />
                                        <CheckBox x:Name="PublishPrivateCheckBox" Content="Private repository" IsChecked="True" automation:AutomationProperties.AutomationId="PublishPrivateCheckBox" />
                                        <TextBlock x:Name="PublishVisibilityNotice" Text="Azure repository access follows the selected project's permissions. Publication does not change project visibility." Visibility="Collapsed" TextWrapping="Wrap" />
                                    </StackPanel></UserControl>
                                    <Button HorizontalAlignment="Left" Click="OnPublishRepositoryClicked" Content="Publish" IsEnabled="{x:Bind ViewModel.Settings.CanPublishRepository, Mode=OneWay}" Style="{StaticResource PiPrimaryButtonStyle}" automation:AutomationProperties.AutomationId="PublishRepositoryButton" />
                                    <TextBlock Text="{x:Bind ViewModel.Settings.PublicationStatus, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PublicationStatus" automation:AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Create pull request">
                                <StackPanel Padding="0,8,0,0" Spacing="6">
                                    <TextBox x:Name="PullRequestTitleInput" Header="Title" Style="{StaticResource PiTextBoxStyle}" />
                                    <TextBox x:Name="PullRequestBodyInput" MinHeight="90" AcceptsReturn="True" Header="Description" Style="{StaticResource PiTextBoxStyle}" TextWrapping="Wrap" />
                                    <CheckBox x:Name="PullRequestDraftCheckBox" Content="Create as draft" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="OnGeneratePullRequestTextClicked" Content="Generate with Pi" IsEnabled="{x:Bind ViewModel.Settings.CanGenerateText, Mode=OneWay}" Style="{StaticResource PiSecondaryButtonStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.Settings.WritingStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                        <Button Click="OnCreatePullRequestClicked" IsEnabled="{x:Bind ViewModel.Settings.CanCreatePullRequest, Mode=OneWay}" Content="Create pull request" Style="{StaticResource PiPrimaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <Button Content="Load more pull requests" Click="OnLoadMorePullRequestsClicked" IsEnabled="{x:Bind ViewModel.Settings.CanLoadMorePullRequests, Mode=OneWay}" />
                            <ListView MaxHeight="260" ItemsSource="{x:Bind ViewModel.Settings.PullRequests, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PullRequestDescriptor">
                                        <Grid Padding="4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="{ThemeResource PiFontSizeCaption}" Foreground="{ThemeResource PiTextMutedBrush}" Text="{x:Bind Number}" />
                                                <TextBlock FontSize="{ThemeResource PiFontSizeCaption}" Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind State}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Actions" Style="{StaticResource PiToolbarButtonStyle}">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="OnLinkPullRequestClicked" Tag="{x:Bind Number}" Text="Link to active thread" />
                                                        <MenuFlyoutItem Click="OnCommentPullRequestClicked" IsEnabled="{x:Bind CanComment}" Tag="{x:Bind Number}" Text="Comment…" />
                                                        <MenuFlyoutItem Click="OnLabelPullRequestClicked" IsEnabled="{x:Bind CanLabel}" Tag="{x:Bind Number}" Text="Add label…" />
                                                        <MenuFlyoutItem Click="OnReviewerPullRequestClicked" IsEnabled="{x:Bind CanReview}" Tag="{x:Bind Number}" Text="Add reviewer…" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="OnApprovePullRequestClicked" IsEnabled="{x:Bind CanApprove}" Tag="{x:Bind Number}" Text="Approve" />
                                                        <MenuFlyoutItem Click="OnRequestChangesPullRequestClicked" IsEnabled="{x:Bind CanRequestChanges}" Tag="{x:Bind Number}" Text="Request changes…" />
                                                        <MenuFlyoutItem Click="OnMergePullRequestClicked" IsEnabled="{x:Bind CanMerge}" Tag="{x:Bind Number}" Text="Merge" />
                                                        <MenuFlyoutItem Click="OnClosePullRequestClicked" IsEnabled="{x:Bind CanClose}" Tag="{x:Bind Number}" Text="Close / reopen" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="IntegrationsSettingsSection"
                        Tag="Integrations"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Integrations" />
                            <ContentControl x:Name="BrowserSettingsHost" HorizontalContentAlignment="Stretch" />
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="GitHub, GitLab and Azure use authenticated gh, glab and az tools. Bitbucket Cloud uses its REST API: configure PISTATION_BITBUCKET_EMAIL and PISTATION_BITBUCKET_API_TOKEN, or PISTATION_BITBUCKET_ACCESS_TOKEN, on the host. Git clone/push uses the host's Git credentials. Availability and authentication failures appear without exporting secrets." TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Settings.Diagnostics, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RuntimeDiagnostic">
                                        <Grid Padding="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" /><TextBlock Grid.Column="1" Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" /></Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="RealDiagnosticsSettingsSection"
                        Tag="Diagnostics"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Diagnostics and resources" />
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind ViewModel.Settings.DiagnosticsSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnRefreshSettingsClicked" Content="Refresh" Style="{StaticResource PiSecondaryButtonStyle}" />
                                <Button automation:AutomationProperties.AutomationId="ExportDiagnosticsButton" Click="OnExportDiagnosticsClicked" Content="Export redacted diagnostics" Style="{StaticResource PiPrimaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock automation:AutomationProperties.AutomationId="RuntimeHealthStatus" Text="{x:Bind ViewModel.RuntimeHealth.Status, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock automation:AutomationProperties.AutomationId="BackgroundPolicyStatus" Text="{x:Bind ViewModel.RuntimeHealth.Policy, Mode=OneWay}" TextWrapping="Wrap" />
                            <Button automation:AutomationProperties.AutomationId="RefreshRuntimeHealthButton" Click="OnRefreshRuntimeHealthClicked" Content="Refresh processes and telemetry" />
                            <Expander Header="Processes and resource history" HorizontalAlignment="Stretch" IsExpanded="True" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Select an owned Pi or terminal process to stop it. The application host is protected. Process identity and ownership are checked again before stopping." TextWrapping="Wrap" />
                                    <ListView automation:AutomationProperties.AutomationId="DiagnosticProcessList" MaxHeight="210" ItemsSource="{x:Bind ViewModel.RuntimeHealth.Processes}" SelectedItem="{x:Bind ViewModel.RuntimeHealth.SelectedProcess, Mode=TwoWay}">
                                        <ListView.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Heading}" TextWrapping="Wrap" /><TextBlock Text="{Binding Resources}" FontSize="12" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                    <ContentControl IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}">
                                        <Button automation:AutomationProperties.AutomationId="TerminateDiagnosticProcessButton" Click="OnTerminateDiagnosticProcessClicked" Content="Stop selected process…" IsEnabled="{x:Bind ViewModel.RuntimeHealth.CanTerminate, Mode=OneWay}" />
                                    </ContentControl>
                                    <TextBlock Text="{x:Bind ViewModel.RuntimeHealth.HistorySummary, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="Combined CPU" /><Viewbox Stretch="Uniform"><Canvas Width="400" Height="80"><Polyline Points="{x:Bind ViewModel.RuntimeHealth.CpuPoints, Mode=OneWay}" Stroke="{ThemeResource PiTextPrimaryBrush}" StrokeThickness="2" /></Canvas></Viewbox>
                                    <TextBlock Text="Combined memory" /><Viewbox Stretch="Uniform"><Canvas Width="400" Height="80"><Polyline Points="{x:Bind ViewModel.RuntimeHealth.MemoryPoints, Mode=OneWay}" Stroke="{ThemeResource PiTextPrimaryBrush}" StrokeThickness="2" /></Canvas></Viewbox>
                                </StackPanel>
                            </Expander>
                            <Expander automation:AutomationProperties.AutomationId="RuntimeHealthSettingsExpander" Header="Background and observability settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ContentControl IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8">
                                    <ComboBox automation:AutomationProperties.AutomationId="BackgroundProfileSelector" Header="Background profile" ItemsSource="{x:Bind ViewModel.RuntimeHealth.Profiles}" SelectedItem="{x:Bind ViewModel.RuntimeHealth.Profile, Mode=TwoWay}" />
                                    <Button Click="OnApplyBackgroundPresetClicked" Content="Apply profile defaults" />
                                    <TextBlock Text="Balanced requires a focused window. Performance also refreshes visible windows. Battery saver additionally pauses on battery. These controls affect background refreshes; active conversations continue." TextWrapping="Wrap" />
                                    <CheckBox Content="Pause when the host is locked" IsChecked="{x:Bind ViewModel.RuntimeHealth.PauseLocked, Mode=TwoWay}" />
                                    <CheckBox Content="Pause when host battery saver is active" IsChecked="{x:Bind ViewModel.RuntimeHealth.PauseHostLowPower, Mode=TwoWay}" />
                                    <CheckBox Content="Pause when client battery saver is active" IsChecked="{x:Bind ViewModel.RuntimeHealth.PauseClientLowPower, Mode=TwoWay}" />
                                    <CheckBox Content="Pause when host or client is on battery" IsChecked="{x:Bind ViewModel.RuntimeHealth.PauseBattery, Mode=TwoWay}" />
                                    <CheckBox automation:AutomationProperties.AutomationId="DiagnosticsTracingToggle" Content="Collect operation traces" IsChecked="{x:Bind ViewModel.RuntimeHealth.TracingEnabled, Mode=TwoWay}" />
                                    <CheckBox Content="Collect operation metrics" IsChecked="{x:Bind ViewModel.RuntimeHealth.MetricsEnabled, Mode=TwoWay}" />
                                    <NumberBox Header="Trace sample rate (0 to 1)" Minimum="0" Maximum="1" SmallChange="0.1" Value="{x:Bind ViewModel.RuntimeHealth.SampleRate, Mode=TwoWay}" />
                                    <TextBox automation:AutomationProperties.AutomationId="DiagnosticsOtlpEndpoint" Header="Optional OTLP/HTTP trace endpoint" PlaceholderText="https://collector.example/v1/traces" Text="{x:Bind ViewModel.RuntimeHealth.OtlpEndpoint, Mode=TwoWay}" />
                                    <TextBox automation:AutomationProperties.AutomationId="DiagnosticsOtlpMetricsEndpoint" Header="Optional OTLP/HTTP metrics endpoint" PlaceholderText="https://collector.example/v1/metrics" Text="{x:Bind ViewModel.RuntimeHealth.OtlpMetricsEndpoint, Mode=TwoWay}" />
                                    <TextBlock Text="Leave endpoints empty for local collection only. Export sends operation names, timing, counts, outcomes and trace IDs to these addresses from the host. Prompts, tool output and credentials are excluded. Collected telemetry is also included in the redacted diagnostics export." TextWrapping="Wrap" />
                                    <Button automation:AutomationProperties.AutomationId="SaveRuntimeHealthButton" Click="OnSaveRuntimeHealthClicked" Content="Save background and diagnostics settings" />
                                    <Button Click="OnReloadRuntimeHealthSettingsClicked" Content="Discard unsaved settings" />
                                    <Button automation:AutomationProperties.AutomationId="ClearRuntimeHealthButton" Click="OnClearRuntimeHealthClicked" Content="Clear collected telemetry" />
                                </StackPanel></ContentControl>
                            </Expander>
                            <Expander Header="Operation metrics and recent traces" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Operation metrics" FontWeight="SemiBold" />
                                    <ListView MaxHeight="180" ItemsSource="{x:Bind ViewModel.RuntimeHealth.Metrics}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate></ListView>
                                    <TextBlock Text="Latest 50 traces" FontWeight="SemiBold" />
                                    <ListView MaxHeight="180" ItemsSource="{x:Bind ViewModel.RuntimeHealth.Traces}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate></ListView>
                                </StackPanel>
                            </Expander>
                            <TextBlock FontWeight="SemiBold" Text="Recent logs" />
                            <ListView MaxHeight="180" ItemsSource="{x:Bind ViewModel.Settings.Logs, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate><DataTemplate><TextBlock FontFamily="{ThemeResource PiMonospaceFontFamily}" FontSize="{ThemeResource PiFontSizeCaption}" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="LimitsSettingsSection"
                        Tag="Limits"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Subscription limits" automation:AutomationProperties.AutomationId="LimitsHeading" />
                            <TextBlock Text="Account quota windows and reset times. The marker shows elapsed time; pace compares usage with that time." TextWrapping="Wrap" Foreground="{ThemeResource PiTextMutedBrush}" />
                            <Button Content="Refresh quotas" Click="OnRefreshLimitsClicked" IsEnabled="{x:Bind ViewModel.Limits.IsIdle, Mode=OneWay}" automation:AutomationProperties.AutomationId="LimitsRefresh" />
                            <TextBlock Text="{x:Bind ViewModel.Limits.Status, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="LimitsStatus" automation:AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{x:Bind ViewModel.Limits.ActionStatus, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="LimitsActionStatus" automation:AutomationProperties.LiveSetting="Polite" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Limits.Sources}" automation:AutomationProperties.AutomationId="LimitsSources">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Spacing="6" Margin="0,4,0,12">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{ThemeResource PiTextMutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding Accounts}"><ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel Spacing="4" Margin="0,4,0,8">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding Windows}"><ItemsControl.ItemTemplate><DataTemplate>
                                                    <StackPanel Spacing="4" Margin="0,4,0,8">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                        <Grid Width="202" HorizontalAlignment="Left" Height="12">
                                                            <ProgressBar Value="{Binding UsedPercent}" Minimum="0" Maximum="100" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" automation:AutomationProperties.Name="{Binding Detail}" />
                                                            <Canvas Width="202" Height="12" IsHitTestVisible="False"><Rectangle Width="2" Height="12" Canvas.Left="{Binding ElapsedWidth}" Fill="{ThemeResource PiTextPrimaryBrush}" Opacity="{Binding MarkerOpacity}" /></Canvas>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{x:Bind ViewModel.Limits.Background, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource PiTextMutedBrush}" />
                            <Expander Header="Manage CLIProxyAPI hubs" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" automation:AutomationProperties.AutomationId="LimitsManageExpander">
                                <ContentControl IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                                    <ContentControl IsEnabled="{x:Bind ViewModel.Limits.IsIdle, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Monitor accounts on a quota-scheduler-enabled hub. Keys are encrypted for the Windows user running this host. Removing a hub stops monitoring and removes its stored key." TextWrapping="Wrap" />
                                        <ComboBox x:Name="LimitSourceSelector" Header="Existing hubs" ItemsSource="{x:Bind ViewModel.Limits.Configurations}" DisplayMemberPath="Label" SelectionChanged="OnLimitSourceSelected" automation:AutomationProperties.AutomationId="LimitSourceSelector" />
                                        <Button Content="New hub" Click="OnNewLimitSourceClicked" automation:AutomationProperties.AutomationId="LimitNewSource" />
                                        <TextBox Header="Label" Text="{x:Bind ViewModel.Limits.Label, Mode=TwoWay}" MaxLength="128" automation:AutomationProperties.AutomationId="LimitSourceLabel" />
                                        <TextBox Header="Hub origin (HTTPS, or HTTP on loopback)" Text="{x:Bind ViewModel.Limits.BaseUrl, Mode=TwoWay}" MaxLength="2048" PlaceholderText="http://127.0.0.1:8317" automation:AutomationProperties.AutomationId="LimitSourceUrl" />
                                        <PasswordBox x:Name="LimitManagementKey" Header="Management key" MaxLength="8192" PasswordRevealMode="Hidden" Password="{x:Bind ViewModel.Limits.PasswordReset, Mode=OneWay}" automation:AutomationProperties.AutomationId="LimitManagementKey" />
                                        <TextBlock Text="{x:Bind ViewModel.Limits.KeyHint, Mode=OneWay}" TextWrapping="Wrap" />
                                        <ToggleSwitch Header="Monitor this hub" IsOn="{x:Bind ViewModel.Limits.Enabled, Mode=TwoWay}" automation:AutomationProperties.AutomationId="LimitSourceEnabled" />
                                        <Button Content="Save hub" Click="OnSaveLimitSourceClicked" automation:AutomationProperties.AutomationId="LimitSaveSource" />
                                        <Button Content="Remove selected hub" Click="OnRemoveLimitSourceClicked" IsEnabled="{x:Bind ViewModel.Limits.CanRemove, Mode=OneWay}" automation:AutomationProperties.AutomationId="LimitRemoveSource" />
                                    </StackPanel>
                                    </ContentControl>
                                </ContentControl>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="UsageSettingsSection"
                        Tag="Usage"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Usage dashboard" automation:AutomationProperties.AutomationId="UsageDashboardHeading" />
                            <TextBlock Text="{x:Bind ViewModel.Usage.Scope, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Usage.Summary, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="UsageSummary" />
                            <TextBlock Foreground="{ThemeResource PiTextMutedBrush}" Text="API-equivalent estimates in USD, not your subscription bill. Reasoning is included in output tokens. Cache savings use base input rates; missing prices are excluded from known cost." TextWrapping="Wrap" />
                            <Expander Header="Date range, filters and refresh" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" automation:AutomationProperties.AutomationId="UsageFiltersExpander">
                            <ContentControl IsEnabled="{x:Bind ViewModel.Usage.IsIdle, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <ComboBox Header="Date range" ItemsSource="{x:Bind ViewModel.Usage.Presets}" SelectedItem="{x:Bind ViewModel.Usage.Preset, Mode=TwoWay}" automation:AutomationProperties.AutomationId="UsageDateRange" />
                                <CalendarDatePicker Header="From date" Date="{x:Bind ViewModel.Usage.FromDate, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Usage.CustomDates, Mode=OneWay}" automation:AutomationProperties.AutomationId="UsageFromDate" />
                                <CalendarDatePicker Header="Through date (inclusive)" Date="{x:Bind ViewModel.Usage.ThroughDate, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Usage.CustomDates, Mode=OneWay}" automation:AutomationProperties.AutomationId="UsageThroughDate" />
                                <ComboBox Header="Provider" ItemsSource="{x:Bind ViewModel.Usage.Providers}" SelectedItem="{x:Bind ViewModel.Usage.Provider, Mode=TwoWay}" automation:AutomationProperties.AutomationId="UsageProvider" />
                                <ComboBox Header="Model" ItemsSource="{x:Bind ViewModel.Usage.Models}" SelectedItem="{x:Bind ViewModel.Usage.Model, Mode=TwoWay}" automation:AutomationProperties.AutomationId="UsageModel" />
                                <TextBox Header="Additional history directory on this host (optional)" Text="{x:Bind ViewModel.Usage.HistoryDirectory, Mode=TwoWay}" automation:AutomationProperties.AutomationId="UsageHistoryDirectory" />
                                <Button Content="Apply filters / refresh" Click="OnRefreshUsageClicked" automation:AutomationProperties.AutomationId="UsageRefresh" />
                                <Button Content="Rescan all history" Click="OnRescanUsageClicked" IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" automation:AutomationProperties.AutomationId="UsageRescan" />
                                <Button Content="Refresh pricing" Click="OnRefreshUsagePricingClicked" IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" automation:AutomationProperties.AutomationId="UsageRefreshPricing" />
                            </StackPanel>
                            </ContentControl>
                            </Expander>
                            <ProgressRing IsActive="{x:Bind ViewModel.Usage.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Bind ViewModel.Usage.Status, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="UsageStatus" automation:AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{x:Bind ViewModel.Usage.Coverage, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="UsageCoverage" />
                            <TextBlock Text="{x:Bind ViewModel.Usage.Pricing, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="UsagePricing" />
                            <ComboBox Header="Chart measure" ItemsSource="{x:Bind ViewModel.Usage.Metrics}" SelectedItem="{x:Bind ViewModel.Usage.Metric, Mode=TwoWay}" automation:AutomationProperties.AutomationId="UsageMetric" />
                            <TextBlock Text="By provider" Style="{StaticResource PiPanelHeaderTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Usage.ProviderChart}" automation:AutomationProperties.AutomationId="UsageProviderChart">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:UsageChartRow">
                                        <StackPanel Margin="0,4" Spacing="3">
                                            <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                            <Rectangle Width="{x:Bind BarWidth}" Height="8" Fill="{ThemeResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{x:Bind Value}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Over time" Style="{StaticResource PiPanelHeaderTextStyle}" />
                            <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" automation:AutomationProperties.AutomationId="UsageTimelineScroll">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Usage.Timeline}" automation:AutomationProperties.AutomationId="UsageTimeline">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:UsageChartRow">
                                            <StackPanel Margin="0,4" Spacing="3">
                                                <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                                <Rectangle Width="{x:Bind BarWidth}" Height="8" Fill="{ThemeResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Left" />
                                                <TextBlock Text="{x:Bind Value}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Models and cache savings" Style="{StaticResource PiPanelHeaderTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Usage.Breakdown}" automation:AutomationProperties.AutomationId="UsageBreakdown">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:UsageBreakdownRow">
                                        <StackPanel Margin="0,8" Spacing="4">
                                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="UpdatesSettingsSection"
                        Tag="Updates"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Updates" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnCheckForUpdatesClicked" Content="Check for updates" Style="{StaticResource PiSecondaryButtonStyle}" />
                                <Button Click="OnOpenUpdateInstallerClicked" Content="Open update installer" IsEnabled="{x:Bind ViewModel.Settings.CanOpenUpdateInstaller, Mode=OneWay}" Style="{StaticResource PiSecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind ViewModel.Settings.UpdateSummary, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="DiagnosticsSection"
                        Tag="Diagnostics"
                        automation:AutomationProperties.AutomationId="DiagnosticsSection"
                        Style="{StaticResource PiWarningBannerStyle}"
                        Visibility="{x:Bind ViewModel.UiTestFaultControlsVisibility}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Test diagnostics" />
                            <TextBlock
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="These controls are available only in deterministic FakePi test launches."
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="SimulateTransportDropButton"
                                HorizontalAlignment="Left"
                                automation:AutomationProperties.AutomationId="SimulateTransportDropButton"
                                automation:AutomationProperties.Name="Simulate a transport disconnect for UI testing"
                                Click="OnSimulateTransportDropClicked"
                                Content="Simulate transport disconnect"
                                Style="{StaticResource PiSecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Tag="Updates" Style="{StaticResource PiBannerStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="About" />
                            <TextBlock
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="Pi Station Desktop • Native Windows client for Pi"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
                </NavigationView.Content>
            </NavigationView>
        </controls:SettingsPageSurface>

        <ContentDialog
            x:Name="AddProjectDialog"
            automation:AutomationProperties.AutomationId="AddProjectDialog"
            Closed="OnAddProjectDialogClosed"
            CloseButtonText="Cancel"
            DefaultButton="Close"
            Title="Add local project">
            <StackPanel x:Name="ProjectDialogContent" MinWidth="380" Spacing="12">
                <Border Style="{StaticResource PiBannerStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Local folders only" />
                        <TextBlock
                            Foreground="{ThemeResource PiTextSecondaryBrush}"
                            Text="Pi Station stores workspace metadata locally and never uploads the folder itself."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBox
                    x:Name="ProjectPathInput"
                    automation:AutomationProperties.AutomationId="ProjectPathInput"
                    automation:AutomationProperties.Name="Project directory path"
                    Header="Project path"
                    PlaceholderText="C:\Projects\my-project"
                    Style="{StaticResource PiTextBoxStyle}" />
                <Button
                    x:Name="AddProjectConfirmButton"
                    HorizontalAlignment="Right"
                    automation:AutomationProperties.AutomationId="AddProjectConfirmButton"
                    automation:AutomationProperties.Name="Confirm add project"
                    Click="OnAddProjectConfirmed"
                    Content="Add project"
                    Style="{StaticResource PiPrimaryButtonStyle}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
