<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PiStation.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:PiStation.App.Views.Controls"
    xmlns:models="using:PiStation.Protocol.Models"
    xmlns:viewModels="using:PiStation.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{StaticResource PiSansFontFamily}"
    mc:Ignorable="d">

    <Grid x:Name="PageLayoutGrid" Background="{ThemeResource PiCanvasBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PageResponsiveStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConversationTimelineHost.Margin" Value="12,8,12,0" />
                        <Setter Target="RecoveryBannerHost.Margin" Value="12,0" />
                        <Setter Target="ComposerSurfaceHost.Margin" Value="12,8,12,0" />
                        <Setter Target="WorkspaceStatusBarHost.Margin" Value="12,0,12,4" />
                        <Setter Target="SettingsShell.MinWidth" Value="0" />
                        <Setter Target="ProjectDialogContent.MinWidth" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConversationTimelineHost.Margin" Value="16,10,16,0" />
                        <Setter Target="RecoveryBannerHost.Margin" Value="16,0" />
                        <Setter Target="ComposerSurfaceHost.Margin" Value="16,8,16,0" />
                        <Setter Target="WorkspaceStatusBarHost.Margin" Value="16,0,16,6" />
                        <Setter Target="SettingsShell.MinWidth" Value="0" />
                        <Setter Target="ProjectDialogContent.MinWidth" Value="340" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StandardLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConversationTimelineHost.Margin" Value="20,12,20,0" />
                        <Setter Target="RecoveryBannerHost.Margin" Value="20,0" />
                        <Setter Target="ComposerSurfaceHost.Margin" Value="20,10,20,0" />
                        <Setter Target="WorkspaceStatusBarHost.Margin" Value="20,0,20,8" />
                        <Setter Target="SettingsShell.MinWidth" Value="0" />
                        <Setter Target="ProjectDialogContent.MinWidth" Value="380" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1180" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConversationTimelineHost.Margin" Value="24,12,24,0" />
                        <Setter Target="RecoveryBannerHost.Margin" Value="24,0" />
                        <Setter Target="ComposerSurfaceHost.Margin" Value="24,10,24,0" />
                        <Setter Target="WorkspaceStatusBarHost.Margin" Value="24,0,24,8" />
                        <Setter Target="SettingsShell.MinWidth" Value="0" />
                        <Setter Target="ProjectDialogContent.MinWidth" Value="380" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:WorkspaceShell x:Name="ShellLayout">
            <controls:WorkspaceShell.MainContent>
                <Grid Background="{ThemeResource PiCanvasBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl
                        x:Name="ConversationTimelineHost"
                        MaxWidth="{StaticResource PiReadingColumnWidth}"
                        Margin="24,12,24,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

                    <StackPanel Grid.Row="1" Spacing="6">
                        <Expander Header="{x:Bind ViewModel.Plan.Heading, Mode=OneWay}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            MaxWidth="{StaticResource PiReadingColumnWidth}" Margin="24,0" Visibility="{x:Bind ViewModel.Plan.Visibility, Mode=OneWay}" automation:AutomationProperties.AutomationId="PiPlanPanel" automation:AutomationProperties.Name="{x:Bind ViewModel.Plan.Heading, Mode=OneWay}">
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.Plan.Policy, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="PiPlanPolicyText" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Plan mode" Tag="plan" Click="OnPlanActionClicked" IsEnabled="{x:Bind ViewModel.Plan.CanChangeMode, Mode=OneWay}" automation:AutomationProperties.AutomationId="StartPlanningButton" />
                                        <Button Content="Refresh" Tag="inspect" Click="OnPlanActionClicked" IsEnabled="{x:Bind ViewModel.Plan.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="RefreshPlanButton" />
                                    </StackPanel>
                                    <TextBox Header="Review or edit the numbered plan" Text="{x:Bind ViewModel.Plan.EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="160" MaxLength="32768" IsEnabled="{x:Bind ViewModel.Plan.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="PiPlanEditor" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save plan" Click="OnPlanActionClicked" Tag="save" IsEnabled="{x:Bind ViewModel.Plan.CanSave, Mode=OneWay}" automation:AutomationProperties.AutomationId="SavePlanButton" />
                                        <Button Content="Reload saved plan" Click="OnReloadPlanClicked" IsEnabled="{x:Bind ViewModel.Plan.CanAct, Mode=OneWay}" />
                                        <Button Content="Export" Click="OnExportPlanClicked" IsEnabled="{x:Bind ViewModel.Plan.CanExport, Mode=OneWay}" automation:AutomationProperties.AutomationId="ExportPlanButton" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.Plan.Progress, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PiPlanProgressText" />
                                    <Button Content="Approve and execute remaining steps" Tag="execute" Click="OnPlanActionClicked" IsEnabled="{x:Bind ViewModel.Plan.CanExecute, Mode=OneWay}" automation:AutomationProperties.AutomationId="ExecutePlanButton" />
                                    <TextBlock Text="Use Stop in the composer to interrupt execution. Completed steps are reported by the agent." TextWrapping="Wrap" />
                                    <Button Content="Return to normal tools" Tag="off" Click="OnPlanActionClicked" IsEnabled="{x:Bind ViewModel.Plan.CanChangeMode, Mode=OneWay}" automation:AutomationProperties.AutomationId="LeavePlanningButton" />
                                    <TextBlock Text="{x:Bind ViewModel.Plan.Status, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="PiPlanStatusText" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                        <Expander Header="{x:Bind ViewModel.ExtensionUi.Heading, Mode=OneWay}" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            MaxWidth="{StaticResource PiReadingColumnWidth}" Margin="24,0" Visibility="{x:Bind ViewModel.ExtensionUi.PanelVisibility, Mode=OneWay}" automation:AutomationProperties.AutomationId="PiExtensionPanel">
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.ExtensionUi.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind ViewModel.ExtensionUi.Notifications, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind ViewModel.ExtensionUi.AboveWidgets, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <StackPanel Visibility="{x:Bind ViewModel.ExtensionUi.SuggestionVisibility, Mode=OneWay}" Spacing="4">
                                        <TextBlock Text="Suggested draft text" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.ExtensionUi.SuggestedText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" MaxHeight="80" />
                                        <Button Content="Insert into draft" Click="OnInsertExtensionTextClicked" automation:AutomationProperties.AutomationId="InsertExtensionTextButton" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                        <InfoBar IsOpen="{x:Bind ViewModel.RequiresPiSetup, Mode=OneWay}" IsClosable="False" Severity="Informational"
                            Title="Set up Pi" Message="Choose the Pi executable in Settings to start your first task.">
                            <InfoBar.ActionButton><Button Content="Set up Pi" Click="OnOpenPiSetupClicked" /></InfoBar.ActionButton>
                        </InfoBar>
                    <ContentControl
                        x:Name="RecoveryBannerHost"
                        MaxWidth="{StaticResource PiReadingColumnWidth}"
                        Margin="24,0"
                        HorizontalContentAlignment="Stretch" />
                    </StackPanel>

                    <ContentControl
                        x:Name="ComposerSurfaceHost"
                        Grid.Row="2"
                        MaxWidth="{StaticResource PiReadingColumnWidth}"
                        Margin="24,10,24,0"
                        HorizontalContentAlignment="Stretch" />

                    <StackPanel Grid.Row="3">
                        <ScrollViewer MaxHeight="100" MaxWidth="{StaticResource PiReadingColumnWidth}" Margin="24,4,24,0" Visibility="{x:Bind ViewModel.ExtensionUi.BelowVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ExtensionUi.BelowWidgets, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PiExtensionBelowWidget" />
                        </ScrollViewer>
                    <ContentControl
                        x:Name="WorkspaceStatusBarHost"
                        MaxWidth="{StaticResource PiReadingColumnWidth}"
                        Margin="24,0,24,8"
                        HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </controls:WorkspaceShell.MainContent>
        </controls:WorkspaceShell>

        <ContentDialog
            x:Name="CommandPaletteDialog"
            automation:AutomationProperties.AutomationId="CommandPaletteDialog"
            Closed="OnCommandPaletteClosed"
            CloseButtonText="Close"
            DefaultButton="None"
            Title="Command Palette">
            <Grid MinWidth="620" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="CommandPaletteQuery"
                    automation:AutomationProperties.AutomationId="CommandPaletteQuery"
                    automation:AutomationProperties.Name="Search commands and workspace"
                    KeyDown="OnCommandPaletteQueryKeyDown"
                    PlaceholderText="Search commands, projects, branches, messages, and threads…"
                    Style="{StaticResource PiTextBoxStyle}"
                    TextChanged="OnCommandPaletteQueryChanged" />
                <ProgressBar
                    x:Name="CommandPaletteProgress"
                    Grid.Row="1"
                    Height="2"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
                <ListView
                    x:Name="CommandPaletteResults"
                    Grid.Row="2"
                    MaxHeight="430"
                    automation:AutomationProperties.AutomationId="CommandPaletteResults"
                    IsItemClickEnabled="True"
                    ItemClick="OnCommandPaletteResultClicked"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                MinHeight="54"
                                Padding="8,6"
                                ColumnSpacing="12"
                                Opacity="{Binding ResultOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource PiFontSizeCaption}"
                                    Foreground="{ThemeResource PiTextMutedBrush}"
                                    Text="{Binding KindLabel}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource PiTextPrimaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MaxLines="2"
                                        FontSize="{StaticResource PiFontSizeCaption}"
                                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Border
                                    Grid.Column="2"
                                    Padding="7,3"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource PiControlSurfaceBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontFamily="{StaticResource PiMonospaceFontFamily}"
                                        FontSize="{StaticResource PiFontSizeCaption}"
                                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                                        Text="{Binding ShortcutLabel}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="3" Spacing="6">
                <Button x:Name="CommandPaletteLoadMore" Content="Load more search results"
                    automation:AutomationProperties.AutomationId="CommandPaletteLoadMore"
                    Click="OnCommandPaletteLoadMore" Visibility="Collapsed" />
                <TextBlock
                    x:Name="CommandPaletteStatusText"
                    automation:AutomationProperties.AutomationId="CommandPaletteStatusText"
                    FontSize="{StaticResource PiFontSizeCaption}"
                    Foreground="{ThemeResource PiTextMutedBrush}"
                    Text="Type &gt; to search commands only. Use Up, Down, and Enter to navigate."
                    TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ContentDialog>

        <ContentDialog
            x:Name="SettingsDialog"
            automation:AutomationProperties.AutomationId="SettingsDialog"
            Closed="OnSettingsDialogClosed"
            CloseButtonText="Done"
            DefaultButton="Close"
            Title="Settings">
            <NavigationView
                x:Name="SettingsNavigation"
                MinWidth="0"
                MaxWidth="760"
                MaxHeight="620"
                CompactPaneLength="48"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                OpenPaneLength="210"
                PaneDisplayMode="Left"
                SelectionChanged="OnSettingsNavigationSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsGeneralNavItem" Content="General" Tag="General" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsProjectsNavItem" Content="Projects" Tag="Projects" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsRuntimeNavItem" Content="Pi / runtime" Tag="PiRuntime" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsPiResourcesNavItem" Content="Pi resources" Tag="PiResources" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsPiSessionsNavItem" Content="Sessions" Tag="PiSessions" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsSourceControlNavItem" Content="Source control" Tag="SourceControl" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsAppearanceNavItem" Content="Appearance" Tag="Appearance" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsIntegrationsNavItem" Content="Integrations" Tag="Integrations" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsDiagnosticsNavItem" Content="Diagnostics" Tag="Diagnostics" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsUsageNavItem" Content="Usage" Tag="Usage" />
                    <NavigationViewItem automation:AutomationProperties.AutomationId="SettingsUpdatesNavItem" Content="Updates" Tag="Updates" />
                </NavigationView.MenuItems>
                <NavigationView.Content>
            <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    x:Name="SettingsShell"
                    MinWidth="0"
                    automation:AutomationProperties.AutomationId="SettingsShell"
                    automation:AutomationProperties.Name="Pi Station settings"
                    Spacing="12">
                    <TextBlock
                        Tag="Appearance"
                        Foreground="{ThemeResource PiTextSecondaryBrush}"
                        Text="Configure Pi Station appearance, workspace, and connections."
                        TextWrapping="Wrap" />

                    <Border Tag="General" Style="{StaticResource PiElevatedSurfaceStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Automatic thread settlement" FontWeight="SemiBold" />
                            <CheckBox Content="Settle inactive threads" IsChecked="{x:Bind ViewModel.Settings.AutoSettleInactive, Mode=TwoWay}" />
                            <NumberBox Header="Days of inactivity (1–365)" Minimum="1" Maximum="365" Value="{x:Bind ViewModel.Settings.AutoSettleDays, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Settings.AutoSettleInactive, Mode=OneWay}" automation:AutomationProperties.AutomationId="AutoSettleDaysInput" />
                            <CheckBox Content="Settle idle threads when their PR merges" IsChecked="{x:Bind ViewModel.Settings.AutoSettleMerged, Mode=TwoWay}" />
                            <CheckBox Content="Settle idle threads when their PR closes" IsChecked="{x:Bind ViewModel.Settings.AutoSettleClosed, Mode=TwoWay}" />
                            <TextBlock Text="Checked every minute while PiStation is open. Active tasks and approvals are protected. Un-settle keeps a thread active until its next task. Saving rules does not reopen settled threads." TextWrapping="Wrap" />
                            <Button Content="Save settlement rules" Click="OnSaveSettlementSettingsClicked" automation:AutomationProperties.AutomationId="SaveSettlementSettingsButton" />
                            <TextBlock Text="{x:Bind ViewModel.Settings.Status, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sidebar" Style="{StaticResource PiPanelHeaderTextStyle}" />
                            <Button Content="Configure grouping and sorting…" Click="OnConfigureSidebar" />
                        </StackPanel>
                    </Border>
                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <Grid ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Appearance" />
                                <TextBlock
                                    x:Name="SettingsThemeStatusText"
                                    automation:AutomationProperties.AutomationId="SettingsThemeStatusText"
                                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Layout.ThemeSummary, Mode=OneWay}" />
                            </StackPanel>
                            <ComboBox
                                x:Name="PiThemeSelector"
                                Grid.Column="1"
                                MinWidth="116"
                                automation:AutomationProperties.AutomationId="PiThemeSelector"
                                automation:AutomationProperties.Name="Application theme"
                                SelectionChanged="OnThemeSelectionChanged"
                                Style="{StaticResource PiComboBoxStyle}">
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                                <ComboBoxItem Content="System" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                            </ComboBox>
                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="System follows Windows, including high contrast."
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Keyboard shortcuts" />
                            <TextBlock
                                x:Name="KeybindingSummaryText"
                                automation:AutomationProperties.AutomationId="KeybindingSummaryText"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <ComboBox
                                x:Name="KeybindingCommandSelector"
                                automation:AutomationProperties.AutomationId="KeybindingCommandSelector"
                                DisplayMemberPath="Title"
                                Header="Command"
                                SelectionChanged="OnKeybindingCommandSelectionChanged"
                                Style="{StaticResource PiComboBoxStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="KeybindingGestureInput"
                                    automation:AutomationProperties.AutomationId="KeybindingGestureInput"
                                    Header="Shortcut"
                                    PlaceholderText="Ctrl+K"
                                    Style="{StaticResource PiTextBoxStyle}" />
                                <TextBox
                                    x:Name="KeybindingWhenInput"
                                    Grid.Column="1"
                                    automation:AutomationProperties.AutomationId="KeybindingWhenInput"
                                    Header="When"
                                    PlaceholderText="projectOpen &amp;&amp; !terminalFocus"
                                    Style="{StaticResource PiTextBoxStyle}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="SaveKeybindingButton"
                                    automation:AutomationProperties.AutomationId="SaveKeybindingButton"
                                    Click="OnSaveKeybindingClicked"
                                    Content="Save shortcut"
                                    Style="{StaticResource PiPrimaryButtonStyle}" />
                                <Button
                                    x:Name="ResetAllKeybindingsButton"
                                    automation:AutomationProperties.AutomationId="ResetAllKeybindingsButton"
                                    Click="OnResetAllKeybindingsClicked"
                                    Content="Reset all"
                                    Style="{StaticResource PiSecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock
                                x:Name="KeybindingValidationText"
                                automation:AutomationProperties.AutomationId="KeybindingValidationText"
                                Foreground="{ThemeResource PiWaitingBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="KeybindingEmptyText"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="No custom overrides. Default shortcuts are active."
                                TextWrapping="Wrap" />
                            <ListView
                                x:Name="KeybindingOverridesList"
                                MaxHeight="180"
                                automation:AutomationProperties.AutomationId="KeybindingOverridesList"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="44" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding CommandTitle}" />
                                                <TextBlock
                                                    FontFamily="{StaticResource PiMonospaceFontFamily}"
                                                    FontSize="{StaticResource PiFontSizeCaption}"
                                                    Foreground="{ThemeResource PiTextSecondaryBrush}"
                                                    Text="{Binding Summary}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Click="OnResetKeybindingClicked"
                                                Content="Reset"
                                                Style="{StaticResource PiToolbarButtonStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="Conditions support !, &amp;&amp;, ||, and parentheses. Conflicting shortcuts with overlapping contexts are rejected."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Terminal" />
                            <TextBlock
                                x:Name="SettingsTerminalAppearanceStatusText"
                                Grid.Row="1"
                                automation:AutomationProperties.AutomationId="SettingsTerminalAppearanceStatusText"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.Layout.TerminalAppearanceSummary, Mode=OneWay}" />
                            <Grid Grid.Row="2" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="TerminalFontFamilySelector"
                                    MinWidth="170"
                                    automation:AutomationProperties.AutomationId="TerminalFontFamilySelector"
                                    automation:AutomationProperties.Name="Terminal font family"
                                    Header="Font family"
                                    SelectionChanged="OnTerminalFontFamilySelectionChanged"
                                    Style="{StaticResource PiComboBoxStyle}">
                                    <ComboBoxItem Content="Cascadia Mono" Tag="Cascadia Mono, Consolas" />
                                    <ComboBoxItem Content="Consolas" Tag="Consolas" />
                                    <ComboBoxItem Content="Cascadia Code" Tag="Cascadia Code" />
                                    <ComboBoxItem Content="CaskaydiaCove Nerd Font" Tag="CaskaydiaCove Nerd Font" />
                                    <ComboBoxItem Content="JetBrains Mono" Tag="JetBrains Mono" />
                                    <ComboBoxItem Content="Fira Code" Tag="Fira Code" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="TerminalFontSizeSelector"
                                    Grid.Column="1"
                                    automation:AutomationProperties.AutomationId="TerminalFontSizeSelector"
                                    automation:AutomationProperties.Name="Terminal font size"
                                    Header="Size"
                                    SelectionChanged="OnTerminalFontSizeSelectionChanged"
                                    Style="{StaticResource PiComboBoxStyle}">
                                    <ComboBoxItem Content="10 px" Tag="10" />
                                    <ComboBoxItem Content="11 px" Tag="11" />
                                    <ComboBoxItem Content="12 px" Tag="12" />
                                    <ComboBoxItem Content="13 px" Tag="13" />
                                    <ComboBoxItem Content="14 px" Tag="14" />
                                    <ComboBoxItem Content="16 px" Tag="16" />
                                    <ComboBoxItem Content="18 px" Tag="18" />
                                    <ComboBoxItem Content="20 px" Tag="20" />
                                </ComboBox>
                            </Grid>
                            <Button
                                x:Name="ResetTerminalAppearanceButton"
                                Grid.Row="3"
                                HorizontalAlignment="Left"
                                automation:AutomationProperties.AutomationId="ResetTerminalAppearanceButton"
                                automation:AutomationProperties.Name="Reset terminal appearance"
                                Click="OnResetTerminalAppearanceClicked"
                                Content="Reset terminal font"
                                Style="{StaticResource PiSecondaryButtonStyle}" />
                            <TextBlock
                                Grid.Row="4"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="Changes apply to open terminals immediately. Missing or proportional fonts fall back to the default monospace stack."
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Tag="Appearance" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Workspace layout" />
                            <TextBlock
                                x:Name="SettingsLayoutSummaryText"
                                Grid.Row="1"
                                automation:AutomationProperties.AutomationId="SettingsLayoutSummaryText"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.Layout.LayoutSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="ResetLayoutButton"
                                Grid.Row="2"
                                HorizontalAlignment="Left"
                                automation:AutomationProperties.AutomationId="ResetLayoutButton"
                                automation:AutomationProperties.Name="Reset workspace layout"
                                Click="OnResetLayoutClicked"
                                Content="Reset layout"
                                Style="{StaticResource PiSecondaryButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Tag="PiRuntime" Style="{StaticResource PiElevatedSurfaceStyle}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="{x:Bind ViewModel.EnvironmentLabel}" />
                            <TextBlock
                                x:Name="SettingsConnectionStatusText"
                                Grid.Row="1"
                                automation:AutomationProperties.AutomationId="SettingsConnectionStatusText"
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.Connection.Status, Mode=OneWay}" />
                            <TextBlock
                                x:Name="SettingsProjectPathText"
                                Grid.Row="2"
                                automation:AutomationProperties.AutomationId="SettingsProjectPathText"
                                FontFamily="{StaticResource PiMonospaceFontFamily}"
                                FontSize="{StaticResource PiFontSizeCaption}"
                                Foreground="{ThemeResource PiTextMutedBrush}"
                                Text="{x:Bind ViewModel.Workspace.ActiveProjectPath, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Workspace.ActiveProjectPath, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <ContentControl x:Name="RemoteConnectionsHost" HorizontalContentAlignment="Stretch" />

                    <Border
                        x:Name="ProjectsSettingsSection"
                        Tag="Projects"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Projects" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Workspace.ActiveProjectName, Mode=OneWay}" />
                            <TextBlock FontFamily="{StaticResource PiMonospaceFontFamily}" FontSize="{StaticResource PiFontSizeCaption}" Foreground="{ThemeResource PiTextMutedBrush}" Text="{x:Bind ViewModel.Workspace.ActiveProjectPath, Mode=OneWay}" TextWrapping="Wrap" />
                            <ComboBox x:Name="ProjectDefaultWorkspaceModeSelector" Header="Default thread workspace" Style="{StaticResource PiComboBoxStyle}">
                                <ComboBoxItem Content="Local" Tag="Local" />
                                <ComboBoxItem Content="Git worktree" Tag="Worktree" />
                            </ComboBox>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ProjectDefaultModelProviderInput" Header="Default model provider" PlaceholderText="openai" TextChanged="OnProjectModelDefaultsChanged" Style="{StaticResource PiTextBoxStyle}" />
                                <TextBox x:Name="ProjectDefaultModelIdInput" Grid.Column="1" Header="Default model ID" PlaceholderText="model ID" TextChanged="OnProjectModelDefaultsChanged" Style="{StaticResource PiTextBoxStyle}" />
                            </Grid>
                            <ComboBox x:Name="ProjectDefaultThinkingSelector" Header="Default reasoning level" Style="{StaticResource PiComboBoxStyle}">
                                <ComboBoxItem Content="Runtime default" Tag="" />
                                <ComboBoxItem Content="Off" Tag="Off" />
                                <ComboBoxItem Content="Minimal" Tag="Minimal" />
                                <ComboBoxItem Content="Low" Tag="Low" />
                                <ComboBoxItem Content="Medium" Tag="Medium" />
                                <ComboBoxItem Content="High" Tag="High" />
                                <ComboBoxItem Content="Extra high" Tag="XHigh" />
                                <ComboBoxItem Content="Maximum" Tag="Max" />
                            </ComboBox>
                            <TextBlock Text="Reasoning levels depend on the selected model. Pi validates the default when starting a thread." TextWrapping="Wrap" />
                            <ComboBox x:Name="ProjectPermissionSelector" Header="Default tool permission mode" DisplayMemberPath="DisplayName" />
                            <ToggleSwitch x:Name="ProjectAutoPullToggle" Header="Automatically fast-forward the clean default branch when Pi Station starts" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnSaveProjectDefaultsClicked" Content="Save defaults" Style="{StaticResource PiPrimaryButtonStyle}" />
                                <Button Click="OnRemoveProjectClicked" Content="Remove project" Style="{StaticResource PiSecondaryButtonStyle}" />
                                <Button Click="OnCustomizeProjectClicked" Content="Icon and scripts…" Style="{StaticResource PiSecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="Project icons are loaded from iconPath in t3.json, then common favicon locations. Named t3.json scripts appear in the Add menu." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="RuntimeSettingsSection"
                        Tag="PiRuntime"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Pi and runtime" />
                            <TextBlock Text="Shared Pi automation preferences" FontWeight="SemiBold" />
                            <TextBlock Text="Overrides apply to all PiStation threads before their next turn. Pi writes these values to its shared settings file, which other Pi clients may also use. Clearing an override leaves Pi's current value unchanged; it does not restore an earlier value. Child-agent presets retain their own retry/compaction policy." TextWrapping="Wrap" />
                            <CheckBox Content="Manage auto-compaction" IsChecked="{x:Bind ViewModel.Settings.ManageAutoCompaction, Mode=TwoWay}" automation:AutomationProperties.AutomationId="ManageAutoCompactionToggle" />
                            <CheckBox Content="Enable automatic compaction" IsChecked="{x:Bind ViewModel.Settings.AutoCompaction, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Settings.ManageAutoCompaction, Mode=OneWay}" />
                            <CheckBox Content="Manage auto-retry" IsChecked="{x:Bind ViewModel.Settings.ManageAutoRetry, Mode=TwoWay}" automation:AutomationProperties.AutomationId="ManageAutoRetryToggle" />
                            <CheckBox Content="Enable automatic retry" IsChecked="{x:Bind ViewModel.Settings.AutoRetry, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.Settings.ManageAutoRetry, Mode=OneWay}" />
                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2">
                                <Button Content="Reload preferences" Click="OnReloadPiAutomationClicked" />
                                <Button Content="Save preferences" Click="OnSavePiAutomationClicked" automation:AutomationProperties.AutomationId="SavePiAutomationButton" />
                                <Button Content="Apply saved preferences to idle runtime" Click="OnApplyPiAutomationClicked" />
                                <Button Content="Refresh runtime status" Click="OnRefreshPiAutomationClicked" />
                            </WrapGrid>
                            <TextBlock Text="{x:Bind ViewModel.Settings.AutomationStatus, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Settings.RuntimeSetupStatus, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBox x:Name="PiExecutablePathInput" automation:AutomationProperties.AutomationId="PiExecutablePathInput" Header="Pi executable or package path" PlaceholderText="Leave empty to discover Pi on PATH" Text="{x:Bind ViewModel.Settings.PiExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PiTextBoxStyle}" />
                            <CheckBox Content="Discover installed Pi extensions" IsChecked="{x:Bind ViewModel.Settings.DiscoverPiExtensions, Mode=TwoWay}" automation:AutomationProperties.AutomationId="DiscoverPiExtensionsToggle" />
                            <Expander Header="Advanced runtime settings" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBox Header="Launch arguments (one argument per line)" Text="{x:Bind ViewModel.Settings.PiArguments, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" MaxHeight="180" />
                                    <TextBox Header="Environment variables (NAME=value, one per line)" Text="{x:Bind ViewModel.Settings.PiEnvironment, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" MaxHeight="180" />
                                    <NumberBox Header="Command timeout in seconds" Minimum="5" Maximum="600" Value="{x:Bind ViewModel.Settings.PiCommandTimeout, Mode=TwoWay}" />
                                    <NumberBox Header="Shutdown timeout in seconds" Minimum="1" Maximum="30" Value="{x:Bind ViewModel.Settings.PiShutdownTimeout, Mode=TwoWay}" />
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="Discovery follows Pi's saved project trust decisions. Explicit paths below load code you choose to trust. The bundled browser extension stays available with its per-thread browser permission controls." TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                            <TextBox Header="Additional trusted extensions (one absolute path per line)" Text="{x:Bind ViewModel.Settings.PiExtensionPaths, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" MaxHeight="160" TextWrapping="Wrap" Style="{StaticResource PiTextBoxStyle}" automation:AutomationProperties.AutomationId="PiExtensionPathsInput" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnBrowsePiExecutableClicked" Content="Browse…" Style="{StaticResource PiSecondaryButtonStyle}" />
                                <Button automation:AutomationProperties.AutomationId="ConfigurePiRuntimeButton" Click="OnConfigurePiRuntimeClicked" Content="Save and connect" Style="{StaticResource PiPrimaryButtonStyle}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="RestartConfiguredPiButton" Click="OnRestartConfiguredPiClicked" Content="Restart selected thread" IsEnabled="{x:Bind ViewModel.CanRestartPi, Mode=OneWay}" Style="{StaticResource PiSecondaryButtonStyle}" />
                            <TextBlock Text="Install Pi, then select its executable or leave the path empty for automatic discovery. Authenticate your model provider using Pi in a terminal. Return here and choose Save and connect; you can retry without restarting Pi Station." TextWrapping="Wrap" Foreground="{ThemeResource PiTextSecondaryBrush}" />
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind ViewModel.Connection.Status, Mode=OneWay}" />
                            <TextBlock Foreground="{ThemeResource PiTextMutedBrush}" Text="Project defaults seed the model, reasoning level, runtime mode, and workspace mode for new threads. Per-thread model and reasoning controls remain in the composer." TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Click="OnConfigurePiRuntimeClicked" Content="Recheck runtime" Style="{StaticResource PiSecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Tag="PiResources" Style="{StaticResource PiElevatedSurfaceStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="10" automation:AutomationProperties.AutomationId="PiResourcesSettingsPanel">
                            <TextBlock Text="Pi resources and providers" Style="{StaticResource PiPanelHeaderTextStyle}" />
                            <Expander Header="Extension compatibility" HorizontalAlignment="Stretch">
                                <TextBlock Text="Native Pi RPC supports dialogs, text editors, status messages, notifications, and text widgets. Terminal components, custom TUI editors, overlays, headers, and footers require Pi's terminal UI. Extensions that register no commands or tools cannot be confirmed loaded by RPC. Targeted external-agent controls require a stable child handle and a compatible control command from that extension." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Expander>
                            <TextBlock Text="{x:Bind ViewModel.PiResources.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PiResourcesStatusText" />
                            <Button Content="Refresh resources" Click="OnRefreshPiResourcesClicked" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="RefreshPiResourcesButton" />
                            <Button Content="Restart selected thread" Click="OnRestartConfiguredPiClicked" IsEnabled="{x:Bind ViewModel.CanRestartPi, Mode=OneWay}" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="RestartResourcePiButton" />
                            <Expander Header="Project and configuration folders" HorizontalAlignment="Stretch">
                                <TextBlock Text="{x:Bind ViewModel.PiResources.Directories, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                            </Expander>
                            <TextBlock Text="{x:Bind ViewModel.PiResources.TrustSummary, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="PiProjectTrustText" />
                            <TextBlock Text="Trust allows Pi to load this project's settings, extensions and skills, including executable code. Saved decisions apply after restarting Pi and remain subject to Pi's trust extensions." TextWrapping="Wrap" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Trust project" Click="OnTrustPiProjectClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}" automation:AutomationProperties.AutomationId="TrustPiProjectButton" />
                                <Button Content="Do not trust" Click="OnUntrustPiProjectClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}" automation:AutomationProperties.AutomationId="UntrustPiProjectButton" />
                            </StackPanel>
                            <TextBlock Text="Saved settings apply after restart. Confirmation reflects resources reported by Pi; extensions may load without registering a feature. Edit explicit extension paths under Pi / runtime." TextWrapping="Wrap" FontSize="12" />
                            <ScrollViewer MaxHeight="300" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.PiResources.Resources}" automation:AutomationProperties.AutomationId="PiResourceList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:PiResourceRow">
                                            <StackPanel Spacing="4" Margin="0,0,0,14">
                                                <TextBlock Text="{x:Bind Heading}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Source}" TextWrapping="Wrap" FontSize="12" />
                                                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" />
                                                <TextBlock Text="{x:Bind State}" TextWrapping="Wrap" FontSize="12" />
                                                <Button Content="{x:Bind ToggleLabel}" IsEnabled="{x:Bind CanToggle}" Click="OnTogglePiResourceClicked" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="TogglePiResourceButton" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Content="Manage resources in Pi terminal" Tag="resources" Click="OnPiSetupTerminalClicked" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="ManagePiResourcesTerminalButton" />
                            <Button Content="Open Pi package terminal" Tag="packages" Click="OnPiSetupTerminalClicked" HorizontalAlignment="Left" />
                            <Expander Header="Providers and login" IsExpanded="True" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Credential configured means Pi found a credential source. It does not verify an authenticated model request. Credentials stay in Pi's login flow." TextWrapping="Wrap" FontSize="12" />
                                    <Button Content="Open Pi login / logout" Tag="login" Click="OnPiSetupTerminalClicked" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="OpenPiLoginButton" />
                                    <TextBlock Text="In the terminal, enter /login or /logout and follow Pi's prompts. Exit Pi, restart the thread, then refresh here." TextWrapping="Wrap" />
                                    <ScrollViewer MaxHeight="180">
                                        <TextBlock Text="{x:Bind ViewModel.PiResources.ProviderSummary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PiProviderSummaryText" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Expander>
                            <ComboBox Header="Provider account" ItemsSource="{x:Bind ViewModel.PiResources.Providers}" DisplayMemberPath="DisplayName" SelectedItem="{x:Bind ViewModel.PiResources.SelectedProvider, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Sign in with browser" Tag="login" Click="OnPiNativeAccountClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}" />
                                <Button Content="Sign out" Tag="logout" Click="OnPiNativeAccountClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}" />
                            </StackPanel>
                            <Expander Header="Packages" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <TextBox Header="Find Pi packages on npm" Text="{x:Bind ViewModel.PiResources.PackageSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Search packages" Click="OnSearchPiPackagesClicked" />
                                        <Button Content="Load more packages" Tag="more" Click="OnSearchPiPackagesClicked" IsEnabled="{x:Bind ViewModel.PiResources.CanLoadMorePackages, Mode=OneWay}" />
                                    </StackPanel>
                                    <ListView MaxHeight="180" ItemsSource="{x:Bind ViewModel.PiResources.PackageSearchResults}" SelectionMode="None">
                                        <ListView.ItemTemplate><DataTemplate x:DataType="models:PiPackageSearchItem">
                                            <StackPanel Spacing="4"><TextBlock Text="{x:Bind Name}" /><TextBlock Text="{x:Bind Version}" />
                                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                <Button Content="Use this package" Click="OnSelectPiPackageClicked" />
                                            </StackPanel>
                                        </DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                    <TextBox Header="Package source" PlaceholderText="npm:package, Git URL, or local path" Text="{x:Bind ViewModel.PiResources.PackageSource, Mode=TwoWay}" />
                                    <CheckBox Content="Install for this project" IsChecked="{x:Bind ViewModel.PiResources.PackageLocal, Mode=TwoWay}" />
                                    <Button Content="Install package" Tag="packageInstall" Click="OnPiPackageClicked" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.PiResources.Packages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PiPackageDescriptor">
                                                <StackPanel Spacing="4" Margin="0,6">
                                                    <TextBlock Text="{x:Bind Source}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Scope}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Update" Tag="packageUpdate" Click="OnPiPackageClicked" ToolTipService.ToolTip="Update this package source in all scopes where Pi has it configured" />
                                                        <Button Content="Reinstall" Tag="packageInstall" Click="OnPiPackageClicked" />
                                                        <Button Content="Remove" Tag="packageRemove" Click="OnPiPackageClicked" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Add or update a custom model" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.PiResources.CanEdit, Mode=OneWay}" automation:AutomationProperties.AutomationId="CustomPiModelExpander">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Save to Pi's models.json. The endpoint and API apply to every model under the provider ID. Other providers and model settings are preserved; comments and formatting are rewritten." TextWrapping="Wrap" FontSize="12" />
                                    <TextBox Header="Provider ID" Text="{x:Bind ViewModel.PiResources.ModelProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="CustomPiProviderInput" />
                                    <TextBox Header="Model ID" Text="{x:Bind ViewModel.PiResources.ModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="CustomPiModelInput" />
                                    <TextBox Header="Display name" Text="{x:Bind ViewModel.PiResources.ModelDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="Endpoint URL" PlaceholderText="http://localhost:11434/v1" Text="{x:Bind ViewModel.PiResources.ModelBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="CustomPiEndpointInput" />
                                    <ComboBox Header="API" ItemsSource="{x:Bind ViewModel.PiResources.ModelApis}" SelectedItem="{x:Bind ViewModel.PiResources.ModelApi, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <TextBox Header="API key environment-variable name" PlaceholderText="MY_PROVIDER_API_KEY" Text="{x:Bind ViewModel.PiResources.ModelKeyEnvironmentVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="CustomPiKeyVariableInput" />
                                    <TextBlock Text="Enter a variable name, never the key itself. Leave empty to keep the existing credential configuration. Set the variable before starting PiStation." TextWrapping="Wrap" FontSize="12" />
                                    <CheckBox Content="Local server needs no key" IsChecked="{x:Bind ViewModel.PiResources.ModelKeyless, Mode=TwoWay}" automation:AutomationProperties.AutomationId="CustomPiKeylessToggle" />
                                    <CheckBox Content="Model supports reasoning" IsChecked="{x:Bind ViewModel.PiResources.ModelReasoning, Mode=TwoWay}" />
                                    <Button Content="Save provider and model" Click="OnSavePiModelClicked" HorizontalAlignment="Left" automation:AutomationProperties.AutomationId="SaveCustomPiModelButton" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Configuration and startup messages" HorizontalAlignment="Stretch">
                                <ScrollViewer MaxHeight="180">
                                    <TextBlock Text="{x:Bind ViewModel.PiResources.Diagnostics, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border Tag="PiSessions" Style="{StaticResource PiElevatedSurfaceStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Pi sessions" Style="{StaticResource PiPanelHeaderTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PiSessions.Status, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" automation:AutomationProperties.AutomationId="PiSessionsStatusText" />
                            <TextBlock Text="Import and fork create independent local threads in the selected project. Originals and unsent drafts are preserved. Workspace files are not copied or rewound." TextWrapping="Wrap" FontSize="12" />
                            <TextBox Header="New thread title (optional)" Text="{x:Bind ViewModel.PiSessions.NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="PiSessionTitleInput" />
                            <Expander Header="Import a session" IsExpanded="True" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBox Header="Session folder" PlaceholderText="Empty uses Pi's default session folder" Text="{x:Bind ViewModel.PiSessions.Directory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.AutomationId="PiSessionDirectoryInput" />
                                    <Button Content="Refresh session files" Click="OnBrowsePiSessionsClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="BrowsePiSessionsButton" />
                                    <Button Content="Choose folder…" Click="OnChoosePiSessionFolderClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" />
                                    <Button Content="Import JSONL file…" Click="OnChoosePiSessionFileClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ImportPiSessionFileButton" />
                                    <ListView ItemsSource="{x:Bind ViewModel.PiSessions.Candidates}" SelectedItem="{x:Bind ViewModel.PiSessions.SelectedCandidate, Mode=TwoWay}" MaxHeight="240" SelectionMode="Single" automation:AutomationProperties.AutomationId="PiSessionCandidateList">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:PiSessionCandidateRow">
                                                <StackPanel Spacing="4" Margin="0,6">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Button Content="Import selected session" Click="OnImportSelectedPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ImportSelectedPiSessionButton" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Selected thread" IsExpanded="True" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <Button Content="Refresh session tree" Click="OnInspectPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="InspectPiSessionButton" />
                                    <TextBlock Text="{x:Bind ViewModel.PiSessions.Summary, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.AutomationId="PiSessionSummaryText" />
                                    <TextBlock Text="The tree includes alternate branches and configuration entries. Fork after a completed assistant response to continue that conversation in a new thread." TextWrapping="Wrap" FontSize="12" />
                                    <ListView ItemsSource="{x:Bind ViewModel.PiSessions.Entries}" SelectedItem="{x:Bind ViewModel.PiSessions.SelectedEntry, Mode=TwoWay}" MaxHeight="300" SelectionMode="Single" automation:AutomationProperties.AutomationId="PiSessionTreeList">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:PiSessionTreeRow">
                                                <StackPanel Spacing="4" Margin="{x:Bind Indent}">
                                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Button Content="Fork after selected response" Click="OnForkPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ForkPiSessionButton" />
                                    <Button Content="Copy whole session" Click="OnCopyPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="CopyPiSessionButton" />
                                    <TextBlock Text="JSONL retains the full tree and embedded images. HTML is a readable text transcript of the active branch. Linked files remain external." TextWrapping="Wrap" FontSize="12" />
                                    <Button Content="Export Pi JSONL…" Tag="jsonl" Click="OnExportPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ExportPiSessionJsonlButton" />
                                    <Button Content="Load more tree entries" Click="OnLoadMoreSessionEntries" IsEnabled="{x:Bind ViewModel.PiSessions.HasMoreEntries, Mode=OneWay}" />
                                    <Button Content="Load more session files" Click="OnLoadMoreSessionFiles" IsEnabled="{x:Bind ViewModel.PiSessions.HasMoreCandidates, Mode=OneWay}" />
                                    <Button Content="Export readable HTML…" Tag="html" Click="OnExportPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" automation:AutomationProperties.AutomationId="ExportPiSessionHtmlButton" />
                                    <Button Content="Export session and attachments…" Tag="bundle" Click="OnExportPiSessionClicked" IsEnabled="{x:Bind ViewModel.PiSessions.CanAct, Mode=OneWay}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="SourceControlSettingsSection"
                        Tag="SourceControl"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Source-control hosting" />
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind ViewModel.Settings.SourceControlSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <Expander Header="Commit and PR writing" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <ComboBox Header="Writing style" SelectedIndex="{x:Bind ViewModel.Settings.WritingStyleIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" automation:AutomationProperties.AutomationId="SourceControlWritingStyle">
                                        <ComboBoxItem Content="Default" />
                                        <ComboBoxItem Content="Conventional Commits" />
                                        <ComboBoxItem Content="Repository conventions" />
                                        <ComboBoxItem Content="Custom instructions" />
                                    </ComboBox>
                                    <TextBox Header="Custom writing instructions" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="20000" Text="{x:Bind ViewModel.Settings.WritingInstructions, Mode=TwoWay}" />
                                    <TextBlock Text="Leave provider and model empty to use the current Pi model. Use Pi provider/model IDs for a dedicated writer." TextWrapping="Wrap" />
                                    <ComboBox Header="Choose a Pi model" ItemsSource="{x:Bind ViewModel.PiConfiguration.Models, Mode=OneWay}" DisplayMemberPath="DisplayName" SelectionChanged="OnWriterModelSelected" HorizontalAlignment="Stretch" />
                                    <TextBox Header="Writer provider" MaxLength="256" Text="{x:Bind ViewModel.Settings.WriterProvider, Mode=TwoWay}" />
                                    <TextBox Header="Writer model" MaxLength="256" Text="{x:Bind ViewModel.Settings.WriterModel, Mode=TwoWay}" />
                                    <Button Content="Use current model" Click="OnUseCurrentWriterModelClicked" />
                                    <Button Content="Save writing preferences" Click="OnSaveWritingSettingsClicked" automation:AutomationProperties.AutomationId="SaveWritingSettingsButton" />
                                    <TextBox Header="PR base branch" PlaceholderText="Automatic (remote default, main or master)" MaxLength="256" Text="{x:Bind ViewModel.Settings.PullRequestBaseBranch, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.Settings.WritingStatus, Mode=OneWay}" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Recent hosting operations">
                                <StackPanel Spacing="8">
                                    <Button Click="OnRefreshSettingsClicked" Content="Refresh operation history" Style="{StaticResource PiSecondaryButtonStyle}" />
                                    <ListView MaxHeight="240" ItemsSource="{x:Bind ViewModel.Settings.HostingOperations}" SelectionMode="None">
                                        <ListView.ItemTemplate><DataTemplate x:DataType="models:HostingOperation">
                                            <StackPanel Padding="4" Spacing="4">
                                                <TextBlock Text="{x:Bind Action}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind State}" />
                                                <TextBlock Text="{x:Bind Result.Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Clone hosted repository">
                                <StackPanel Padding="0,8,0,0" Spacing="6">
                                    <TextBox x:Name="CloneRemoteInput" Header="Remote URL" PlaceholderText="https://github.com/owner/repository.git" Style="{StaticResource PiTextBoxStyle}" />
                                    <TextBox x:Name="CloneDestinationInput" Header="Destination" PlaceholderText="C:\Projects\repository" Style="{StaticResource PiTextBoxStyle}" />
                                    <Button HorizontalAlignment="Left" Click="OnCloneRepositoryClicked" Content="Clone and add project" Style="{StaticResource PiPrimaryButtonStyle}" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Publish selected project">
                                <StackPanel Padding="0,8,0,0" Spacing="6">
                                    <ComboBox x:Name="PublishProviderSelector" SelectedIndex="0" Header="Provider" Style="{StaticResource PiComboBoxStyle}">
                                        <ComboBoxItem Content="GitHub" Tag="GitHub" />
                                    </ComboBox>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="PublishOwnerInput" Header="Owner / organization" Style="{StaticResource PiTextBoxStyle}" />
                                        <TextBox x:Name="PublishRepositoryInput" Grid.Column="1" Header="Repository name" Style="{StaticResource PiTextBoxStyle}" />
                                    </Grid>
                                    <CheckBox x:Name="PublishPrivateCheckBox" Content="Private repository" IsChecked="True" />
                                    <Button HorizontalAlignment="Left" Click="OnPublishRepositoryClicked" Content="Publish" Style="{StaticResource PiPrimaryButtonStyle}" />
                                </StackPanel>
                            </Expander>
                            <Expander Header="Create pull request">
                                <StackPanel Padding="0,8,0,0" Spacing="6">
                                    <TextBox x:Name="PullRequestTitleInput" Header="Title" Style="{StaticResource PiTextBoxStyle}" />
                                    <TextBox x:Name="PullRequestBodyInput" MinHeight="90" AcceptsReturn="True" Header="Description" Style="{StaticResource PiTextBoxStyle}" TextWrapping="Wrap" />
                                    <CheckBox x:Name="PullRequestDraftCheckBox" Content="Create as draft" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Click="OnGeneratePullRequestTextClicked" Content="Generate with Pi" IsEnabled="{x:Bind ViewModel.Settings.CanGenerateText, Mode=OneWay}" Style="{StaticResource PiSecondaryButtonStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.Settings.WritingStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                        <Button Click="OnCreatePullRequestClicked" IsEnabled="{x:Bind ViewModel.Settings.CanCreatePullRequest, Mode=OneWay}" Content="Create pull request" Style="{StaticResource PiPrimaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <Button Content="Load more pull requests" Click="OnLoadMorePullRequestsClicked" IsEnabled="{x:Bind ViewModel.Settings.CanLoadMorePullRequests, Mode=OneWay}" />
                            <ListView MaxHeight="260" ItemsSource="{x:Bind ViewModel.Settings.PullRequests, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PullRequestDescriptor">
                                        <Grid Padding="4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="{StaticResource PiFontSizeCaption}" Foreground="{ThemeResource PiTextMutedBrush}" Text="{x:Bind Number}" />
                                                <TextBlock FontSize="{StaticResource PiFontSizeCaption}" Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind State}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Actions" Style="{StaticResource PiToolbarButtonStyle}">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Click="OnLinkPullRequestClicked" Tag="{x:Bind Number}" Text="Link to active thread" />
                                                        <MenuFlyoutItem Click="OnCommentPullRequestClicked" IsEnabled="{x:Bind CanComment}" Tag="{x:Bind Number}" Text="Comment…" />
                                                        <MenuFlyoutItem Click="OnLabelPullRequestClicked" IsEnabled="{x:Bind CanLabel}" Tag="{x:Bind Number}" Text="Add label…" />
                                                        <MenuFlyoutItem Click="OnReviewerPullRequestClicked" IsEnabled="{x:Bind CanReview}" Tag="{x:Bind Number}" Text="Add reviewer…" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Click="OnApprovePullRequestClicked" IsEnabled="{x:Bind CanApprove}" Tag="{x:Bind Number}" Text="Approve" />
                                                        <MenuFlyoutItem Click="OnRequestChangesPullRequestClicked" IsEnabled="{x:Bind CanRequestChanges}" Tag="{x:Bind Number}" Text="Request changes…" />
                                                        <MenuFlyoutItem Click="OnMergePullRequestClicked" IsEnabled="{x:Bind CanMerge}" Tag="{x:Bind Number}" Text="Merge" />
                                                        <MenuFlyoutItem Click="OnClosePullRequestClicked" IsEnabled="{x:Bind CanClose}" Tag="{x:Bind Number}" Text="Close / reopen" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="IntegrationsSettingsSection"
                        Tag="Integrations"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Integrations" />
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="Hosting adapters use installed and authenticated provider CLIs: gh, glab, bb, and az. Availability and authentication failures appear in diagnostics without exporting secrets." TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Settings.Diagnostics, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RuntimeDiagnostic">
                                        <Grid Padding="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" /><TextBlock Grid.Column="1" Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" /></Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="RealDiagnosticsSettingsSection"
                        Tag="Diagnostics"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Diagnostics and resources" />
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind ViewModel.Settings.DiagnosticsSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnRefreshSettingsClicked" Content="Refresh" Style="{StaticResource PiSecondaryButtonStyle}" />
                                <Button Click="OnExportDiagnosticsClicked" Content="Export redacted diagnostics" Style="{StaticResource PiPrimaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Recent logs" />
                            <ListView MaxHeight="180" ItemsSource="{x:Bind ViewModel.Settings.Logs, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate><DataTemplate><TextBlock FontFamily="{StaticResource PiMonospaceFontFamily}" FontSize="{StaticResource PiFontSizeCaption}" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="UsageSettingsSection"
                        Tag="Usage"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Usage, cost, and quota" />
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind ViewModel.Settings.UsageSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{ThemeResource PiTextMutedBrush}" Text="Costs are estimates from usage reported by Pi. Provider quota status is shown when the runtime exposes it." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="UpdatesSettingsSection"
                        Tag="Updates"
                        Style="{StaticResource PiElevatedSurfaceStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Updates" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnCheckForUpdatesClicked" Content="Check for updates" Style="{StaticResource PiSecondaryButtonStyle}" />
                                <Button Click="OnOpenUpdateInstallerClicked" Content="Open update installer" IsEnabled="{x:Bind ViewModel.Settings.CanOpenUpdateInstaller, Mode=OneWay}" Style="{StaticResource PiSecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Foreground="{ThemeResource PiTextSecondaryBrush}" Text="{x:Bind ViewModel.Settings.UpdateSummary, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="DiagnosticsSection"
                        Tag="Diagnostics"
                        automation:AutomationProperties.AutomationId="DiagnosticsSection"
                        Style="{StaticResource PiWarningBannerStyle}"
                        Visibility="{x:Bind ViewModel.UiTestFaultControlsVisibility}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="Test diagnostics" />
                            <TextBlock
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="These controls are available only in deterministic FakePi test launches."
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="SimulateTransportDropButton"
                                HorizontalAlignment="Left"
                                automation:AutomationProperties.AutomationId="SimulateTransportDropButton"
                                automation:AutomationProperties.Name="Simulate a transport disconnect for UI testing"
                                Click="OnSimulateTransportDropClicked"
                                Content="Simulate transport disconnect"
                                Style="{StaticResource PiSecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Tag="Updates" Style="{StaticResource PiBannerStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource PiPanelHeaderTextStyle}" Text="About" />
                            <TextBlock
                                Foreground="{ThemeResource PiTextSecondaryBrush}"
                                Text="Pi Station Desktop • Native Windows client for Pi"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
                </NavigationView.Content>
            </NavigationView>
        </ContentDialog>

        <ContentDialog
            x:Name="AddProjectDialog"
            automation:AutomationProperties.AutomationId="AddProjectDialog"
            Closed="OnAddProjectDialogClosed"
            CloseButtonText="Cancel"
            DefaultButton="Close"
            Title="Add local project">
            <StackPanel x:Name="ProjectDialogContent" MinWidth="380" Spacing="12">
                <Border Style="{StaticResource PiBannerStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Local folders only" />
                        <TextBlock
                            Foreground="{ThemeResource PiTextSecondaryBrush}"
                            Text="Pi Station stores workspace metadata locally and never uploads the folder itself."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBox
                    x:Name="ProjectPathInput"
                    automation:AutomationProperties.AutomationId="ProjectPathInput"
                    automation:AutomationProperties.Name="Project directory path"
                    Header="Project path"
                    PlaceholderText="C:\Projects\my-project"
                    Style="{StaticResource PiTextBoxStyle}" />
                <Button
                    x:Name="AddProjectConfirmButton"
                    HorizontalAlignment="Right"
                    automation:AutomationProperties.AutomationId="AddProjectConfirmButton"
                    automation:AutomationProperties.Name="Confirm add project"
                    Click="OnAddProjectConfirmed"
                    Content="Add project"
                    Style="{StaticResource PiPrimaryButtonStyle}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
