<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="PiStation.App.Views.ExternalPromptEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit prompt externally" CloseButtonText="Close" AutomationProperties.AutomationId="ExternalPromptEditorDialog">
    <ScrollViewer MaxHeight="560">
        <StackPanel MinWidth="320" MaxWidth="640" Spacing="10">
            <TextBlock Text="Save in your editor, then return here and choose Use saved text. Attachments and context stay in PiStation. The working copy stays available until you choose Discard edit." TextWrapping="Wrap" />
            <TextBox Header="Editor executable" Text="{x:Bind Model.Executable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{x:Bind Model.CanLaunch, Mode=OneWay}" AutomationProperties.AutomationId="ExternalEditorExecutable" />
            <TextBox Header="Arguments (optional)" Text="{x:Bind Model.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{x:Bind Model.CanLaunch, Mode=OneWay}" AutomationProperties.AutomationId="ExternalEditorArguments" />
            <TextBlock Text="Choose an .exe on this computer, such as Notepad or Code.exe. Quote arguments containing spaces. PiStation appends the prompt file path." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open editor" Click="OnLaunch" IsEnabled="{x:Bind Model.CanLaunch, Mode=OneWay}" AutomationProperties.AutomationId="ExternalEditorLaunch" />
                <Button Content="Refresh saved text" Click="OnRefresh" IsEnabled="{x:Bind Model.CanRead, Mode=OneWay}" AutomationProperties.AutomationId="ExternalEditorRefresh" />
            </StackPanel>
            <TextBlock Text="{x:Bind Model.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ExternalEditorStatus" />
            <TextBox Header="Saved text" Text="{x:Bind Model.EditedText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                TextWrapping="Wrap" MinHeight="100" MaxHeight="180" AutomationProperties.AutomationId="ExternalEditorPreview" />
            <TextBlock Text="{x:Bind Model.FilePath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="ExternalEditorFilePath" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Use saved text" Click="OnApply" IsEnabled="{x:Bind Model.CanApply, Mode=OneWay}" Style="{StaticResource PiPrimaryButtonStyle}" AutomationProperties.AutomationId="ExternalEditorApply" />
                <Button Content="Copy edited text" Click="OnCopy" IsEnabled="{x:Bind Model.CanRead, Mode=OneWay}" AutomationProperties.AutomationId="ExternalEditorCopy" />
                <Button Content="Discard edit" Click="OnDiscard" IsEnabled="{x:Bind Model.CanRead, Mode=OneWay}" AutomationProperties.AutomationId="ExternalEditorDiscard" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
